#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "ops/lib/deploy_executor"
sys.path.insert(0, str(LIB))

import control_phase5_observation_credential_reconciliation as reconciliation


def emit(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--approved-source-sha", required=True)
    args = parser.parse_args()
    try:
        receipt = reconciliation.reconcile_existing_credential(
            approved_source_sha=args.approved_source_sha,
        )
    except Exception as exc:
        emit(reconciliation.public_error_receipt(exc))
        return 2
    emit(receipt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
