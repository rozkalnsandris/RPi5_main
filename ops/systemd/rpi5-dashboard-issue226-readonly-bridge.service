# SOURCE-ONLY BLUEPRINT. Do not install/start without separate owner authorization.
[Unit]
Description=Run exact dashboard_RPi5 #226 trusted-read recovery preflight
Documentation=https://github.com/rozkalnsandris/RPi5_main/issues/261
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/rpi5-dashboard-issue226-readonly-bridge
Restart=no
TimeoutStartSec=90s

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
NoExecPaths=/home
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
DevicePolicy=closed
StateDirectory=dashboard-rpi5
StateDirectoryMode=0755
RuntimeDirectory=dashboard-rpi5-issue226
RuntimeDirectoryMode=0700
ReadOnlyPaths=/var/cache/dashboard-rpi5-operator
ReadWritePaths=/var/lib/dashboard-rpi5/evidence
TasksMax=64
MemoryMax=256M
