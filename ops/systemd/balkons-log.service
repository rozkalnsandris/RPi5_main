[Unit]
Description=Balcony MQTT log subscriber
Documentation=https://github.com/rozkalnsandris/RPi5_main
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/balkons-log
LoadCredential=mqtt-client-config:/etc/credstore/balkons-log-mqtt-client-config
ExecStart=/usr/local/sbin/balkons-log-subscribe
ExecStop=/usr/local/sbin/balkons-log-subscribe --stop
TimeoutStopSec=15s
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
# Safe source fallback only. A production cutover must preserve any
# pre-existing private append sink with a runtime-only local drop-in as
# defined in docs/BALKONS_LOG_MQTT_AUTH_CONTRACT.md.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
