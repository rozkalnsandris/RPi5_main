# Environment files and credentials.  A deliberately fake example is allowed.
.env
.env.*
!.env.example
**/.env
**/.env.*
**/secrets/
**/secrets
**/secrets.*
**/credentials/
**/credentials
**/credentials.*
**/private/
**/private
**/private.*
**/token
**/token.*
**/*.token
**/*.token.*
**/password
**/password.*
**/*.password
**/*.password.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
authorized_keys
cert.json
*.credentials.json
**/cloudflared/*.json

# Runtime data, database exports, archives, and backups.
backups/
**/backups/
dumps/
**/dumps/
volumes/
**/volumes/
runtime/
**/runtime/
!baselines/
!baselines/runtime/
!baselines/runtime/current.json
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.tar
*.tar.gz
*.tgz
*.zip
*.bak

# Evidence is generated locally and is never committed by default.
evidence/*
!evidence/.gitkeep
exports/*
!exports/.gitkeep

# Editor and language caches.
.vscode/
.idea/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
