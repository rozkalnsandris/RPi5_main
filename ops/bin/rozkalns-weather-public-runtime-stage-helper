#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import sys
from typing import Sequence

_ENTRYPOINT_NAME = "rozkalns-weather-public-runtime-stage-helper"
_SUPPORT_DIR_NAME = "rozkalns-weather-public-runtime"
_HERE = Path(__file__).resolve().parent
_SUPPORT_ROOT = _HERE / _SUPPORT_DIR_NAME
_PACKAGE_INIT = _SUPPORT_ROOT / "deploy_executor" / "__init__.py"


def _install_layout_stop() -> None:
    print("WEATHER_STAGE_HELPER=STOP error=WeatherHelperInstallLayoutError", file=sys.stderr)
    raise SystemExit(78)


if Path(__file__).name != _ENTRYPOINT_NAME or not _PACKAGE_INIT.is_file():
    _install_layout_stop()

# The fixed sibling support root is the only project package path added by this
# privileged entrypoint. The launcher environment does not carry PYTHONPATH and
# the package initializer is intentionally import-free.
sys.path.insert(0, str(_SUPPORT_ROOT))
try:
    import deploy_executor
except ImportError:
    _install_layout_stop()

if Path(deploy_executor.__file__ or "").resolve() != _PACKAGE_INIT.resolve():
    _install_layout_stop()

try:
    from deploy_executor.weather_public_runtime_candidate_materializer import (
        WeatherCandidateMaterializerError,
        materialize_candidate,
    )
    from deploy_executor.weather_public_runtime_host_wiring import expected_helper_bindings
    from deploy_executor.weather_public_runtime_stage_helper import (
        WeatherStageHelperError,
        _validate_request,
        execute_stage,
        read_activation,
        run_command,
    )
except ImportError:
    _install_layout_stop()

APPLICATION_RELEASE_HELPER_ID = next(
    binding.helper_id
    for binding in expected_helper_bindings()
    if binding.stage_id == "application_release"
)


def _safe_runner(argv: Sequence[str]):
    fixed = tuple(argv)
    if fixed and fixed[0] == "/usr/bin/git" and (len(fixed) < 2 or fixed[1] != "--no-optional-locks"):
        fixed = (fixed[0], "--no-optional-locks", *fixed[1:])
    return run_command(fixed)


def main(argv: Sequence[str] | None = None) -> int:
    args = tuple(sys.argv[1:] if argv is None else argv)
    try:
        activation = read_activation()
        helper_id, source_sha, _digest, _start, _end, _recovery, _extra = _validate_request(args, activation)
        if helper_id == APPLICATION_RELEASE_HELPER_ID:
            materialize_candidate(source_sha, _safe_runner)
        receipt = execute_stage(args, activation=activation, runner=_safe_runner)
    except (WeatherStageHelperError, WeatherCandidateMaterializerError) as exc:
        print(f"WEATHER_STAGE_HELPER=STOP error={type(exc).__name__}", file=sys.stderr)
        return 78
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
