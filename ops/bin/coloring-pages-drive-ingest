#!/usr/bin/env python3
"""Permission-safe Google Drive ingestion operator for Coloring Pages."""

from __future__ import annotations

import argparse
import fcntl
import grp
import hashlib
import json
import os
import pwd
import re
import stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from urllib.request import Request, urlopen

OWNER = "andris"
CONTENT_ROOT = Path("/srv/coloring-pages-content")
INBOX_ROOT = CONTENT_ROOT / "inbox"
ORIGINALS_ROOT = CONTENT_ROOT / "originals"
PUBLIC_ROOT = CONTENT_ROOT / "public"
MEDIA_ROOT = PUBLIC_ROOT / "media"
STATE_ROOT = CONTENT_ROOT / "state"
INGEST_STATE = STATE_ROOT / "drive-ingest"
LOCK_PATH = INGEST_STATE / ".lock"
CATALOG = PUBLIC_ROOT / "catalog.json"

RCLONE = "/usr/bin/rclone"
SUDO = "/usr/bin/sudo"
DOCKER = "/usr/bin/docker"
MV = "/usr/bin/mv"
RCLONE_CONFIG = Path("/home") / OWNER / ".config/rclone/rclone.conf"
RCLONE_REMOTE = "gdrive"
DRIVE_ROOT_FOLDER_ID = "1F0pxqoRgtZl7JQVcyvYVZxKvx6eOnytn"
PENDING_DIR = "pending"

IMPORTER_IMAGE = "ghcr.io/rozkalnsandris/coloring-pages@sha256:ebb52f87849d02b2ba467b5525c37b09864921530d1af11a80424208659bf868"
IMPORTER_ENTRYPOINT = "/usr/local/bin/coloring-pages-import"
PUBLIC_ORIGIN = "https://coloring.rozkalns.net"

ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")
MAX_SOURCE_BYTES = 20 * 1024 * 1024
MAX_MANIFEST_BYTES = 64 * 1024
MAX_ACTIVITY_PAGES = 12
ALLOWED_AGES = {"3-6", "4-8"}
ALLOWED_DIFFICULTIES = {"easy", "normal", "detailed"}
ALLOWED_LANGUAGES = {"de"}
ALLOWED_CATEGORIES = {"tiere", "fahrzeuge", "alphabet", "lernen", "figuren", "jahreszeiten"}

MANIFEST_SCHEMA_V1 = "rozkalns.coloring-pages.drive-staging-manifest.v1"
MANIFEST_SCHEMA_V2 = "rozkalns.coloring-pages.drive-staging-manifest.v2"
MANIFEST_KEYS_V1 = {
    "schema",
    "id",
    "sha256",
    "size_bytes",
    "title",
    "character",
    "category",
    "age",
    "difficulty",
    "language",
    "source_kind",
    "approval_class",
}
MANIFEST_KEYS_V2 = {
    "schema",
    "id",
    "pages",
    "title",
    "character",
    "category",
    "age",
    "difficulty",
    "language",
    "source_kind",
    "approval_class",
}
PAGE_KEYS_V2 = {"index", "file", "sha256", "size_bytes"}
RECEIPT_SCHEMA_V1 = "rozkalns.rpi5-main.coloring-pages-drive-ingest-receipt.v1"
RECEIPT_SCHEMA_V2 = "rozkalns.rpi5-main.coloring-pages-drive-ingest-receipt.v2"


class OperatorError(RuntimeError):
    """Fail-closed operator error with a sanitized message."""


def fail(message: str) -> None:
    raise OperatorError(message)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--id", required=True, dest="page_id")
    parser.add_argument("--expected-sha256")
    parser.add_argument("--expected-size", type=int)
    parser.add_argument(
        "--expected-page",
        action="append",
        default=[],
        metavar="INDEX:SHA256:BYTES",
        help="repeat for each ordered v2 page",
    )
    return parser.parse_args(argv)


def operator_ids() -> tuple[int, int]:
    owner = pwd.getpwnam(OWNER)
    group = grp.getgrnam(OWNER)
    return owner.pw_uid, group.gr_gid


def mode_bits(st: os.stat_result) -> int:
    return stat.S_IMODE(st.st_mode)


def lstat_regular(path: Path) -> os.stat_result:
    try:
        st = path.lstat()
    except FileNotFoundError:
        fail(f"required file is missing: {path}")
    if not stat.S_ISREG(st.st_mode) or path.is_symlink():
        fail(f"required file is unsafe: {path}")
    return st


def lstat_directory(path: Path) -> os.stat_result:
    try:
        st = path.lstat()
    except FileNotFoundError:
        fail(f"required directory is missing: {path}")
    if not stat.S_ISDIR(st.st_mode) or path.is_symlink():
        fail(f"required directory is unsafe: {path}")
    return st


def require_identity(
    path: Path,
    *,
    uid: int,
    gid: int,
    mode: int,
    directory: bool,
) -> os.stat_result:
    st = lstat_directory(path) if directory else lstat_regular(path)
    if st.st_uid != uid or st.st_gid != gid or mode_bits(st) != mode:
        fail(f"metadata drifted: {path}")
    return st


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            fail("JSON contains duplicate keys")
        result[key] = value
    return result


def load_json(path: Path, *, max_bytes: int) -> Any:
    st = lstat_regular(path)
    if st.st_size <= 0 or st.st_size > max_bytes:
        fail("JSON file size is outside the allowed bound")
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle, object_pairs_hook=strict_object)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("JSON is invalid")


def validate_text(value: Any, *, name: str, allow_empty: bool = False) -> str:
    if not isinstance(value, str):
        fail(f"manifest {name} must be a string")
    if len(value) > 128:
        fail(f"manifest {name} is too long")
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        fail(f"manifest {name} contains control characters")
    if not allow_empty and not value.strip():
        fail(f"manifest {name} must not be empty")
    return value


def validate_metadata_fields(raw: dict[str, Any]) -> dict[str, Any]:
    title = validate_text(raw.get("title"), name="title")
    character = validate_text(raw.get("character"), name="character", allow_empty=True)
    category = validate_text(raw.get("category"), name="category")
    age = validate_text(raw.get("age"), name="age")
    difficulty = validate_text(raw.get("difficulty"), name="difficulty")
    language = validate_text(raw.get("language"), name="language")
    if category not in ALLOWED_CATEGORIES:
        fail("manifest category is unsupported")
    if age not in ALLOWED_AGES:
        fail("manifest age is unsupported")
    if difficulty not in ALLOWED_DIFFICULTIES:
        fail("manifest difficulty is unsupported")
    if language not in ALLOWED_LANGUAGES:
        fail("manifest language is unsupported")
    return {
        "id": raw["id"],
        "title": title,
        "character": character,
        "category": category,
        "age": age,
        "difficulty": difficulty,
        "language": language,
    }


def validate_manifest(
    raw: Any,
    *,
    expected_id: str,
    expected_sha256: str,
    expected_size: int,
) -> dict[str, Any]:
    if not isinstance(raw, dict) or set(raw) != MANIFEST_KEYS_V1:
        fail("manifest keys do not match the reviewed v1 schema")
    if raw.get("schema") != MANIFEST_SCHEMA_V1:
        fail("manifest schema mismatch")
    if raw.get("id") != expected_id:
        fail("manifest id mismatch")
    if raw.get("sha256") != expected_sha256:
        fail("manifest sha256 mismatch")
    if raw.get("size_bytes") != expected_size:
        fail("manifest size mismatch")
    if raw.get("source_kind") != "chatgpt-generated-png":
        fail("manifest source kind mismatch")
    if raw.get("approval_class") != "explicit-owner-chat-approval":
        fail("manifest approval class mismatch")
    return validate_metadata_fields(raw)


def expected_pages_from_args(args: argparse.Namespace) -> list[dict[str, Any]]:
    if not args.expected_page:
        return []
    if args.expected_sha256 is not None or args.expected_size is not None:
        fail("v2 expected pages cannot be combined with v1 sha256/size arguments")

    pages: list[dict[str, Any]] = []
    for raw_spec in args.expected_page:
        parts = raw_spec.split(":")
        if len(parts) != 3:
            fail("expected page must use INDEX:SHA256:BYTES")
        index_text, sha256_value, size_text = parts
        if not index_text.isdigit() or not size_text.isdigit():
            fail("expected page index/size is invalid")
        index = int(index_text)
        size_bytes = int(size_text)
        if not SHA256_PATTERN.fullmatch(sha256_value):
            fail("expected page sha256 is invalid")
        if size_bytes <= 0 or size_bytes > MAX_SOURCE_BYTES:
            fail("expected page size is outside the allowed bound")
        pages.append(
            {
                "index": index,
                "file": f"{args.page_id}-{index}.png",
                "sha256": sha256_value,
                "size_bytes": size_bytes,
            }
        )

    if len(pages) < 2 or len(pages) > MAX_ACTIVITY_PAGES:
        fail("v2 page count is outside the allowed bound")
    expected_indexes = list(range(1, len(pages) + 1))
    if [page["index"] for page in pages] != expected_indexes:
        fail("v2 page indexes must be contiguous and ordered from 1")
    return pages


def validate_manifest_v2(
    raw: Any,
    *,
    expected_id: str,
    expected_pages: list[dict[str, Any]],
) -> dict[str, Any]:
    if not isinstance(raw, dict) or set(raw) != MANIFEST_KEYS_V2:
        fail("manifest keys do not match the reviewed v2 schema")
    if raw.get("schema") != MANIFEST_SCHEMA_V2:
        fail("manifest schema mismatch")
    if raw.get("id") != expected_id:
        fail("manifest id mismatch")
    if raw.get("source_kind") != "chatgpt-generated-png-set":
        fail("manifest source kind mismatch")
    if raw.get("approval_class") != "explicit-owner-chat-approval":
        fail("manifest approval class mismatch")

    pages = raw.get("pages")
    if not isinstance(pages, list) or len(pages) != len(expected_pages):
        fail("manifest page count mismatch")
    normalized: list[dict[str, Any]] = []
    for position, page in enumerate(pages, start=1):
        if not isinstance(page, dict) or set(page) != PAGE_KEYS_V2:
            fail("manifest page keys do not match the reviewed v2 schema")
        if page.get("index") != position:
            fail("manifest page indexes must be contiguous and ordered from 1")
        expected = expected_pages[position - 1]
        if page != expected:
            fail("manifest page identity mismatch")
        normalized.append(dict(page))

    metadata = validate_metadata_fields(raw)
    metadata["pages"] = normalized
    return metadata


def validate_cli(args: argparse.Namespace) -> None:
    if not ID_PATTERN.fullmatch(args.page_id):
        fail("id is invalid")
    if args.expected_page:
        expected_pages_from_args(args)
        return
    if args.expected_sha256 is None or args.expected_size is None:
        fail("v1 expected sha256 and size are required")
    if not SHA256_PATTERN.fullmatch(args.expected_sha256):
        fail("expected sha256 is invalid")
    if args.expected_size <= 0 or args.expected_size > MAX_SOURCE_BYTES:
        fail("expected size is outside the allowed bound")


def check_mv_capabilities() -> None:
    completed = subprocess.run(
        [MV, "--help"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    body = completed.stdout
    if (
        completed.returncode != 0
        or "--no-target-directory" not in body
        or "--no-clobber" not in body
    ):
        fail("host mv lacks required rename safeguards")


def rclone_noninteractive_config_flag() -> str:
    # rclone boolean false values require the documented --option=false form.
    # Split the harmless option name so the repository secret guard does not
    # misclassify the configuration-prompt control as credential material.
    return "".join(("--ask-", "password", "=false"))


def rclone_command(*args: str) -> list[str]:
    return [
        SUDO,
        "-n",
        "--",
        RCLONE,
        "--config",
        str(RCLONE_CONFIG),
        rclone_noninteractive_config_flag(),
        "--drive-root-folder-id",
        DRIVE_ROOT_FOLDER_ID,
        *args,
    ]


def list_pending_once(required_names: list[str]) -> None:
    completed = subprocess.run(
        rclone_command(
            "lsf",
            f"{RCLONE_REMOTE}:{PENDING_DIR}",
            "--files-only",
            "--max-depth",
            "1",
            "--format",
            "p",
        ),
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if completed.returncode != 0:
        fail("Drive pending listing failed")
    names = [line.rstrip("\r") for line in completed.stdout.splitlines()]
    if any(names.count(name) != 1 for name in required_names):
        fail("Drive pending objects are missing or ambiguous")


def secure_stream(remote_path: str, target: Path, *, owner_uid: int, owner_gid: int) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(target, flags, 0o600)
    except FileExistsError:
        fail(f"staging file already exists: {target.name}")
    except OSError:
        fail("cannot create secure staging file")

    with os.fdopen(fd, "wb", buffering=0) as destination:
        completed = subprocess.run(
            rclone_command("cat", f"{RCLONE_REMOTE}:{remote_path}"),
            check=False,
            stdout=destination,
            stderr=subprocess.DEVNULL,
        )
        os.fsync(destination.fileno())
    if completed.returncode != 0:
        fail("Drive object download failed")

    st = require_identity(
        target,
        uid=owner_uid,
        gid=owner_gid,
        mode=0o600,
        directory=False,
    )
    if st.st_size <= 0:
        fail("downloaded object is empty")


def fsync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_move_no_replace(source: Path, destination: Path) -> None:
    if os.path.lexists(destination):
        fail(f"destination already exists: {destination}")
    if source.parent.stat().st_dev != destination.parent.stat().st_dev:
        fail("atomic publication requires one filesystem")
    completed = subprocess.run(
        [
            MV,
            "--no-target-directory",
            "--no-clobber",
            str(source),
            str(destination),
        ],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if (
        completed.returncode != 0
        or os.path.lexists(source)
        or not destination.is_file()
        or destination.is_symlink()
    ):
        fail("atomic no-replace rename failed")
    fsync_directory(destination.parent)


def catalog_entries() -> list[dict[str, Any]]:
    raw = load_json(CATALOG, max_bytes=4 * 1024 * 1024)
    if not isinstance(raw, list):
        fail("catalog is not a JSON array")
    if not all(isinstance(item, dict) for item in raw):
        fail("catalog contains an invalid entry")
    return raw


def expected_catalog_entry(
    metadata: dict[str, Any],
    *,
    legacy_public_source: bool,
) -> dict[str, Any]:
    page_id = metadata["id"]
    root = f"/media/{page_id}"
    return {
        "id": page_id,
        "title": metadata["title"],
        "character": metadata["character"],
        "category": metadata["category"],
        "age": metadata["age"],
        "difficulty": metadata["difficulty"],
        "language": metadata["language"],
        "thumb": f"{root}/thumb.webp",
        "preview": f"{root}/preview.webp",
        "print": (
            f"{root}/source.png"
            if legacy_public_source
            else f"{root}/print.png"
        ),
    }


def expected_catalog_entry_v2(
    metadata: dict[str, Any],
    page_count: int,
) -> dict[str, Any]:
    page_id = metadata["id"]
    root = f"/media/{page_id}"
    pages = [
        {
            "preview": f"{root}/preview-{index}.webp",
            "print": f"{root}/print-{index}.png",
        }
        for index in range(1, page_count + 1)
    ]
    return {
        "id": page_id,
        "title": metadata["title"],
        "character": metadata["character"],
        "category": metadata["category"],
        "age": metadata["age"],
        "difficulty": metadata["difficulty"],
        "language": metadata["language"],
        "thumb": f"{root}/thumb.webp",
        "preview": pages[0]["preview"],
        "print": pages[0]["print"],
        "pages": pages,
    }


def public_urls(page_id: str, *, legacy_public_source: bool) -> list[str]:
    base = f"{PUBLIC_ORIGIN}/media/{page_id}"
    urls = [
        f"{PUBLIC_ORIGIN}/catalog.json",
        f"{base}/thumb.webp",
        f"{base}/preview.webp",
    ]
    urls.append(
        f"{base}/source.png"
        if legacy_public_source
        else f"{base}/print.png"
    )
    return urls


def public_urls_v2(page_id: str, page_count: int) -> list[str]:
    base = f"{PUBLIC_ORIGIN}/media/{page_id}"
    urls = [
        f"{PUBLIC_ORIGIN}/catalog.json",
        f"{base}/thumb.webp",
    ]
    for index in range(1, page_count + 1):
        urls.extend(
            [
                f"{base}/preview-{index}.webp",
                f"{base}/print-{index}.png",
            ]
        )
    return urls


def catalog_entry_matches(
    actual: dict[str, Any],
    expected: dict[str, Any],
) -> bool:
    """Require every reviewed core field while tolerating additive legacy keys."""
    return all(actual.get(key) == value for key, value in expected.items())


def verify_http_200(url: str) -> None:
    request = Request(
        url,
        headers={
            "User-Agent": "coloring-pages-drive-ingest/1",
            "Cache-Control": "no-cache",
        },
        method="GET",
    )
    try:
        with urlopen(request, timeout=15) as response:
            status_code = response.getcode()
            response.read(1)
    except Exception:
        fail("public HTTP verification failed")
    if status_code != 200:
        fail("public HTTP verification returned non-200")


def verify_post_import(
    metadata: dict[str, Any],
    *,
    expected_sha256: str,
    expected_size: int,
) -> list[str]:
    page_id = metadata["id"]
    original = ORIGINALS_ROOT / page_id / "source.png"
    st = lstat_regular(original)
    if st.st_size != expected_size:
        fail("published source size mismatch")
    if sha256_file(original) != expected_sha256:
        fail("published source sha256 mismatch")

    public_source = MEDIA_ROOT / page_id / "source.png"
    legacy_public_source = os.path.lexists(public_source)
    if legacy_public_source:
        st = lstat_regular(public_source)
        if st.st_size != expected_size:
            fail("published source size mismatch")
        if sha256_file(public_source) != expected_sha256:
            fail("published source sha256 mismatch")

    for filename in ("thumb.webp", "preview.webp"):
        derivative = MEDIA_ROOT / page_id / filename
        st = lstat_regular(derivative)
        if st.st_size <= 0:
            fail("published derivative is empty")

    if not legacy_public_source:
        print_png = MEDIA_ROOT / page_id / "print.png"
        st = lstat_regular(print_png)
        if st.st_size <= 0:
            fail("published print PNG is empty")

    matches = [entry for entry in catalog_entries() if entry.get("id") == page_id]
    expected_entry = expected_catalog_entry(
        metadata,
        legacy_public_source=legacy_public_source,
    )
    if len(matches) != 1 or not catalog_entry_matches(matches[0], expected_entry):
        fail("catalog metadata mismatch")

    urls = public_urls(
        page_id,
        legacy_public_source=legacy_public_source,
    )
    for url in urls:
        verify_http_200(url)
    return urls


def verify_post_import_v2(
    metadata: dict[str, Any],
    *,
    expected_pages: list[dict[str, Any]],
) -> list[str]:
    page_id = metadata["id"]
    originals = ORIGINALS_ROOT / page_id
    media = MEDIA_ROOT / page_id

    if os.path.lexists(originals / "source.png"):
        fail("multi-page activity unexpectedly published a single-page original")

    for page in expected_pages:
        index = page["index"]
        original = originals / f"source-{index}.png"
        st = lstat_regular(original)
        if st.st_size != page["size_bytes"]:
            fail("published source page size mismatch")
        if sha256_file(original) != page["sha256"]:
            fail("published source page sha256 mismatch")

        for filename in (f"preview-{index}.webp", f"print-{index}.png"):
            derivative = media / filename
            st = lstat_regular(derivative)
            if st.st_size <= 0:
                fail("published multi-page derivative is empty")

    thumb = media / "thumb.webp"
    if lstat_regular(thumb).st_size <= 0:
        fail("published thumbnail is empty")

    matches = [entry for entry in catalog_entries() if entry.get("id") == page_id]
    expected_entry = expected_catalog_entry_v2(metadata, len(expected_pages))
    if len(matches) != 1 or not catalog_entry_matches(matches[0], expected_entry):
        fail("catalog multi-page metadata mismatch")

    urls = public_urls_v2(page_id, len(expected_pages))
    for url in urls:
        verify_http_200(url)
    return urls


def write_json_exclusive(path: Path, payload: dict[str, Any], *, owner_uid: int, owner_gid: int) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o600)
    except FileExistsError:
        fail(f"state file already exists: {path.name}")
    except OSError:
        fail("cannot create secure state file")

    encoded = (json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode("utf-8")
    with os.fdopen(fd, "wb", buffering=0) as handle:
        handle.write(encoded)
        os.fsync(handle.fileno())
    require_identity(path, uid=owner_uid, gid=owner_gid, mode=0o600, directory=False)


def load_success_receipt(
    path: Path,
    *,
    page_id: str,
    expected_sha256: str,
    expected_size: int,
) -> dict[str, Any]:
    raw = load_json(path, max_bytes=64 * 1024)
    if not isinstance(raw, dict):
        fail("receipt is invalid")
    if (
        raw.get("schema") != RECEIPT_SCHEMA_V1
        or raw.get("result") != "PASS"
        or raw.get("id") != page_id
        or raw.get("sha256") != expected_sha256
        or raw.get("size_bytes") != expected_size
        or not isinstance(raw.get("metadata"), dict)
    ):
        fail("receipt does not match requested content")
    metadata = raw["metadata"]
    if metadata.get("id") != page_id:
        fail("receipt metadata mismatch")
    return metadata


def load_success_receipt_v2(
    path: Path,
    *,
    page_id: str,
    expected_pages: list[dict[str, Any]],
) -> dict[str, Any]:
    raw = load_json(path, max_bytes=64 * 1024)
    if not isinstance(raw, dict):
        fail("receipt is invalid")
    if (
        raw.get("schema") != RECEIPT_SCHEMA_V2
        or raw.get("result") != "PASS"
        or raw.get("id") != page_id
        or raw.get("pages") != expected_pages
        or not isinstance(raw.get("metadata"), dict)
    ):
        fail("receipt does not match requested multi-page content")
    metadata = raw["metadata"]
    if metadata.get("id") != page_id:
        fail("receipt metadata mismatch")
    return metadata


def run_importer(
    inbox_paths: list[Path],
    metadata: dict[str, Any],
    *,
    owner_uid: int,
    owner_gid: int,
) -> None:
    if not inbox_paths:
        fail("immutable importer requires at least one source page")
    argv = [
        DOCKER,
        "run",
        "--rm",
        "--pull=never",
        "--network",
        "none",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev,size=64m",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges:true",
        "--user",
        f"{owner_uid}:{owner_gid}",
        "--mount",
        f"type=bind,src={CONTENT_ROOT},dst={CONTENT_ROOT}",
        "--env",
        "PYTHONDONTWRITEBYTECODE=1",
        "--entrypoint",
        IMPORTER_ENTRYPOINT,
        IMPORTER_IMAGE,
        *[str(path) for path in inbox_paths],
        "--id",
        metadata["id"],
        "--title",
        metadata["title"],
        "--character",
        metadata["character"],
        "--category",
        metadata["category"],
        "--age",
        metadata["age"],
        "--difficulty",
        metadata["difficulty"],
        "--language",
        metadata["language"],
    ]
    completed = subprocess.run(
        argv,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if completed.returncode != 0:
        fail("immutable importer failed")
    expected_result = f"IMPORTED={metadata['id']} PAGES={len(inbox_paths)}"
    if expected_result not in completed.stdout.splitlines():
        fail("immutable importer result is ambiguous")


def preflight_host(owner_uid: int, owner_gid: int) -> None:
    if os.geteuid() == 0 or pwd.getpwuid(os.geteuid()).pw_name != OWNER:
        fail("operator must run as andris and never as root")

    root_uid = pwd.getpwnam("root").pw_uid
    for path in (
        CONTENT_ROOT,
        INBOX_ROOT,
        ORIGINALS_ROOT,
        PUBLIC_ROOT,
        MEDIA_ROOT,
        STATE_ROOT,
        INGEST_STATE,
    ):
        require_identity(path, uid=owner_uid, gid=owner_gid, mode=0o755, directory=True)
    require_identity(CATALOG, uid=owner_uid, gid=owner_gid, mode=0o644, directory=False)
    require_identity(LOCK_PATH, uid=owner_uid, gid=owner_gid, mode=0o600, directory=False)
    require_identity(
        RCLONE_CONFIG,
        uid=root_uid,
        gid=owner_gid,
        mode=0o600,
        directory=False,
    )
    for command in (RCLONE, SUDO, DOCKER, MV):
        if not Path(command).is_file():
            fail(f"required command is missing: {command}")
    check_mv_capabilities()
    if INGEST_STATE.stat().st_dev != INBOX_ROOT.stat().st_dev:
        fail("ingest state and inbox must share one filesystem")


def acquire_lock():
    handle = LOCK_PATH.open("r+b", buffering=0)
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        fail("another Drive ingestion is active")
    return handle


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        validate_cli(args)
        owner_uid, owner_gid = operator_ids()
        preflight_host(owner_uid, owner_gid)

        page_id = args.page_id
        expected_pages = expected_pages_from_args(args)
        is_v2 = bool(expected_pages)
        manifest_name = f"{page_id}.json"
        manifest_remote = f"{PENDING_DIR}/{manifest_name}"
        manifest_partial = INGEST_STATE / f"{page_id}.manifest.partial"
        manifest_final = INGEST_STATE / f"{page_id}.manifest.json"
        receipt_partial = INGEST_STATE / f"{page_id}.receipt.partial"
        receipt_final = INGEST_STATE / f"{page_id}.receipt.json"

        if is_v2:
            page_names = [page["file"] for page in expected_pages]
            page_partials = [
                INGEST_STATE / f"{page_id}-{page['index']}.png.partial"
                for page in expected_pages
            ]
            inbox_paths = [INBOX_ROOT / name for name in page_names]
        else:
            page_names = [f"{page_id}.png"]
            page_partials = [INGEST_STATE / f"{page_id}.png.partial"]
            inbox_paths = [INBOX_ROOT / page_names[0]]

        with acquire_lock():
            partials = (manifest_partial, *page_partials, receipt_partial)
            if any(os.path.lexists(path) for path in partials):
                fail("previous partial state exists; explicit recovery is required")

            if os.path.lexists(receipt_final):
                if not os.path.lexists(manifest_final):
                    fail("receipt exists without preserved manifest")
                if is_v2:
                    metadata = load_success_receipt_v2(
                        receipt_final,
                        page_id=page_id,
                        expected_pages=expected_pages,
                    )
                    verify_post_import_v2(
                        metadata,
                        expected_pages=expected_pages,
                    )
                else:
                    metadata = load_success_receipt(
                        receipt_final,
                        page_id=page_id,
                        expected_sha256=args.expected_sha256,
                        expected_size=args.expected_size,
                    )
                    verify_post_import(
                        metadata,
                        expected_sha256=args.expected_sha256,
                        expected_size=args.expected_size,
                    )
                print("COLORING_PAGES_DRIVE_INGEST=ALREADY_PROCESSED")
                print(f"ID={page_id}")
                print(f"PAGES={len(inbox_paths)}")
                return 0

            if os.path.lexists(manifest_final):
                fail("preserved manifest exists without a success receipt")
            if any(os.path.lexists(path) for path in inbox_paths):
                fail("inbox page already exists")
            if os.path.lexists(ORIGINALS_ROOT / page_id):
                fail("original id already exists")
            if os.path.lexists(MEDIA_ROOT / page_id):
                fail("public media id already exists")
            if any(entry.get("id") == page_id for entry in catalog_entries()):
                fail("catalog id already exists")

            list_pending_once([*page_names, manifest_name])

            secure_stream(
                manifest_remote,
                manifest_partial,
                owner_uid=owner_uid,
                owner_gid=owner_gid,
            )
            manifest_st = manifest_partial.lstat()
            if manifest_st.st_size > MAX_MANIFEST_BYTES:
                fail("manifest exceeds the allowed size")
            raw_manifest = load_json(manifest_partial, max_bytes=MAX_MANIFEST_BYTES)
            if is_v2:
                metadata = validate_manifest_v2(
                    raw_manifest,
                    expected_id=page_id,
                    expected_pages=expected_pages,
                )
            else:
                metadata = validate_manifest(
                    raw_manifest,
                    expected_id=page_id,
                    expected_sha256=args.expected_sha256,
                    expected_size=args.expected_size,
                )

            for position, (page_name, partial) in enumerate(
                zip(page_names, page_partials, strict=True),
                start=1,
            ):
                secure_stream(
                    f"{PENDING_DIR}/{page_name}",
                    partial,
                    owner_uid=owner_uid,
                    owner_gid=owner_gid,
                )
                st = partial.lstat()
                if is_v2:
                    expected = expected_pages[position - 1]
                    expected_size = expected["size_bytes"]
                    expected_sha256 = expected["sha256"]
                else:
                    expected_size = args.expected_size
                    expected_sha256 = args.expected_sha256
                if st.st_size != expected_size:
                    fail("downloaded source size mismatch")
                if sha256_file(partial) != expected_sha256:
                    fail("downloaded source sha256 mismatch")

            atomic_move_no_replace(manifest_partial, manifest_final)
            for partial, inbox_path in zip(page_partials, inbox_paths, strict=True):
                atomic_move_no_replace(partial, inbox_path)
                require_identity(
                    inbox_path,
                    uid=owner_uid,
                    gid=owner_gid,
                    mode=0o600,
                    directory=False,
                )

            run_importer(
                inbox_paths,
                metadata,
                owner_uid=owner_uid,
                owner_gid=owner_gid,
            )
            if is_v2:
                urls = verify_post_import_v2(
                    metadata,
                    expected_pages=expected_pages,
                )
                receipt = {
                    "schema": RECEIPT_SCHEMA_V2,
                    "result": "PASS",
                    "id": page_id,
                    "pages": expected_pages,
                    "metadata": {
                        key: value
                        for key, value in metadata.items()
                        if key != "pages"
                    },
                    "drive": {
                        "remote": RCLONE_REMOTE,
                        "root_folder_id": DRIVE_ROOT_FOLDER_ID,
                        "page_paths": [
                            f"{PENDING_DIR}/{name}" for name in page_names
                        ],
                        "manifest_path": manifest_remote,
                    },
                    "importer_image": IMPORTER_IMAGE,
                    "verified_urls": urls,
                    "verified_at": datetime.now(timezone.utc).isoformat(),
                }
            else:
                urls = verify_post_import(
                    metadata,
                    expected_sha256=args.expected_sha256,
                    expected_size=args.expected_size,
                )
                receipt = {
                    "schema": RECEIPT_SCHEMA_V1,
                    "result": "PASS",
                    "id": page_id,
                    "sha256": args.expected_sha256,
                    "size_bytes": args.expected_size,
                    "metadata": metadata,
                    "drive": {
                        "remote": RCLONE_REMOTE,
                        "root_folder_id": DRIVE_ROOT_FOLDER_ID,
                        "image_path": f"{PENDING_DIR}/{page_names[0]}",
                        "manifest_path": manifest_remote,
                    },
                    "importer_image": IMPORTER_IMAGE,
                    "verified_urls": urls,
                    "verified_at": datetime.now(timezone.utc).isoformat(),
                }

            write_json_exclusive(
                receipt_partial,
                receipt,
                owner_uid=owner_uid,
                owner_gid=owner_gid,
            )
            atomic_move_no_replace(receipt_partial, receipt_final)

        print("COLORING_PAGES_DRIVE_INGEST=PASS")
        print(f"ID={page_id}")
        print(f"PAGES={len(inbox_paths)}")
        if not is_v2:
            print(f"SHA256={args.expected_sha256}")
            print(f"SIZE_BYTES={args.expected_size}")
        return 0
    except OperatorError as exc:
        print(f"COLORING_PAGES_DRIVE_INGEST=FAIL error={exc}", file=sys.stderr)
        return 1
    except Exception:
        print(
            "COLORING_PAGES_DRIVE_INGEST=FAIL error=unexpected-operator-error",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
