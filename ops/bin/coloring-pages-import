#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

fail() {
    printf 'COLORING_PAGES_IMPORT=FAIL error=%s\n' "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'USAGE'
Usage: coloring-pages-import <source.png> [metadata options]

Allowed metadata options:
  --id <value>
  --title <value>
  --character <value>
  --category <value>
  --age <value>
  --difficulty <value>
  --language <value>
USAGE
    exit 2
}

OWNER='andris'
CONTENT_ROOT='/srv/coloring-pages-content'
INBOX_ROOT="$CONTENT_ROOT/inbox"
ORIGINALS_ROOT="$CONTENT_ROOT/originals"
PUBLIC_ROOT="$CONTENT_ROOT/public"
MEDIA_ROOT="$PUBLIC_ROOT/media"
STATE_ROOT="$CONTENT_ROOT/state"
CATALOG="$PUBLIC_ROOT/catalog.json"
CONSUMER_SHA='d08a9657c764411de2e19545610218af8188ff5d'
IMAGE_REF='ghcr.io/rozkalnsandris/coloring-pages@sha256:1e6ceaeb9cc84164aef8f4680cee6ee9b4b9a3094e59c6026f590e58a3c043e8'
ENTRYPOINT='/usr/local/bin/coloring-pages-import'

[[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'operator must not run as root'
[[ "$(id -un)" == "$OWNER" ]] || fail 'operator must run as andris'

for command_name in docker dirname id realpath stat; do
    command -v "$command_name" >/dev/null 2>&1 \
        || fail "required command is missing: $command_name"
done

check_dir() {
    local path=$1
    [[ -d "$path" && ! -L "$path" ]] || fail "required directory is missing or unsafe: $path"
    [[ "$(stat -c '%U:%G:%a' "$path")" == 'andris:andris:755' ]] \
        || fail "required directory metadata drifted: $path"
}

for path in \
    "$CONTENT_ROOT" \
    "$INBOX_ROOT" \
    "$ORIGINALS_ROOT" \
    "$PUBLIC_ROOT" \
    "$MEDIA_ROOT" \
    "$STATE_ROOT"
do
    check_dir "$path"
done

[[ -f "$CATALOG" && ! -L "$CATALOG" ]] || fail 'catalog is missing or unsafe'
[[ "$(stat -c '%U:%G:%a' "$CATALOG")" == 'andris:andris:644' ]] \
    || fail 'catalog metadata drifted'

(( $# >= 1 )) || usage
SOURCE_INPUT=$1
shift
[[ -f "$SOURCE_INPUT" && ! -L "$SOURCE_INPUT" ]] || fail 'source must be a regular non-symlink file'
SOURCE_REAL="$(realpath -e -- "$SOURCE_INPUT")"
[[ "$(dirname -- "$SOURCE_REAL")" == "$INBOX_ROOT" ]] \
    || fail 'source must be a direct child of the content inbox'
[[ "$SOURCE_REAL" == "$INBOX_ROOT/"*.png ]] || fail 'source file name must end in .png'

EXTRA_ARGS=()
while (( $# > 0 )); do
    case "$1" in
        --id|--title|--character|--category|--age|--difficulty|--language)
            (( $# >= 2 )) || usage
            EXTRA_ARGS+=("$1" "$2")
            shift 2
            ;;
        --content-root|--content-root=*)
            fail '--content-root is fixed by the trusted operator'
            ;;
        *)
            fail "unsupported importer argument: $1"
            ;;
    esac
done

printf 'COLORING_PAGES_IMPORT_SOURCE_SHA=%s\n' "$CONSUMER_SHA"
printf 'COLORING_PAGES_IMPORT_IMAGE=%s\n' "$IMAGE_REF"
printf 'COLORING_PAGES_IMPORT_SOURCE=%s\n' "$SOURCE_REAL"

exec docker run \
    --rm \
    --pull=never \
    --network none \
    --read-only \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$CONTENT_ROOT,dst=$CONTENT_ROOT" \
    --env PYTHONDONTWRITEBYTECODE=1 \
    --entrypoint "$ENTRYPOINT" \
    "$IMAGE_REF" \
    "$SOURCE_REAL" \
    "${EXTRA_ARGS[@]}"
