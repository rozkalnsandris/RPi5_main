# SOURCE ONLY for RPi5_main #1224. Not installed or enabled by source merge.
[Unit]
Description=Ausmalwiese first-party GoatCounter pageview adapter
After=ausmalwiese-goatcounter.service
Requires=ausmalwiese-goatcounter.service
ConditionPathIsExecutable=/usr/local/libexec/ausmalwiese-goatcounter-v1/pageview-adapter.py
ConditionPathExists=/srv/coloring-pages-content/public/catalog.json

[Service]
Type=simple
User=ausmalwiese-pageview
Group=ausmalwiese-pageview
UMask=0077
LoadCredential=goatcounter-token:/etc/ausmalwiese-goatcounter/pageview-token
ExecStart=/usr/local/libexec/ausmalwiese-goatcounter-v1/pageview-adapter.py --serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/srv/coloring-pages-content/public/catalog.json
MemoryMax=96M
CPUQuota=25%
TasksMax=32
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
