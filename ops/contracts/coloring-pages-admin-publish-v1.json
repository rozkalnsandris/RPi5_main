      "taxonomy_sha256_required": true,
      "category_topic_compatibility": "each-kind-matches-at-least-one-selected-category",
      "importer_additional_topic_cli": "repeat---additional-topic",
      "importer_preflight": "pinned-immutable-image-cli-and-exact-registry-before-job-and-within-publication-lock",
      "persistence_postcheck": "same-id-single-record-ordered-topics",
      "release_gate": "owner-merge-then-separate-owner-live-full-install-and-runtime-verification",
      "pinned_source_sha": "1b292b238f491269fa11387b32f9d2742fc3aea1"
    }
  },
  "runtime": {
    "user": "andris",
