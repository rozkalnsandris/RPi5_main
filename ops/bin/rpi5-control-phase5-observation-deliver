#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "ops/lib/deploy_executor"
sys.path.insert(0, str(LIB))

import control_phase5_observation_delivery as delivery
import control_phase5_observation_signer as signer
import control_phase5_observation_transport as transport
import control_phase5_production_visibility as visibility
import control_phase5_signer_handoff as handoff

MAX_INPUT_BYTES = 64 * 1024


def strict_json_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def stop(code: str, http_status: int | None = None) -> int:
    receipt = {"schema_version": 1, "status": "STOP", "code": code}
    if type(http_status) is int:
        receipt["http_status"] = http_status
    print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
    return 2


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--validate-only", action="store_true")
    args = parser.parse_args()
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if not raw or len(raw) > MAX_INPUT_BYTES:
        return stop("INPUT_INVALID")
    try:
        request = json.loads(raw.decode("utf-8"), object_pairs_hook=strict_json_object)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
        return stop("INPUT_INVALID")
    if type(request) is not dict or set(request) != {"handoff", "expected", "visibility"}:
        return stop("INPUT_INVALID")
    now_iso = delivery.canonical_now()
    try:
        if args.validate_only:
            receipt = delivery.public_preflight_receipt(
                handoff=request["handoff"],
                expected=request["expected"],
                visibility=request["visibility"],
                now_iso=now_iso,
            )
        else:
            receipt = delivery.deliver_phase5_observation(
                handoff=request["handoff"],
                expected=request["expected"],
                visibility=request["visibility"],
                now_iso=now_iso,
            )
    except delivery.Phase5ObservationDeliveryError as exc:
        return stop(exc.code, exc.http_status)
    except handoff.Phase5SignerHandoffError as exc:
        return stop(exc.code)
    except visibility.ProductionVisibilityContractError as exc:
        return stop(exc.code)
    except transport.ObservationTransportContractError as exc:
        return stop(exc.code)
    except signer.Phase5ObservationSignerError as exc:
        return stop(exc.code)
    except Exception:
        return stop("UNEXPECTED_ERROR")
    print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
