{
  "schema": "rozkalns-weather.weathernext-private-gcs-simple-canary.v1",
  "implementation_issue": 843,
  "source_only": true,
  "execution_enabled": false,
  "source_merge_authorizes_live": false,
  "canonical_weather_repository": "rozkalnsandris/rozkalns_weather",
  "weather_canary_command": "python -m rozkalns_weather weathernext-gcs-canary --init <exact-UTC-init>",
  "execution_shape": {
    "container": "ephemeral",
    "remove_after_exit": true,
    "exact_weather_image_required": true,
    "credential_mount": {
      "source": "/var/lib/rpi5-deploy/weathernext-google.json",
      "target": "/run/secrets/weathernext-google.json",
      "read_only": true,
      "caller_selectable_source": false,
      "caller_selectable_target": false
    },
    "database_mount": false,
    "application_stage": false,
    "gcs_host_install": false,
    "separate_gcs_runtime_materialization": false,
    "credential_copy": false,
    "gcs_auth_binding_creation": false
  },
  "canary_scope": {
    "location_id": "station_05480",
    "forecast_hours": 6,
    "data_surface": "WeatherNext 3 precomputed statistics GCS/Zarr",
    "production_write": false,
    "automatic_retry": false,
    "alternate_dataset_fallback": false
  },
  "retired_prerequisite_operations": [
    "rpi5.weathernext-private-gcs-backend.install.v1",
    "rpi5.weathernext-private-application-stage.v1",
    "rozkalns-weather.weathernext-private-gcs-runtime-materialization.v1",
    "rpi5.weathernext-private-gcs-auth-binding.v1"
  ],
  "next_gate_after_merge": "OWNER_AUTHORIZED_EPHEMERAL_GCS_CANARY",
  "credential_host_file": {
    "path": "/var/lib/rpi5-deploy/weathernext-google.json",
    "uid": 0,
    "gid": 0,
    "mode": "0600",
    "max_bytes": 65536,
    "regular_file_required": true,
    "single_link_required": true,
    "symlink_allowed": false
  }
}
