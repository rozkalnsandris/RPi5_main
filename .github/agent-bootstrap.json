{
  "schema": "rozkalns.agent-bootstrap.v1",
  "repository": "rozkalnsandris/RPi5_main",
  "shared_policy": {
    "work_cycle": "docs/WORK_CYCLE_V23_ADOPTION.md",
    "github_api_access": ".github/github-api-access-v1.json"
  },
  "rules": {
    "primary": "AGENTS.md",
