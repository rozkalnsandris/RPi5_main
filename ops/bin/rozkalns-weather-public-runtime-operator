#!/usr/bin/env python3
from __future__ import annotations

from dataclasses import asdict
from datetime import datetime, timezone
import argparse
import json
from pathlib import Path
import sys
import time
from typing import Any

SUPPORT_ROOT = Path('/usr/local/libexec/rozkalns-weather-public-runtime-operator')
PACKAGE_INIT = SUPPORT_ROOT / 'deploy_executor' / '__init__.py'
_RUNTIME_CACHE_ETAG = 'weather-composite-consumed-jit-cache-v1'
_SOURCE_REPOSITORIES = frozenset(
    {
        'rozkalnsandris/rozkalns_weather',
        'rozkalnsandris/RPi5_main',
    }
)
_PUBLIC_SOURCE_MAX_ATTEMPTS = 3
_PUBLIC_SOURCE_BACKOFF_SECONDS = (1.0, 2.0)
_TRANSIENT_HTTP_STATUSES = frozenset({502, 503, 504})
_LAST_CONSUMED_JIT_FAILURE_CODE: str | None = None


def _set_consumed_jit_failure(code: str) -> None:
    global _LAST_CONSUMED_JIT_FAILURE_CODE
    _LAST_CONSUMED_JIT_FAILURE_CODE = code


def _classify_consumed_jit_failure(exc: BaseException) -> str:
    name = type(exc).__name__
    status = getattr(exc, 'status', None)
    if name == 'NetworkFailure':
        return 'public_source_network'
    if name == 'RateLimitError':
        return 'public_source_rate_limited'
    if name == 'HTTPStatusError':
        if status in _TRANSIENT_HTTP_STATUSES:
            return 'public_source_transient_http'
        return 'public_source_http_nonretryable'
    text = str(exc).lower()
    if any(
        token in text
        for token in (
            'response time is unavailable',
            'omitted date header',
            'date header is invalid',
            'date header is malformed',
            'date header has no timezone',
            'date header is not timezone-aware',
        )
    ):
        return 'github_time_unavailable_or_invalid'
    if 'not canonical to whole seconds' in text:
        return 'github_time_noncanonical'
    if 'regressed during weather revalidation' in text:
        return 'github_time_regressed'
    if 'inconsistent during weather revalidation' in text:
        return 'github_time_spread_exceeded'
    if 'github response time' in text or 'github time' in text:
        return 'github_time_other'
    if 'replay' in text or 'consum' in text:
        return 'replay_state'
    if 'baseline' in text:
        return 'baseline_drift'
    if any(
        token in text
        for token in (
            'authorization',
            'authority',
            'queue',
            'source',
            'repository',
            'current main',
            'main sha',
            'ancestor',
            'workflow',
            'ci ',
        )
    ):
        return 'authority_or_source_drift'
    return 'canonical_revalidation'


def _record_consumed_jit_failure(exc: BaseException) -> None:
    if _LAST_CONSUMED_JIT_FAILURE_CODE is None:
        _set_consumed_jit_failure(_classify_consumed_jit_failure(exc))


def _stop(
    reason: str,
    *,
    issue_number: int | None = None,
    reuse_forbidden: bool = False,
    host_started: bool = False,
    production_started: bool = False,
    failure_reason_code: str | None = None,
) -> int:
    payload = {
        'schema': 'rozkalns-weather.public-runtime-composite-operator-receipt.v1',
        'result': 'FAIL_CLOSED',
        'authorization_issue_number': issue_number,
        'safe_stage': reason,
        'authorization_reuse_forbidden': reuse_forbidden,
        'host_mutation_started': host_started,
        'production_mutation_started': production_started,
        'automatic_retry': False,
        'automatic_cleanup': False,
        'automatic_rollback': False,
    }
    if failure_reason_code is not None:
        payload['failure_reason_code'] = failure_reason_code
    print(json.dumps(payload, sort_keys=True, separators=(',', ':')))
    return 78


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description='Run one exact owner-authorized Weather Composite STRICT LIVE request')
    parser.add_argument('--issue-number', type=int, required=True)
    return parser


def _issue_created_at(issue: Any) -> datetime | None:
    if type(issue) is not dict:
        return None
    value = issue.get('created_at')
    if type(value) is not str or not value.endswith('Z'):
        return None
    try:
        parsed = datetime.fromisoformat(value[:-1] + '+00:00')
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed.astimezone(timezone.utc)


def _cacheable_public_source_path(path: Any) -> bool:
    if type(path) is not str or not path.startswith('/repos/'):
        return False
    remainder = path[len('/repos/'):]
    parts = remainder.split('/', 2)
    if len(parts) < 2 or f'{parts[0]}/{parts[1].split("?", 1)[0]}' not in _SOURCE_REPOSITORIES:
        return False
    return (
        len(parts) == 2
        or path.endswith('/branches/main')
        or '/compare/' in path
        or '/actions/workflows/' in path
        or '/actions/runs/' in path
    )


def _install_runtime_jit_hardening() -> None:
    from deploy_executor import weather_public_runtime_composite as composite
    from deploy_executor import weather_public_runtime_operator as operator
    from deploy_executor.transport import HTTPStatusError, NetworkFailure, RateLimitError

    if getattr(composite, '_WEATHER_CONSUMED_JIT_HARDENING_V2', False):
        return

    state = {'consumed_depth': 0, 'post_consume_seen': False}
    original_accept_issue = composite.accept_issue
    original_verify_unchanged = composite.verify_authorization_unchanged
    original_consumed_revalidate = (
        composite.ConcreteCanonicalWeatherCompositeRevalidator.revalidate_consumed_composite
    )
    original_public_client = composite.FixedPublicGitHubReadClient
    original_timed_client = composite._TimedSourceClient
    original_time_window = composite._GitHubTimeWindow
    original_baseline_for_gate = operator._baseline_for_gate

    def in_consumed_revalidation() -> bool:
        return state['consumed_depth'] > 0

    def runtime_accept_issue(issue: Any, **kwargs: Any):
        if in_consumed_revalidation():
            created_at = _issue_created_at(issue)
            if created_at is not None:
                kwargs['server_time'] = created_at
        return original_accept_issue(issue, **kwargs)

    def runtime_verify_unchanged(accepted: Any, current_issue: Any, **kwargs: Any) -> None:
        if in_consumed_revalidation():
            kwargs['server_time'] = accepted.created_at
        original_verify_unchanged(accepted, current_issue, **kwargs)

    def runtime_revalidate_consumed(self: Any, authorization_issue_number: int):
        state['post_consume_seen'] = True
        state['consumed_depth'] += 1
        try:
            return original_consumed_revalidate(self, authorization_issue_number)
        except Exception as exc:
            _record_consumed_jit_failure(exc)
            raise
        finally:
            state['consumed_depth'] -= 1

    def runtime_baseline_for_gate(provider: Any, authority: Any, gate: str):
        try:
            return original_baseline_for_gate(provider, authority, gate)
        except Exception as exc:
            if state['post_consume_seen']:
                _record_consumed_jit_failure(exc)
            raise

    class RuntimeGitHubTimeWindow(original_time_window):
        def observe(self, value: Any) -> None:
            if not in_consumed_revalidation():
                return super().observe(value)
            if not isinstance(value, datetime) or value.tzinfo is None:
                raise composite.WeatherCompositeAuthorityError(
                    'GitHub response time is unavailable'
                )
            observed = value.astimezone(timezone.utc)
            if observed.microsecond != 0:
                raise composite.WeatherCompositeAuthorityError(
                    'GitHub response time is not canonical to whole seconds'
                )
            if self.first is None:
                self.first = observed
            # Admission already enforced owner TTL and the strict 30-second sequence
            # before durable replay consume. Post-consume JIT must still require a
            # canonical GitHub timestamp, but transport duration or cross-surface Date
            # ordering must not burn the one-shot authority. Keep the newest observed
            # value so returned evidence never moves backward.
            if self.last is None or observed > self.last:
                self.last = observed

    class RuntimePublicSourceSender:
        def __init__(self, sender: Any):
            self._sender = sender

        def send(self, *, method: str, url: str, headers: Any):
            response = self._sender.send(method=method, url=url, headers=headers)
            response_headers = {
                str(key).lower(): str(value).strip()
                for key, value in response.headers.items()
            }
            rate_limited = (
                response.status == 429
                or (
                    response.status == 403
                    and (
                        response_headers.get('x-ratelimit-remaining') == '0'
                        or 'retry-after' in response_headers
                    )
                )
            )
            if rate_limited:
                retry_after_text = response_headers.get('retry-after', '')
                retry_after = int(retry_after_text) if retry_after_text.isdigit() else 0
                raise RateLimitError(response.status, retry_after)
            return response

    class RuntimePublicSourceClient(original_public_client):
        def __init__(self, *args: Any, **kwargs: Any):
            super().__init__(*args, **kwargs)
            self._sender = RuntimePublicSourceSender(self._sender)
            self._consumed_evidence_cache: dict[str, Any] = {}

        def _fresh_get_with_retry(self, path_or_url: str):
            for attempt in range(_PUBLIC_SOURCE_MAX_ATTEMPTS):
                try:
                    return super().get_json(path_or_url)
                except NetworkFailure:
                    if attempt + 1 >= _PUBLIC_SOURCE_MAX_ATTEMPTS:
                        if in_consumed_revalidation():
                            _set_consumed_jit_failure('public_source_network')
                        raise
                except RateLimitError:
                    if in_consumed_revalidation():
                        _set_consumed_jit_failure('public_source_rate_limited')
                    raise
                except HTTPStatusError as exc:
                    if exc.status not in _TRANSIENT_HTTP_STATUSES:
                        if in_consumed_revalidation():
                            _set_consumed_jit_failure('public_source_http_nonretryable')
                        raise
                    if attempt + 1 >= _PUBLIC_SOURCE_MAX_ATTEMPTS:
                        if in_consumed_revalidation():
                            _set_consumed_jit_failure('public_source_transient_http')
                        raise
                time.sleep(_PUBLIC_SOURCE_BACKOFF_SECONDS[attempt])
            raise RuntimeError('unreachable public source retry state')

        def get_json(self, path_or_url: str):
            cacheable = _cacheable_public_source_path(path_or_url)
            if (
                in_consumed_revalidation()
                and cacheable
                and path_or_url in self._consumed_evidence_cache
            ):
                cached = self._consumed_evidence_cache[path_or_url]
                return composite.JSONResponse(
                    value=cached.value,
                    server_time=cached.server_time,
                    etag=_RUNTIME_CACHE_ETAG,
                    not_modified=False,
                    url=cached.url,
                    next_url=cached.next_url,
                )
            response = self._fresh_get_with_retry(path_or_url)
            if cacheable and not in_consumed_revalidation():
                self._consumed_evidence_cache[path_or_url] = response
            return response

    class RuntimeTimedSourceClient(original_timed_client):
        def get_json(self, path_or_url: str):
            response = self._client.get_json(path_or_url)
            if getattr(response, 'etag', None) != _RUNTIME_CACHE_ETAG:
                self._window.observe(getattr(response, 'server_time', None))
            return response

    composite.accept_issue = runtime_accept_issue
    composite.verify_authorization_unchanged = runtime_verify_unchanged
    composite.ConcreteCanonicalWeatherCompositeRevalidator.revalidate_consumed_composite = runtime_revalidate_consumed
    composite.FixedPublicGitHubReadClient = RuntimePublicSourceClient
    composite._TimedSourceClient = RuntimeTimedSourceClient
    composite._GitHubTimeWindow = RuntimeGitHubTimeWindow
    operator.FixedPublicGitHubReadClient = RuntimePublicSourceClient
    operator._baseline_for_gate = runtime_baseline_for_gate
    composite._WEATHER_CONSUMED_JIT_HARDENING_V2 = True


def main(argv: list[str] | None = None) -> int:
    global _LAST_CONSUMED_JIT_FAILURE_CODE
    _LAST_CONSUMED_JIT_FAILURE_CODE = None
    args = _parser().parse_args(argv)
    if not PACKAGE_INIT.is_file():
        return _stop('operator_install_layout', issue_number=args.issue_number)
    sys.path.insert(0, str(SUPPORT_ROOT))
    try:
        from deploy_executor.weather_public_runtime_operator import WeatherCompositeOperatorError
        _install_runtime_jit_hardening()
        from deploy_executor.weather_public_runtime_operator import build_runtime_operator
    except (ImportError, RuntimeError, AttributeError, TypeError):
        return _stop('operator_import', issue_number=args.issue_number)
    try:
        receipt = build_runtime_operator().execute(args.issue_number)
    except WeatherCompositeOperatorError as exc:
        return _stop(
            exc.stage,
            issue_number=args.issue_number,
            reuse_forbidden=exc.authorization_reuse_forbidden,
            host_started=exc.host_mutation_started,
            production_started=exc.production_mutation_started,
            failure_reason_code=(
                _LAST_CONSUMED_JIT_FAILURE_CODE
                if exc.authorization_reuse_forbidden
                else None
            ),
        )
    print(json.dumps(asdict(receipt), sort_keys=True, separators=(',', ':')))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())