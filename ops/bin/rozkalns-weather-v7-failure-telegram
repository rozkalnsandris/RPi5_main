#!/usr/bin/env python3
"""Single-attempt, Weather v7-only Telegram failure signal (no generic unit scan)."""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import urllib.parse
import urllib.request

UNIT = "rozkalns-weather-operator-v7-dispatch-caller.service"
SYSTEMCTL = "/usr/bin/systemctl"
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
MAX_EVENTS = 256
REQUIRED = (
    "ActiveState", "Result", "ExecMainCode", "ExecMainStatus",
    "StateChangeTimestampMonotonic", "ExecMainExitTimestamp",
)
TOKEN_PATTERN = re.compile(r"[0-9]{6,}:[A-Za-z0-9_-]{20,}")
CHAT_PATTERN = re.compile(r"-?[0-9]{1,20}")
BOOT_PATTERN = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")
DATE_PATTERN = re.compile(r"[A-Za-z]{3} [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [A-Za-z0-9+:-]{1,8}")


class AlertError(Exception):
    """Failure details must never be logged; they can include Telegram tokens."""


def failure_event(output: str, boot_id: str) -> dict[str, str]:
    if len(output) > 8192 or not BOOT_PATTERN.fullmatch(boot_id):
        raise AlertError("unsafe metadata")
    rows: dict[str, str] = {}
    for line in output.splitlines():
        if "=" not in line:
            raise AlertError("invalid metadata")
        key, value = line.split("=", 1)
        if key not in REQUIRED or key in rows:
            raise AlertError("unexpected metadata")
        rows[key] = value
    if set(rows) != set(REQUIRED):
        raise AlertError("missing metadata")
    if rows["ActiveState"] != "failed":
        raise AlertError("unit is not failed")
    if rows["Result"] not in {
        "exit-code", "signal", "core-dump", "timeout", "watchdog",
        "resources", "protocol", "start-limit-hit", "oom-kill",
    }:
        raise AlertError("unrecognized failure")
    if not re.fullmatch(r"[0-9]{1,3}", rows["ExecMainCode"]):
        raise AlertError("invalid code")
    if not re.fullmatch(r"[0-9]{1,3}", rows["ExecMainStatus"]):
        raise AlertError("invalid status")
    if not re.fullmatch(r"[1-9][0-9]{0,19}", rows["StateChangeTimestampMonotonic"]):
        raise AlertError("no distinct failure transition")
    if not DATE_PATTERN.fullmatch(rows["ExecMainExitTimestamp"]):
        raise AlertError("invalid incident timestamp")
    rows["BootId"] = boot_id
    return rows


def read_current_failure() -> dict[str, str]:
    try:
        cp = subprocess.run(
            [SYSTEMCTL, "show", UNIT, "--no-pager",
             "--property=" + ",".join(REQUIRED)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            check=True, text=True, timeout=5,
            env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"},
        )
        boot = BOOT_ID.read_text(encoding="ascii").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        raise AlertError("metadata unavailable") from None
    return failure_event(cp.stdout, boot)


def read_credential(directory: Path, name: str, pattern: re.Pattern[str]) -> str:
    # LoadCredential hands the notifier two private files, never CLI arguments.
    fd = os.open(str(directory), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        child = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
        try:
            meta = os.fstat(child)
            if not stat.S_ISREG(meta.st_mode) or meta.st_size > 256:
                raise AlertError("unsafe credential")
            raw = os.read(child, 257)
        finally:
            os.close(child)
    finally:
        os.close(fd)
    try:
        value = raw.decode("ascii").strip()
    except UnicodeDecodeError:
        raise AlertError("invalid credential") from None
    if not pattern.fullmatch(value):
        raise AlertError("invalid credential")
    return value


def telegram_send(token: str, chat_id: str, message: str) -> bool:
    payload = urllib.parse.urlencode({"chat_id": chat_id, "text": message}).encode("ascii")
    request = urllib.request.Request(
        "https://api.telegram.org/bot" + token + "/sendMessage",
        data=payload, method="POST",
    )
    # Ignore ambient proxy configuration; never print HTTP exception URLs.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=5) as response:
        if response.status != 200:
            return False
        body = response.read(4097)
    if len(body) > 4096:
        return False
    try:
        answer = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        return False
    return isinstance(answer, dict) and answer.get("ok") is True


def notice(event: dict[str, str]) -> str:
    return (
        "RPi5 Weather v7: NEW FAILED invocation\n"
        "unit=" + UNIT + "\n"
        "result=" + event["Result"] + " code=" + event["ExecMainCode"]
        + " status=" + event["ExecMainStatus"] + "\n"
        "exit=" + event["ExecMainExitTimestamp"] + "\n"
        "Historical accepted failure is not automatically replayed."
    )


def notify_once(
    event: dict[str, str], state_dir: Path, credentials_dir: Path,
    sender=telegram_send,
) -> str:
    # A unique boot+transition token suppresses duplicates but permits new failures,
    # including a changed exit code after a future boot. Do not track all units.
    fingerprint = hashlib.sha256(
        "|".join([event["BootId"], event["StateChangeTimestampMonotonic"],
                  event["Result"], event["ExecMainCode"], event["ExecMainStatus"]]).encode("ascii")
    ).hexdigest()
    token = read_credential(credentials_dir, "telegram-token", TOKEN_PATTERN)
    chat = read_credential(credentials_dir, "telegram-chat-id", CHAT_PATTERN)
    fd_dir = os.open(str(state_dir), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if len(os.listdir(state_dir)) >= MAX_EVENTS:
            raise AlertError("notification ledger capacity reached")
        name = "failure-" + fingerprint + ".attempted"
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600, dir_fd=fd_dir)
        except FileExistsError:
            return "ALREADY_ATTEMPTED"
        try:
            # fsync before the only possible network attempt. Failures are NOT retried.
            os.write(fd, b"ATTEMPTED\n")
            os.fsync(fd)
            if not sender(token, chat, notice(event)):
                return "DELIVERY_UNKNOWN"
            os.write(fd, b"TELEGRAM_API_ACCEPTED\n")
            os.fsync(fd)
            return "API_ACCEPTED"
        finally:
            os.close(fd)
    finally:
        os.close(fd_dir)


def main() -> int:
    try:
        state = os.environ.get("STATE_DIRECTORY", "")
        creds = os.environ.get("CREDENTIALS_DIRECTORY", "")
        if not state or not creds or ":" in state:
            raise AlertError("systemd directories not provided")
        result = notify_once(read_current_failure(), Path(state), Path(creds))
        print("WEATHER_V7_FAILURE_ALERT=" + result)
        return 0 if result in {"API_ACCEPTED", "ALREADY_ATTEMPTED"} else 1
    except Exception as exc:
        # Never stringify an exception: HTTP failures may contain the bot token.
        print("WEATHER_V7_FAILURE_ALERT=FAIL_CLOSED error_class=" +
              type(exc).__name__, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
