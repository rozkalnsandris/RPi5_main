{
  "schema": "rozkalns.rpi5-main.coloring-pages-admin-publish.v1",
  "status": "source-only",
  "issue": 1149,
  "listener": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "trust": {
    "zone": "ADMIN",
    "public_route": false,
    "access_required": true
  },
  "upload": {
    "content_type": "application/zip",
    "allowed_extensions": [
      ".png"
    ],
    "max_archive_bytes": 52428800,
    "max_files": 20,
    "max_member_bytes": 26214400,
    "max_total_uncompressed_bytes": 167772160,
    "max_compression_ratio": 50,
    "extraction": "validated-stream-copy-no-extractall",
    "reject": [
      "directories",
      "nested-paths",
      "traversal",
      "symlinks",
      "special-files",
      "encrypted-entries",
      "duplicate-names",
      "non-png"
    ],
    "archive_role": "draft-png-handoff-only",
    "allowed_members": "top-level-png-only-no-manifest-or-metadata-files"
  },
  "publication": {
    "category_selection": "explicit-owner-ui-selection",
    "id_policy": "random-seven-digit-live-catalog-collision-check",
    "print_master": "pinned-immutable-coloring-pages-image",
    "importer": "pinned-immutable-coloring-pages-image",
    "shared_lock": "/srv/coloring-pages-content/state/drive-ingest/.lock",
    "automatic_retry": false,
    "automatic_rollback": false,
    "automatic_cleanup": false,
    "automatic_overwrite": false,
    "public_verification": true,
    "final_detail_links": true,
    "print_quality_gate": {
      "source_role": "uploaded-png-is-authoring-draft",
      "execution_order": [
        "prepare-all",
        "validate-all",
        "allocate-ids",
        "import"
      ],
      "prepare_tool": "pinned-immutable-coloring-pages-image:coloring-pages-print-master prepare",
      "validate_tool": "pinned-immutable-coloring-pages-image:coloring-pages-print-master validate",
      "fail_before_id_allocation_on_any_prepare_or_validate_failure": true,
      "prepared_master": {
        "portrait_px": [
          2480,
          3508
        ],
        "landscape_px": [
          3508,
          2480
        ],
        "mode": "RGB-no-alpha",
        "dpi": "approximately-300x300",
        "outer_border": "#FFFFFF",
        "safe_margin_mm": 15,
        "safe_margin_px_at_300_dpi": 177,
        "safe_margin_color": "#FFFFFF",
        "fit": "aspect-ratio-preserving-centered",
        "white_normalization": "canonical-near-white-to-exact-white",
        "resampling": "LANCZOS",
        "sharpening": "reviewed-conservative-unsharp-mask"
      }
    },
    "editorial_quality_gate": "owner-review-before-zip-upload",
    "zip_member_semantics": "each-png-is-one-independent-single-page-activity"
  },
  "runtime": {
    "user": "andris",
    "image_ref": "ghcr.io/rozkalnsandris/coloring-pages@sha256:2a80b56c20c37f4a530059c3e438c6627fd962786e6590dd914e59e86a837ba8"
  },
  "live_activation": "separate-owner-authorization"
}
