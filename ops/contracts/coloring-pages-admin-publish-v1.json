    "directory_mode": "0700",
    "file_mode": "0600",
    "owner": "andris",
    "rotation": {
      "handler": "logging.handlers.TimedRotatingFileHandler",
      "when": "midnight",
      "interval_days": 1,
      "backup_count": 7,
      "utc": true,
      "explicit_age_prune_days": 7,
      "prune_scope": "admin-publish.log and admin-publish.log.YYYY-MM-DD only"
    },
    "allowed_metadata": [
      "UTC timestamp",
      "severity",
      "event",
      "pid",
      "job id",
      "upload id",
      "page index/count",
      "step name/status/duration",
      "tool name",
      "timeout/exit status",
      "allocated page id",
      "sitemap/public verification phase",
      "terminal job status",
      "stale-job reconciliation",
      "partial succeeded-result count",
      "catalog action",
      "changed field names",
      "catalog SHA-256 before/after",
      "permanent-delete file count/byte count"
    ],
    "forbidden": [
