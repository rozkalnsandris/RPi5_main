[Unit]
Description=RPi5 post-reboot readiness verification
Documentation=https://github.com/rozkalnsandris/RPi5_main
Wants=network-online.target
After=network-online.target docker.service cloudflared.service ssh.service
OnSuccess=rpi5-maintenance-notify@%N.service
OnFailure=rpi5-maintenance-notify@%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rpi5-post-reboot
TimeoutStartSec=7min
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
