#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve()
REPO_LIB = HERE.parents[1] / "lib"
INSTALLED_LIB = Path.home() / ".local" / "lib" / "rpi5-browser-lifecycle"
for candidate in (REPO_LIB, INSTALLED_LIB):
    if (candidate / "browser_lifecycle.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from browser_lifecycle import (  # noqa: E402
    LifecycleError,
    cleanup_stale_records,
    default_state_dir,
    health_report,
    run_guarded,
)


def state_dir_arg(value: str | None) -> Path:
    return default_state_dir() if value is None else Path(value).expanduser()


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Fail-closed lifecycle guard for RPi5 browser-backed commands."
    )
    sub = p.add_subparsers(dest="action", required=True)

    health = sub.add_parser("health", help="read-only public-safe browser health preflight")
    health.add_argument("--state-dir")
    health.add_argument("--min-mem-available-mib", type=float, default=512.0)
    health.add_argument("--max-swap-used-percent", type=float, default=85.0)

    cleanup = sub.add_parser(
        "cleanup-stale", help="reap only stale processes with exact recorded ownership"
    )
    cleanup.add_argument("--state-dir")
    cleanup.add_argument("--min-age-seconds", type=float, default=300.0)
    cleanup.add_argument("--term-grace-seconds", type=float, default=3.0)

    run = sub.add_parser("run", help="run one command inside a bounded owned session")
    run.add_argument("--state-dir")
    run.add_argument("--label", default="browser")
    run.add_argument("--timeout-seconds", type=float, default=180.0)
    run.add_argument("--term-grace-seconds", type=float, default=3.0)
    run.add_argument("--poll-seconds", type=float, default=0.2)
    run.add_argument("--min-mem-available-mib", type=float, default=512.0)
    run.add_argument("--max-swap-used-percent", type=float, default=85.0)
    run.add_argument("command", nargs=argparse.REMAINDER)
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.action == "health":
            report = health_report(
                state_dir_arg(args.state_dir),
                min_mem_available_mib=args.min_mem_available_mib,
                max_swap_used_percent=args.max_swap_used_percent,
            )
            print(json.dumps(report, sort_keys=True))
            return 0 if report["status"] == "PASS" else 3

        if args.action == "cleanup-stale":
            report = cleanup_stale_records(
                state_dir_arg(args.state_dir),
                min_age_seconds=args.min_age_seconds,
                term_grace_seconds=args.term_grace_seconds,
            )
            print(json.dumps(report, sort_keys=True))
            return 0 if report["status"] == "CLEAN" else 4

        command = list(args.command)
        if command and command[0] == "--":
            command = command[1:]
        return run_guarded(
            command,
            label=args.label,
            state_dir=state_dir_arg(args.state_dir),
            timeout_seconds=args.timeout_seconds,
            term_grace_seconds=args.term_grace_seconds,
            poll_seconds=args.poll_seconds,
            min_mem_available_mib=args.min_mem_available_mib,
            max_swap_used_percent=args.max_swap_used_percent,
        )
    except LifecycleError as exc:
        print(
            json.dumps(
                {
                    "schema": "rpi5.browser-lifecycle.v1",
                    "status": "BLOCKED",
                    "error": str(exc),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 75


if __name__ == "__main__":
    raise SystemExit(main())
