#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

MODE="${1:-check}"
shift || true

EXPECTED_SHA=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --expected-sha)
      [[ $# -ge 2 ]] || { echo "missing value for --expected-sha" >&2; exit 64; }
      EXPECTED_SHA="$2"
      shift 2
      ;;
    *)
      echo "usage: $0 [check|apply|verify] --expected-sha <40-hex-sha>" >&2
      exit 64
      ;;
  esac
done

case "$MODE" in
  check|apply|verify) ;;
  *) echo "usage: $0 [check|apply|verify] --expected-sha <40-hex-sha>" >&2; exit 64 ;;
esac

[[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]] || {
  echo "Hermes Tech V20 retry: FAIL: exact --expected-sha is required" >&2
  exit 64
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd -P)"
SRC_CONFIG="$REPO/ops/nginx/hermes-tech.conf"
SRC_UNIT="$REPO/ops/systemd/hermes-tech-web.service"
INSTALLED_CONFIG="/etc/rpi5-hermes-tech-nginx.conf"
INSTALLED_UNIT="/etc/systemd/system/hermes-tech-web.service"
STATE_DIR="/var/lib/rpi5-main/hermes-tech-http-policy-v20"
STATE_FILE="$STATE_DIR/state.env"
BACKUP_UNIT="$STATE_DIR/hermes-tech-web.service.pre-v20"
RETRY_DIR="/var/lib/rpi5-main/hermes-tech-http-policy-v20-retry"
RETRY_STATE="$RETRY_DIR/state.env"
RETRY_EVIDENCE="$RETRY_DIR/evidence.log"

SERVICE="hermes-tech-web.service"
CONTAINER="hermes-blog"
FAILED_OPERATOR_SHA="f4c181b37ac67984c8cddd4a8da09454a1a36e88"
EXPECTED_IMAGE="sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa"
EXPECTED_V14_UNIT_SHA="a3cda6ca497de0b4594a974114ca99109946ff1097341d3c1606f800cb3c85c6"
EXPECTED_PORT="127.0.0.1:8089"
EXPECTED_PUBLIC_MOUNT="/home/andris/hermes-tech/site/public|/usr/share/nginx/html|false"
EXPECTED_CONFIG_MOUNT="/etc/rpi5-hermes-tech-nginx.conf|/etc/nginx/conf.d/default.conf|false"
PUBLIC_ORIGIN="https://tech.rozkalns.net"
LOOPBACK_ORIGIN="http://127.0.0.1:8089"
REPRESENTATIVE_PATH="/digest/2026-08-08/"
RSS_PATH="/index.xml"
LAN_ORIGIN="http://192.168.0.180:8089"
EXPECTED_CSP="default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'self'; script-src 'none'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; manifest-src 'self'"
EXPECTED_PERMISSIONS="camera=(), microphone=(), geolocation=(), payment=(), usb=()"

say() { printf '%s\n' "$*"; }
fail() { say "Hermes Tech V20 retry: FAIL: $*" >&2; exit 1; }
sha_of() { sha256sum "$1" | awk '{print $1}'; }
git_cmd() { git -c "safe.directory=$REPO" -C "$REPO" "$@"; }

ha_value() {
  curl -fsS --max-time 5 http://127.0.0.1:20241/metrics |
    awk '$1 == "cloudflared_tunnel_ha_connections" {t += $2; f=1} END {if (!f) exit 1; printf "%.0f\n", t}'
}

header_values() {
  local headers="$1" name="$2"
  awk -v want="$name" '
    BEGIN { IGNORECASE=1 }
    {
      line=$0
      sub(/\r$/, "", line)
      pos=index(line, ":")
      if (pos == 0) next
      key=substr(line,1,pos-1)
      value=substr(line,pos+1)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (tolower(key) == tolower(want)) print value
    }
  ' "$headers"
}

require_single_header() {
  local headers="$1" name="$2" expected="$3" values count
  values="$(header_values "$headers" "$name")"
  count="$(printf '%s\n' "$values" | awk 'NF{c++} END{print c+0}')"
  [[ "$count" -eq 1 ]] || fail "header $name count=$count"
  [[ "$values" == "$expected" ]] || fail "header $name mismatch: $values"
}

require_no_conflicting_header() {
  local headers="$1" name="$2" distinct
  distinct="$(header_values "$headers" "$name" | sort -u | awk 'NF{c++} END{print c+0}')"
  [[ "$distinct" -le 1 ]] || fail "conflicting duplicate $name values"
}

find_css_path() {
  local html css
  html="$(mktemp)"
  curl --noproxy '*' -fsS --max-time 15 "$LOOPBACK_ORIGIN/" -o "$html"
  css="$(grep -oE 'href=("/css/site\.min\.[0-9a-f]{96}\.css"|/css/site\.min\.[0-9a-f]{96}\.css)' "$html" |
    head -n1 | sed -E 's/^href="?([^" ]+)"?$/\1/' || true)"
  rm -f "$html"
  [[ "$css" =~ ^/css/site\.min\.[0-9a-f]{96}\.css$ ]] || fail "fingerprinted CSS path not found"
  printf '%s\n' "$css"
}

assert_git_exact() {
  [[ "$EUID" -eq 0 ]] || fail "run as root"
  local head branch remote
  head="$(git_cmd rev-parse HEAD)"
  branch="$(git_cmd branch --show-current)"
  remote="$(git_cmd rev-parse refs/remotes/origin/main 2>/dev/null || true)"
  [[ "$branch" == "main" ]] || fail "RPi5_main checkout is not main"
  [[ "$head" == "$EXPECTED_SHA" ]] || fail "RPi5_main HEAD mismatch"
  [[ "$remote" == "$EXPECTED_SHA" ]] || fail "origin/main mismatch"
  [[ -z "$(git_cmd status --porcelain=v1 --untracked-files=all)" ]] || fail "RPi5_main checkout is not clean"
  git_cmd merge-base --is-ancestor "$FAILED_OPERATOR_SHA" "$EXPECTED_SHA" || fail "failed V20 operator is not an ancestor"
  say "rpi5_main_sha=$head"
}

assert_image_and_sources() {
  [[ -f "$SRC_CONFIG" && -f "$SRC_UNIT" ]] || fail "reviewed V20 source files missing"
  [[ "$(docker image inspect "$EXPECTED_IMAGE" --format '{{.Id}}')" == "$EXPECTED_IMAGE" ]] || fail "retained Nginx image missing"
  grep -Fq 'public, max-age=31536000, immutable' "$SRC_CONFIG" || fail "immutable CSS policy missing"
  grep -Fq "script-src 'none'" "$SRC_CONFIG" || fail "strict CSP missing"
  grep -Fq -- '--pull=never' "$SRC_UNIT" || fail "unit lost --pull=never"
  say "source_config_sha=$(sha_of "$SRC_CONFIG")"
  say "source_unit_sha=$(sha_of "$SRC_UNIT")"
}

assert_cloudflared() {
  [[ "$(systemctl is-active cloudflared.service)" == "active" ]] || fail "cloudflared not active"
  [[ "$(systemctl is-enabled cloudflared.service)" == "enabled" ]] || fail "cloudflared not enabled"
  CURRENT_CF_PID="$(systemctl show cloudflared.service -p MainPID --value)"
  CURRENT_CF_HA="$(ha_value)" || fail "cloudflared HA unavailable"
  [[ "$CURRENT_CF_HA" == "4" ]] || fail "cloudflared HA drift"
  say "cloudflared_pid=$CURRENT_CF_PID"
  say "cloudflared_ha=$CURRENT_CF_HA"
}

assert_lan_blocked() {
  local rc
  if curl --noproxy '*' -fsS -o /dev/null --connect-timeout 2 --max-time 4 "$LAN_ORIGIN/"; then
    fail "direct LAN origin unexpectedly reachable"
  else
    rc=$?
    say "lan_direct_rc=$rc"
  fi
}

assert_base_health() {
  local label url code
  while IFS='|' read -r label url; do
    if [[ "$url" == "$PUBLIC_ORIGIN"* ]]; then
      code="$(curl -fsS -o /dev/null --max-time 20 -w '%{http_code}' "$url")" || fail "$label request failed"
    else
      code="$(curl --noproxy '*' -fsS -o /dev/null --max-time 15 -w '%{http_code}' "$url")" || fail "$label request failed"
    fi
    say "$label=$code"
    [[ "$code" == "200" ]] || fail "$label returned $code"
  done <<EOF
loopback_home|$LOOPBACK_ORIGIN/
loopback_digest|$LOOPBACK_ORIGIN$REPRESENTATIVE_PATH
loopback_rss|$LOOPBACK_ORIGIN$RSS_PATH
public_home|$PUBLIC_ORIGIN/
public_digest|$PUBLIC_ORIGIN$REPRESENTATIVE_PATH
public_rss|$PUBLIC_ORIGIN$RSS_PATH
EOF
  assert_lan_blocked
}

assert_container_common() {
  [[ "$(systemctl is-active "$SERVICE")" == "active" ]] || fail "$SERVICE not active"
  [[ "$(systemctl is-enabled "$SERVICE")" == "enabled" ]] || fail "$SERVICE not enabled"
  CURRENT_CONTAINER_ID="$(docker inspect "$CONTAINER" --format '{{.Id}}')" || fail "live container missing"
  [[ "$(docker inspect "$CONTAINER" --format '{{.Image}}')" == "$EXPECTED_IMAGE" ]] || fail "live image drift"
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.RestartPolicy.Name}}')" == "no" ]] || fail "Docker restart policy drift"
  [[ "$(docker port "$CONTAINER" 80/tcp)" == "$EXPECTED_PORT" ]] || fail "loopback publish drift"
  local public_mount logging
  public_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/usr/share/nginx/html"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  logging="$(docker inspect "$CONTAINER" --format '{{.HostConfig.LogConfig.Type}}|{{index .HostConfig.LogConfig.Config "max-size"}}|{{index .HostConfig.LogConfig.Config "max-file"}}')"
  [[ "$public_mount" == "$EXPECTED_PUBLIC_MOUNT" ]] || fail "public mount drift"
  [[ "$logging" == "json-file|10m|3" ]] || fail "logging drift"
  say "live_container_id=$CURRENT_CONTAINER_ID"
}

load_failed_state() {
  [[ -f "$STATE_FILE" && -f "$BACKUP_UNIT" ]] || fail "original V20 rollback evidence missing"
  # shellcheck disable=SC1090
  source "$STATE_FILE"
  [[ "${STATE_EXPECTED_SHA:-}" == "$FAILED_OPERATOR_SHA" ]] || fail "unexpected prior state SHA"
  [[ "${PHASE:-}" == "rolled_back" ]] || fail "prior V20 state is not rolled_back"
  [[ "${PRE_UNIT_SHA:-}" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "prior V14 unit SHA mismatch"
  [[ "$(sha_of "$BACKUP_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "retained V14 backup checksum drift"
  [[ "${SOURCE_CONFIG_SHA:-}" == "$(sha_of "$SRC_CONFIG")" ]] || fail "V20 source config changed since failed canary"
  [[ "${SOURCE_UNIT_SHA:-}" == "$(sha_of "$SRC_UNIT")" ]] || fail "V20 source unit changed since failed canary"
  EXPECTED_PRE_CF_PID="${PRE_CF_PID:-}"
  EXPECTED_PRE_CF_HA="${PRE_CF_HA:-}"
  [[ -n "$EXPECTED_PRE_CF_PID" && "$EXPECTED_PRE_CF_HA" == "4" ]] || fail "prior cloudflared evidence invalid"
}

assert_rolled_back_runtime() {
  assert_container_common
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "installed unit is not rolled-back V14"
  [[ -f "$INSTALLED_CONFIG" ]] || fail "installed V20 config missing after rollback"
  [[ "$(sha_of "$INSTALLED_CONFIG")" == "$(sha_of "$SRC_CONFIG")" ]] || fail "installed V20 config drift after rollback"
  local config_mount
  config_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/etc/nginx/conf.d/default.conf"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  [[ -z "$config_mount" ]] || fail "rolled-back live container still mounts V20 config"
}

assert_v20_runtime() {
  assert_container_common
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$(sha_of "$SRC_UNIT")" ]] || fail "installed V20 unit checksum drift"
  [[ "$(sha_of "$INSTALLED_CONFIG")" == "$(sha_of "$SRC_CONFIG")" ]] || fail "installed V20 config checksum drift"
  local config_mount
  config_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/etc/nginx/conf.d/default.conf"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  [[ "$config_mount" == "$EXPECTED_CONFIG_MOUNT" ]] || fail "V20 config mount drift"
}

assert_headers_for_origin() {
  local origin="$1" label="$2" css_path="$3" h_home h_rss h_css f
  h_home="$(mktemp)"; h_rss="$(mktemp)"; h_css="$(mktemp)"
  if [[ "$origin" == "$PUBLIC_ORIGIN" ]]; then
    curl -fsS -o /dev/null --max-time 20 -D "$h_home" "$origin/"
    curl -fsS -o /dev/null --max-time 20 -D "$h_rss" "$origin$RSS_PATH"
    curl -fsS -o /dev/null --max-time 20 -D "$h_css" "$origin$css_path"
  else
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_home" "$origin/"
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_rss" "$origin$RSS_PATH"
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_css" "$origin$css_path"
  fi
  for f in "$h_home" "$h_rss" "$h_css"; do
    require_no_conflicting_header "$f" "Cache-Control"
    require_no_conflicting_header "$f" "Content-Security-Policy"
    require_no_conflicting_header "$f" "X-Content-Type-Options"
    require_no_conflicting_header "$f" "Referrer-Policy"
    require_no_conflicting_header "$f" "Permissions-Policy"
  done
  require_single_header "$h_home" "Cache-Control" "no-cache"
  require_single_header "$h_rss" "Cache-Control" "no-cache"
  require_single_header "$h_css" "Cache-Control" "public, max-age=31536000, immutable"
  for f in "$h_home" "$h_rss" "$h_css"; do
    require_single_header "$f" "X-Content-Type-Options" "nosniff"
    require_single_header "$f" "Referrer-Policy" "strict-origin-when-cross-origin"
    require_single_header "$f" "Permissions-Policy" "$EXPECTED_PERMISSIONS"
    require_single_header "$f" "Content-Security-Policy" "$EXPECTED_CSP"
  done
  rm -f "$h_home" "$h_rss" "$h_css"
  say "${label}_headers=PASS"
}

assert_v20_headers() {
  local css_path
  css_path="$(find_css_path)"
  say "fingerprinted_css=$css_path"
  assert_headers_for_origin "$LOOPBACK_ORIGIN" loopback "$css_path"
  assert_headers_for_origin "$PUBLIC_ORIGIN" public "$css_path"
}

write_retry_state() {
  local phase="$1"
  install -d -o root -g root -m 0700 "$RETRY_DIR"
  cat >"$RETRY_STATE.tmp" <<EOF
EXPECTED_SHA=$EXPECTED_SHA
PHASE=$phase
PRE_CONTAINER_ID=$PRE_CONTAINER_ID
PRE_CF_PID=$EXPECTED_PRE_CF_PID
PRE_CF_HA=$EXPECTED_PRE_CF_HA
EOF
  chmod 0600 "$RETRY_STATE.tmp"
  chown root:root "$RETRY_STATE.tmp"
  mv -f "$RETRY_STATE.tmp" "$RETRY_STATE"
  touch "$RETRY_EVIDENCE"
  chmod 0600 "$RETRY_EVIDENCE"
  chown root:root "$RETRY_EVIDENCE"
  printf '%s phase=%s expected_sha=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$phase" "$EXPECTED_SHA" >>"$RETRY_EVIDENCE"
}

rollback() {
  say "V20 retry automatic rollback: BEGIN" >&2
  install -o root -g root -m 0644 "$BACKUP_UNIT" "$INSTALLED_UNIT"
  systemctl daemon-reload
  systemctl restart "$SERVICE"
  sleep 2
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || return 1
  assert_container_common || return 1
  local config_mount
  config_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/etc/nginx/conf.d/default.conf"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  [[ -z "$config_mount" ]] || return 1
  assert_base_health || return 1
  assert_cloudflared || return 1
  [[ "$CURRENT_CF_PID" == "$EXPECTED_PRE_CF_PID" && "$CURRENT_CF_HA" == "$EXPECTED_PRE_CF_HA" ]] || return 1
  write_retry_state rolled_back
  say "HERMES_TECH_V20_RETRY_AUTOMATIC_ROLLBACK=PASS" >&2
}

preflight() {
  assert_git_exact
  assert_image_and_sources
  load_failed_state
  assert_cloudflared
  [[ "$CURRENT_CF_PID" == "$EXPECTED_PRE_CF_PID" && "$CURRENT_CF_HA" == "$EXPECTED_PRE_CF_HA" ]] || fail "cloudflared changed since first install"
}

case "$MODE" in
  check)
    say "mode=check"
    preflight
    assert_rolled_back_runtime
    assert_base_health
    css="$(find_css_path)"
    say "fingerprinted_css=$css"
    say "HERMES_TECH_V20_RETRY_CHECK=PASS"
    ;;

  apply)
    say "mode=apply"
    preflight
    assert_rolled_back_runtime
    assert_base_health
    PRE_CONTAINER_ID="$CURRENT_CONTAINER_ID"
    install -o root -g root -m 0644 "$SRC_CONFIG" "$INSTALLED_CONFIG"
    install -o root -g root -m 0644 "$SRC_UNIT" "$INSTALLED_UNIT"
    systemd-analyze verify "$INSTALLED_UNIT" >/dev/null
    systemctl daemon-reload
    write_retry_state installed
    if ! systemctl restart "$SERVICE"; then
      rollback || fail "service restart failed and rollback failed"
      fail "service restart failed; rollback passed"
    fi
    sleep 2
    if ! (assert_v20_runtime && [[ "$CURRENT_CONTAINER_ID" != "$PRE_CONTAINER_ID" ]] && assert_base_health && assert_v20_headers && assert_cloudflared && [[ "$CURRENT_CF_PID" == "$EXPECTED_PRE_CF_PID" && "$CURRENT_CF_HA" == "$EXPECTED_PRE_CF_HA" ]]); then
      rollback || fail "canary assertion failed and rollback failed"
      fail "canary assertion failed; rollback passed"
    fi
    write_retry_state canary_passed
    say "HERMES_TECH_V20_RETRY_APPLY=PASS"
    ;;

  verify)
    say "mode=verify"
    preflight
    [[ -f "$RETRY_STATE" ]] || fail "retry state missing"
    # shellcheck disable=SC1090
    source "$RETRY_STATE"
    [[ "${EXPECTED_SHA:-}" == "$(git_cmd rev-parse HEAD)" ]] || fail "retry state SHA mismatch"
    [[ "${PHASE:-}" == "canary_passed" ]] || fail "verify requires successful retry apply"
    assert_v20_runtime
    assert_base_health
    assert_v20_headers
    assert_cloudflared
    [[ "$CURRENT_CF_PID" == "$EXPECTED_PRE_CF_PID" && "$CURRENT_CF_HA" == "$EXPECTED_PRE_CF_HA" ]] || fail "cloudflared drift after retry"
    say "HERMES_TECH_V20_RETRY_VERIFY=PASS"
    ;;
esac
