# Canonical registries are deployed by coloring-pages. No fallback to static ADMIN labels.
TAXONOMY_URLS = {"categories": ORIGIN + "/categories.json", "topics": ORIGIN + "/topics.json"}
TAXONOMY_SCHEMAS = {
    "categories": "rozkalns.coloring-pages.categories.v1",
    "topics": "rozkalns.coloring-pages.topics.v1",
}
TAXONOMY_MAX_BYTES = 65536


class NoTaxonomyRedirect(HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, message, headers, url):
        return None


def load_taxonomy() -> dict:
    """Fetch exactly the active public registries; fail closed on absence/drift."""
    output, digests = {}, []
    for name, url in TAXONOMY_URLS.items():
        try:
            request = Request(url, headers={"Accept": "application/json", "Cache-Control": "no-store"})
            with build_opener(NoTaxonomyRedirect).open(request, timeout=5) as response:
                if response.status != 200 or response.geturl() != url:
                    stop("public taxonomy origin is invalid")
                data = response.read(TAXONOMY_MAX_BYTES + 1)
        except Stop:
            raise
        except Exception:
            stop("public taxonomy unavailable")
        if not data or len(data) > TAXONOMY_MAX_BYTES:
            stop("public taxonomy size invalid")
        try:
            registry = json.loads(data)
        except (UnicodeError, ValueError):
            stop("public taxonomy JSON invalid")
        if not isinstance(registry, dict) or registry.get("schema") != TAXONOMY_SCHEMAS[name]:
            stop("public taxonomy schema invalid")
        rows = registry.get(name)
        if not isinstance(rows, list) or not 0 < len(rows) <= 128:
            stop("public taxonomy list invalid")
        result = {}
        for row in rows:
            if not isinstance(row, dict):
                stop("public taxonomy entry invalid")
            ident, label = row.get("id"), row.get("label")
            if (not isinstance(ident, str) or not CATALOG_ID.fullmatch(ident) or len(ident) > 48 or
                not isinstance(label, str) or not 1 <= len(label.strip()) <= 80 or ident in result):
                stop("public taxonomy entry invalid")
            if name == "topics" and row.get("kind") not in {"seasonal", "evergreen"}:
                stop("public topic kind invalid")
            result[ident] = {"id": ident, "label": label.strip(),
                             **({"kind": row["kind"]} if name == "topics" else {})}
        output[name] = result
        digests.append(hashlib.sha256(data).hexdigest())
    output["version"] = hashlib.sha256(":".join(digests).encode("ascii")).hexdigest()
    return output
