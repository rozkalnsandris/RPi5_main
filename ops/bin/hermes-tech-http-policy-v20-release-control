#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

MODE="${1:-check}"
shift || true

EXPECTED_SHA=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --expected-sha)
      [[ $# -ge 2 ]] || { echo "missing value for --expected-sha" >&2; exit 64; }
      EXPECTED_SHA="$2"
      shift 2
      ;;
    *)
      echo "usage: $0 [check|apply|verify] --expected-sha <40-hex-sha>" >&2
      exit 64
      ;;
  esac
done

case "$MODE" in
  check|apply|verify) ;;
  *) echo "usage: $0 [check|apply|verify] --expected-sha <40-hex-sha>" >&2; exit 64 ;;
esac

[[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]] || {
  echo "Hermes Tech V20 release-control: FAIL: exact --expected-sha is required" >&2
  exit 64
}

[[ "$EUID" -eq 0 ]] || {
  echo "Hermes Tech V20 release-control: FAIL: run as root" >&2
  exit 1
}

REPOSITORY='rozkalnsandris/RPi5_main'
REMOTE_URL="https://github.com/${REPOSITORY}.git"
API_ROOT='https://api.github.com'
VALIDATE_WORKFLOW='validate.yml'
RETRY_MERGE_SHA='cef02401b54f8cc8ce7f3957d95ea82fb859477f'
RETRY_OPERATOR_PATH='ops/bin/hermes-tech-http-policy-v20-retry'
RETRY_OPERATOR_BLOB='97a880d4e196d160bb57b8bd6128bc511c2e2597'
TMP_PARENT="${TMPDIR:-/var/tmp}"
RELEASE_ROOT=''
RELEASE_REPO=''

say() { printf '%s\n' "$*"; }
fail() { say "Hermes Tech V20 release-control: FAIL: $*" >&2; exit 1; }

cleanup() {
  if [[ -n "$RELEASE_ROOT" && -d "$RELEASE_ROOT" ]]; then
    rm -rf --one-file-system -- "$RELEASE_ROOT"
  fi
}
trap cleanup EXIT HUP INT TERM

for command_name in curl git mktemp python3 rm; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name"
done
[[ -d "$TMP_PARENT" && ! -L "$TMP_PARENT" ]] || fail "temporary parent is missing or unsafe"

remote_main="$(git ls-remote --exit-code "$REMOTE_URL" refs/heads/main | awk 'NR == 1 {print $1}')" ||
  fail "cannot resolve public origin/main"
[[ "$remote_main" =~ ^[0-9a-f]{40}$ ]] || fail "origin/main SHA is invalid"
[[ "$remote_main" == "$EXPECTED_SHA" ]] ||
  fail "origin/main moved: expected=$EXPECTED_SHA actual=$remote_main"
say "origin_main_sha=$remote_main"

runs_json="$(curl -fsS --max-time 20 \
  -H 'Accept: application/vnd.github+json' \
  -H 'X-GitHub-Api-Version: 2022-11-28' \
  -H 'User-Agent: rpi5-main-v20-release-control' \
  "$API_ROOT/repos/$REPOSITORY/actions/workflows/$VALIDATE_WORKFLOW/runs?branch=main&head_sha=$EXPECTED_SHA&status=completed&per_page=100")" ||
  fail "cannot query exact-SHA GitHub validation"

ci_run_id="$(python3 -c '
import json, sys
sha = sys.argv[1]
data = json.load(sys.stdin)
runs = [
    row for row in data.get("workflow_runs", [])
    if row.get("event") == "push"
    and row.get("head_branch") == "main"
    and row.get("head_sha") == sha
    and row.get("status") == "completed"
    and row.get("conclusion") == "success"
]
print(max((int(row["id"]) for row in runs), default=""))
' "$EXPECTED_SHA" <<<"$runs_json")"
[[ "$ci_run_id" =~ ^[0-9]+$ ]] || fail "exact main SHA has no successful GitHub-hosted Validate push run"

jobs_json="$(curl -fsS --max-time 20 \
  -H 'Accept: application/vnd.github+json' \
  -H 'X-GitHub-Api-Version: 2022-11-28' \
  -H 'User-Agent: rpi5-main-v20-release-control' \
  "$API_ROOT/repos/$REPOSITORY/actions/runs/$ci_run_id/jobs?filter=latest&per_page=100")" ||
  fail "cannot query exact-SHA GitHub validation jobs"

python3 -c '
import json, sys
jobs = json.load(sys.stdin).get("jobs", [])
validate = [row for row in jobs if row.get("name") == "validate"]
if len(validate) != 1:
    raise SystemExit(f"expected exactly one validate job, observed={len(validate)}")
job = validate[0]
if job.get("status") != "completed" or job.get("conclusion") != "success":
    raise SystemExit("validate job is not completed/success")
' <<<"$jobs_json" || fail "exact-SHA Validate run lacks one successful validate job"
say "github_validate_run=$ci_run_id"

RELEASE_ROOT="$(mktemp -d -p "$TMP_PARENT" rpi5-v20-release-control.XXXXXX)"
chmod 0700 "$RELEASE_ROOT"
RELEASE_REPO="$RELEASE_ROOT/repo"

git clone --quiet --no-tags --single-branch --branch main "$REMOTE_URL" "$RELEASE_REPO" ||
  fail "ephemeral release-control clone failed"

head_sha="$(git -C "$RELEASE_REPO" rev-parse HEAD)"
remote_sha="$(git -C "$RELEASE_REPO" rev-parse refs/remotes/origin/main)"
branch="$(git -C "$RELEASE_REPO" branch --show-current)"
[[ "$branch" == 'main' ]] || fail "ephemeral checkout is not main"
[[ "$head_sha" == "$EXPECTED_SHA" ]] || fail "ephemeral HEAD mismatch"
[[ "$remote_sha" == "$EXPECTED_SHA" ]] || fail "ephemeral origin/main mismatch"
[[ -z "$(git -C "$RELEASE_REPO" status --porcelain=v1 --untracked-files=all)" ]] ||
  fail "ephemeral release-control checkout is not clean"

git -C "$RELEASE_REPO" merge-base --is-ancestor "$RETRY_MERGE_SHA" "$EXPECTED_SHA" ||
  fail "reviewed V20 retry merge is not an ancestor of expected SHA"
operator_blob="$(git -C "$RELEASE_REPO" rev-parse "$EXPECTED_SHA:$RETRY_OPERATOR_PATH")" ||
  fail "reviewed V20 retry operator is missing"
[[ "$operator_blob" == "$RETRY_OPERATOR_BLOB" ]] ||
  fail "V20 retry operator changed after the reviewed recovery merge"

operator="$RELEASE_REPO/$RETRY_OPERATOR_PATH"
[[ -x "$operator" && ! -L "$operator" ]] || fail "reviewed V20 retry operator is not executable/safe"

say "release_control_sha=$head_sha"
say "reviewed_retry_operator_blob=$operator_blob"
say "normal_checkout_mutated=false"
say "delegated_mode=$MODE"

(
  cd "$RELEASE_REPO"
  "$operator" "$MODE" --expected-sha "$EXPECTED_SHA"
)

say "HERMES_TECH_V20_RELEASE_CONTROL=PASS"
say "MODE=$MODE"
say "SOURCE_SHA=$EXPECTED_SHA"
say "EPHEMERAL_CHECKOUT_CLEANUP=armed"
