#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C
export LANG=C
export GIT_OPTIONAL_LOCKS=0

readonly SERVICE="balkons-bot.service"
readonly SELF_REL="ops/bin/balkons-bot-send-sigkill-verifier"
readonly PREFLIGHT_REL="ops/bin/balkons-bot-preflight"
readonly DROPIN_REL="ops/systemd/balkons-bot-no-sigkill.conf"
readonly DROPIN_DIR="/etc/systemd/system/${SERVICE}.d"
readonly DROPIN_TARGET="${DROPIN_DIR}/90-rpi5-no-sigkill.conf"
readonly CANONICAL_H3_LIVE_SOURCE_SHA256="54e7c58bae49a4a78fc033bd86eaa752cf21583bb86a0ba10d7ba9a617b1afd9"

MODE=""
MODE_COUNT=0
EXPECTED_REPO_SHA=""
EXPECTED_CHECKOUT_FINGERPRINT=""
EXPECTED_VERIFIER_SHA256=""
EXPECTED_PREFLIGHT_SHA256=""
EXPECTED_DROPIN_SHA256=""
EXPECTED_LIVE_SOURCE_SHA256="$CANONICAL_H3_LIVE_SOURCE_SHA256"

usage() {
  cat <<'EOF'
Usage: balkons-bot-send-sigkill-verifier MODE BINDINGS

Modes (choose exactly one):
  --check      Require the exact K7 baseline: target absent and sole blocker SendSIGKILL=yes.
  --verify     Require exact reviewed target bytes and a full existing preflight PASS.

Required bindings:
  --expected-repo-sha SHA1
  --expected-checkout-fingerprint SHA256
  --expected-verifier-sha256 SHA256
  --expected-preflight-sha256 SHA256
  --expected-dropin-sha256 SHA256

Optional binding:
  --expected-live-source-sha256 SHA256

This artifact is read-only. It must run as the non-root owner of the trusted checkout.
It performs no install/remove, daemon-reload, service lifecycle action, credential/MQTT/
Docker/package/network/storage/backup/Home Assistant/ESP32/pump mutation, or rollback.
EOF
}

while (($#)); do
  case "$1" in
    --check|--verify)
      MODE="${1#--}"
      MODE_COUNT=$((MODE_COUNT + 1))
      shift
      ;;
    --expected-repo-sha)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_REPO_SHA="$2"
      shift 2
      ;;
    --expected-checkout-fingerprint)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_CHECKOUT_FINGERPRINT="$2"
      shift 2
      ;;
    --expected-verifier-sha256)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_VERIFIER_SHA256="$2"
      shift 2
      ;;
    --expected-preflight-sha256)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_PREFLIGHT_SHA256="$2"
      shift 2
      ;;
    --expected-dropin-sha256)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_DROPIN_SHA256="$2"
      shift 2
      ;;
    --expected-live-source-sha256)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      EXPECTED_LIVE_SOURCE_SHA256="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

block() {
  printf 'RESULT=BLOCKED\n'
  printf 'BLOCK_REASON=%s\n' "$1"
  printf 'MUTATION_STARTED=NO\n'
  printf 'WRITES_PERFORMED=NO\n'
  exit "${2:-2}"
}

[[ "$MODE_COUNT" -eq 1 ]] || block "mode_must_be_explicit_and_unique"

is_sha1() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

is_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

sha256_file() {
  sha256sum "$1" | awk '{print $1}'
}

sha256_text() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

for required in \
  "$EXPECTED_REPO_SHA" \
  "$EXPECTED_CHECKOUT_FINGERPRINT" \
  "$EXPECTED_VERIFIER_SHA256" \
  "$EXPECTED_PREFLIGHT_SHA256" \
  "$EXPECTED_DROPIN_SHA256" \
  "$EXPECTED_LIVE_SOURCE_SHA256"; do
  [[ -n "$required" ]] || block "missing_binding"
done
is_sha1 "$EXPECTED_REPO_SHA" || block "expected_repo_sha_invalid"
for digest in \
  "$EXPECTED_CHECKOUT_FINGERPRINT" \
  "$EXPECTED_VERIFIER_SHA256" \
  "$EXPECTED_PREFLIGHT_SHA256" \
  "$EXPECTED_DROPIN_SHA256" \
  "$EXPECTED_LIVE_SOURCE_SHA256"; do
  is_sha256 "$digest" || block "expected_sha256_invalid"
done

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
readonly repo
readonly SELF_PATH="$repo/$SELF_REL"
readonly PREFLIGHT_PATH="$repo/$PREFLIGHT_REL"
readonly DROPIN_SOURCE="$repo/$DROPIN_REL"

repo_uid="$(stat -c '%u' "$repo" 2>/dev/null || true)"
current_uid="$(id -u)"
[[ "$repo_uid" =~ ^[0-9]+$ ]] || block "checkout_owner_uid_unreadable"
[[ "$repo_uid" != "0" ]] || block "checkout_owner_must_be_nonroot"
[[ "$current_uid" == "$repo_uid" ]] || block "must_run_as_checkout_owner"

[[ "$(sha256_text "$repo")" == "$EXPECTED_CHECKOUT_FINGERPRINT" ]] || block "checkout_fingerprint_mismatch"
observed_head="$(git -C "$repo" rev-parse HEAD 2>/dev/null)" || block "repo_head_unreadable"
[[ "$observed_head" == "$EXPECTED_REPO_SHA" ]] || block "repo_head_mismatch"
observed_branch="$(git -C "$repo" branch --show-current 2>/dev/null)" || block "repo_branch_unreadable"
[[ "$observed_branch" == "main" ]] || block "repo_branch_not_main"

[[ -f "$SELF_PATH" && ! -L "$SELF_PATH" ]] || block "verifier_missing_or_symlink"
[[ -f "$PREFLIGHT_PATH" && ! -L "$PREFLIGHT_PATH" ]] || block "preflight_missing_or_symlink"
[[ -f "$DROPIN_SOURCE" && ! -L "$DROPIN_SOURCE" ]] || block "dropin_source_missing_or_symlink"
[[ "$(sha256_file "$SELF_PATH")" == "$EXPECTED_VERIFIER_SHA256" ]] || block "verifier_hash_mismatch"
[[ "$(sha256_file "$PREFLIGHT_PATH")" == "$EXPECTED_PREFLIGHT_SHA256" ]] || block "preflight_hash_mismatch"
[[ "$(sha256_file "$DROPIN_SOURCE")" == "$EXPECTED_DROPIN_SHA256" ]] || block "dropin_source_hash_mismatch"

tracked_count="$(git -C "$repo" ls-files --stage -- "$SELF_REL" "$PREFLIGHT_REL" "$DROPIN_REL" 2>/dev/null | wc -l)" || block "required_paths_tracking_unreadable"
[[ "$tracked_count" -eq 3 ]] || block "required_paths_not_tracked"
required_status="$(git -C "$repo" status --porcelain -- "$SELF_REL" "$PREFLIGHT_REL" "$DROPIN_REL" 2>/dev/null)" || block "required_paths_status_unreadable"
[[ -z "$required_status" ]] || block "required_paths_dirty"

validate_dropin_dir_if_present() {
  if [[ -e "$DROPIN_DIR" || -L "$DROPIN_DIR" ]]; then
    [[ -d "$DROPIN_DIR" && ! -L "$DROPIN_DIR" ]] || block "dropin_dir_unsafe"
    dir_uid="$(stat -c '%u' "$DROPIN_DIR" 2>/dev/null || true)"
    dir_mode="$(stat -c '%a' "$DROPIN_DIR" 2>/dev/null || true)"
    [[ "$dir_uid" == "0" && "$dir_mode" =~ ^[0-7]{3,4}$ ]] || block "dropin_dir_metadata_unsafe"
    (( (8#$dir_mode & 022) == 0 )) || block "dropin_dir_writable_by_nonroot"
  fi
}

PF_JSON=""
PF_RC=0
PF_STATE=""
PF_BLOCKERS=""
PF_SEND_SIGKILL=""
PF_LIVE_MATCH=""
PF_MUTATION_STARTED=""
PF_WRITES_PERFORMED=""

run_preflight() {
  set +e
  PF_JSON="$(
    "$PREFLIGHT_PATH" \
      --expected-repo-sha "$EXPECTED_REPO_SHA" \
      --expected-live-source-sha256 "$EXPECTED_LIVE_SOURCE_SHA256" \
      2>/dev/null
  )"
  PF_RC=$?
  set -e

  [[ "$PF_RC" -eq 0 || "$PF_RC" -eq 2 ]] || block "preflight_execution_error" "$PF_RC"

  parsed="$(printf '%s' "$PF_JSON" | python3 -I -c '
import json, sys
try:
    d = json.load(sys.stdin)
    md = d.get("service_metadata") or {}
    blockers = d.get("blockers")
    if not isinstance(blockers, list) or not all(isinstance(x, str) for x in blockers):
        raise ValueError
    fields = [
        d.get("preflight"),
        ",".join(blockers),
        md.get("send_sigkill", ""),
        str(d.get("live_source_provenance_match", "")).lower(),
        str(d.get("mutation_started", "")).lower(),
        str(d.get("writes_performed", "")).lower(),
    ]
    if not all(isinstance(x, str) for x in fields) or any("|" in x for x in fields):
        raise ValueError
    print("|".join(fields))
except Exception:
    raise SystemExit(2)
' 2>/dev/null)" || block "preflight_json_invalid"

  IFS='|' read -r \
    PF_STATE PF_BLOCKERS PF_SEND_SIGKILL PF_LIVE_MATCH PF_MUTATION_STARTED PF_WRITES_PERFORMED \
    <<<"$parsed"

  [[ "$PF_LIVE_MATCH" == "true" ]] || block "live_source_provenance_not_confirmed"
  [[ "$PF_MUTATION_STARTED" == "false" ]] || block "preflight_reported_mutation"
  [[ "$PF_WRITES_PERFORMED" == "false" ]] || block "preflight_reported_write"
}

emit_preflight() {
  printf 'PREFLIGHT_JSON=%s\n' "$PF_JSON"
}

case "$MODE" in
  check)
    validate_dropin_dir_if_present
    [[ ! -e "$DROPIN_TARGET" && ! -L "$DROPIN_TARGET" ]] || block "dropin_target_already_exists"
    run_preflight
    [[ "$PF_RC" -eq 2 ]] || block "expected_blocked_preflight_exit_missing"
    [[ "$PF_STATE" == "BLOCKED" ]] || block "expected_blocked_preflight_state_missing"
    [[ "$PF_BLOCKERS" == "send_sigkill_not_disabled" ]] || block "unexpected_preflight_blockers"
    [[ "$PF_SEND_SIGKILL" == "yes" ]] || block "unexpected_send_sigkill_baseline"
    emit_preflight
    printf 'RESULT=READY\nMUTATION_STARTED=NO\nWRITES_PERFORMED=NO\n'
    ;;

  verify)
    validate_dropin_dir_if_present
    [[ -f "$DROPIN_TARGET" && ! -L "$DROPIN_TARGET" ]] || block "dropin_target_missing_or_symlink"
    target_uid="$(stat -c '%u' "$DROPIN_TARGET" 2>/dev/null || true)"
    target_mode="$(stat -c '%a' "$DROPIN_TARGET" 2>/dev/null || true)"
    [[ "$target_uid" == "0" ]] || block "dropin_target_not_root_owned"
    [[ "$target_mode" == "644" || "$target_mode" == "0644" ]] || block "dropin_target_mode_invalid"
    target_sha256="$(sha256_file "$DROPIN_TARGET" 2>/dev/null)" || block "dropin_target_hash_unreadable"
    [[ "$target_sha256" == "$EXPECTED_DROPIN_SHA256" ]] || block "installed_dropin_hash_mismatch"

    run_preflight
    [[ "$PF_RC" -eq 0 ]] || block "post_change_preflight_not_pass"
    [[ "$PF_STATE" == "PASS" ]] || block "post_change_preflight_not_pass"
    [[ -z "$PF_BLOCKERS" ]] || block "post_change_preflight_has_blockers"
    [[ "$PF_SEND_SIGKILL" == "no" ]] || block "send_sigkill_not_effective"
    emit_preflight
    printf 'INSTALLED_DROPIN_SHA256=%s\n' "$target_sha256"
    printf 'RESULT=PASS\nMUTATION_STARTED=NO\nWRITES_PERFORMED=NO\n'
    ;;
esac
