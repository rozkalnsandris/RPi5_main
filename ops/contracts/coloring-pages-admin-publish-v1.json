      "HTTP headers",
      "cookies",
      "Cloudflare Access identity or tokens",
      "credentials or secrets",
      "environment variables",
      "ZIP or PNG bytes",
      "raw file contents",
      "wholesale subprocess stdout or stderr",
      "unsanitized traceback"
    ],
    "initialization": "fail-closed-before-publication-job-can-start",
    "global_journald_retention_change": false,
    "activity_api": {
      "endpoint": "GET /api/activity",
      "max_events": 200,
      "max_single_log_bytes": 2097152,
      "max_total_log_bytes": 4194304,
      "retention_source": "existing-seven-day-admin-diagnostic-logs",
      "response": "sanitized-allowlisted-fields-only",
      "unexpected_record": "fail-closed",
      "raw_log_lines": false,
      "log_mutation": false
    }
  },
  "maintenance": {
    "full_install_guard": "when service is active, acquire shared publication lock and require GET /api/jobs/active to report idle before first installed-file mutation",
    "active_or_unknown": "fail-closed-no-install-no-restart",
    "ui_only_mode": "replace static ADMIN index only; requires active service and verified installed fonts; no daemon-reload or service restart",
    "automatic_retry": false,
    "automatic_rollback": false,
    "automatic_cleanup": false,
    "post_restart_readiness": {
      "endpoint": "http://127.0.0.1:8765/",
      "attempts": 10,
      "per_attempt_timeout_seconds": 0.25,
      "interval_seconds": 0.25,
      "max_window_seconds": 4.75,
      "failure": "terminal-no-second-restart-or-installer-retry"
    }
  },
  "catalog_management": {
    "issue": 1172,
    "read_endpoint": "GET /api/catalog",
    "validator": "strong-sha256-etag",
    "write_precondition": "If-Match-required",
    "edit_endpoint": "POST /api/catalog/edit",
