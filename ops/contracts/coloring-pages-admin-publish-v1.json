      "confirmation": "exact-id",
      "state_directory": "/srv/coloring-pages-content/state/admin-publish/archive",
      "directory_mode": "0700",
      "record_mode": "0600",
      "schema": "rozkalns.rpi5-main.coloring-pages-admin-archive.v1",
      "transition": [
        "prepared",
        "archived",
        "restored",
        "delete-prepared",
        "deleted"
      ],
      "persist_before_catalog_removal": true,
      "prepared_plus_live_absent_is_restorable": true,
      "duplicate_record": "fail-closed",
      "media_deleted": false,
      "originals_deleted": false,
      "inbox_deleted": false,
      "drive_deleted": false,
      "deleted_tombstone_retained": true,
      "deleted_tombstone_hidden_from_normal_archive_list": true,
      "delete_prepared_manual_review_only": true
