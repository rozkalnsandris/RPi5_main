    "code_pattern": "^E_[A-Z0-9_]{1,62}$",
    "fallback": "UNKNOWN",
    "source_provenance_only": true,
    "forbidden": [
      "provider-message",
      "stack",
      "request-payload",
      "activity-id",
      "page",
      "reason",
      "sender",
      "destination",
      "headers",
      "ip",
      "url"
