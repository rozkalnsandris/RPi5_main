[Unit]
Description=RPi5 weekly maintenance update
Documentation=https://github.com/rozkalnsandris/RPi5_main
Wants=network-online.target
After=network-online.target docker.service
OnFailure=rpi5-maintenance-notify@%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rpi5-update
TimeoutStartSec=2h
Restart=no
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
