{
  "schema_version": 3,
  "repository": "rozkalnsandris/RPi5_main",
  "default_continuation_mode": "FAST-LANE v2.2",
  "github_api_access": {
    "manifest": ".github/github-api-access-v1.json",
    "shared_revision": "3bb0740b5f0a8ce631d2ff79f1acc4999ff6ed2c",
    "rule": "For START, SYNC, turpini and PR continuation, apply the GitHub API access manifest: serial minimum-sufficient reads, changed-file inspection on demand, no tight polling, compact exact-head pre-mutation evidence, fail-closed reconciliation after ambiguous writes, never duplicate a mutation after dispatch ambiguity, and use exact-main minimal reconciliation after confirmed success. Repository-local stricter authority remains unchanged."
  },
  "visual_verification": {
    "policy": "docs/VISUAL_VERIFICATION.md",
    "default_host_tool": "~/.local/bin/ui-proof",
    "engine": "playwright-system-chromium",
    "desktop_viewport": "1440x900",
    "mobile_model": "SM-A556B",
    "mobile_viewport": "412x892",
    "inspection_bridge": "RDC_IMAGE_READ",
    "rule": "When pixel-level visual inspection of an RPi5-hosted web UI is needed, read docs/VISUAL_VERIFICATION.md and use ui-proof by default; raw Chromium CLI is not the standard path. Runtime execution still requires applicable current LIVE authority."
  },
  "lane_roles": {
    "FAST-LANE v2.2": "SAFE_DISCOVERY_AUDIT_AND_NON_FULL_CONTINUATION",
    "AUTO-RUN-FULL": "NORMAL_ISSUE_SCOPED_IMPLEMENTATION"
  },
  "explicit_modes": {
    "GITHUB-ONLY": {
      "requires_explicit_current_command_token": true,
      "accepted_tokens": ["GITHUB-ONLY", "git hub only"],
      "may_be_inferred_from_context": false
    },
    "LIVE-ALL": {
      "requires_explicit_current_command_token": true,
      "accepted_tokens": ["LIVE-ALL"],
      "may_be_inferred_from_context": false
    },
    "AUTO-RUN-FULL": {
      "canonical_prefix": "AUTO-RUN FULL",
      "requires_explicit_current_command_token": true,
      "accepted_tokens": ["AUTO-RUN FULL"],
      "requires_repository_argument": "RPi5_main",
      "requires_issue_argument": true,
      "issue_argument_pattern": "^#[1-9][0-9]*$",
      "policy": ".github/auto-run-full-v2.json",
      "controller_issue": 295,
      "preferred_resume": "GITHUB_EVENT_TRIGGERED_WORK",
      "fallback_resume": "HOURLY_SCHEDULED_WATCHDOG",
      "preferred_merge": "GITHUB_AUTO_MERGE_AFTER_FINAL_EXACT_HEAD_READINESS",
      "may_be_inferred_from_context": false
    }
  },
  "bare_continuation_commands": ["START", "START RPi5_main", "SYNC RPi5_main", "turpini"],
  "bare_continuation_result": "FAST-LANE v2.2",
  "forbidden_mode_inference_sources": [
    ".github/start-github-only.json existence",
    "deploy-queue state",
    "handoff or issue continuity",
    "executor availability or unavailability",
    "historical chat mode",
    "prior authorization receipt",
    "AUTO-RUN controller state without a fresh explicit activation command",
    "prior AUTO-RUN authorization receipt"
  ],
  "examples": {
    "START RPi5_main": "FAST-LANE v2.2",
    "SYNC RPi5_main": "FAST-LANE v2.2",
    "turpini": "FAST-LANE v2.2",
    "START RPi5_main GITHUB-ONLY": "GITHUB-ONLY",
    "GITHUB-ONLY": "GITHUB-ONLY",
    "LIVE-ALL": "LIVE-ALL",
    "AUTO-RUN FULL RPi5_main #301": "AUTO-RUN-FULL"
  }
}
