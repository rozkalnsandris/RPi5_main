    "cloudflare_request": false,
    "credential_or_secret_access": false,
    "host_install": false,
    "merge": false,
    "live": false,
    "retry": false,
    "rollback": false,
    "cleanup": false
  },
  "launcher": {
    "future_fixed_deploy_capability": true,
    "verifies_exact_checkout_before_dispatch": true,
    "requires_report_secrets": false,
    "stats_dependency": false,
