#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

TRUSTED_ROOT = Path(
    "/var/lib/rpi5-deploy/RPi5_main-weathernext-private-installer-trusted"
)
LIB = TRUSTED_ROOT / "ops" / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from deploy_executor.weather_private_privileged_dispatch import (  # noqa: E402
    WeatherNextPrivatePrivilegedDispatchError,
    run_privileged_request,
)


def _issue_number(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("issue number must be an integer") from exc
    if not 1 <= parsed <= 2_147_483_647:
        raise argparse.ArgumentTypeError("issue number must be positive")
    return parsed


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Execute one canonical WeatherNext private privileged request."
    )
    parser.add_argument("--issue-number", type=_issue_number, required=True)
    args = parser.parse_args(argv)
    try:
        receipt = run_privileged_request(args.issue_number)
    except WeatherNextPrivatePrivilegedDispatchError as exc:
        print(
            json.dumps(
                {
                    "status": "STOP",
                    "reason": str(exc),
                    "production_mutation_started": "unknown_after_boundary_entry",
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 1
    except Exception:
        print(
            json.dumps(
                {
                    "status": "STOP",
                    "reason": "WeatherNext private privileged dispatch failed closed",
                    "production_mutation_started": "unknown_after_boundary_entry",
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 1
    print(json.dumps(dict(receipt), sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
