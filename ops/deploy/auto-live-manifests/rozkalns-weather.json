{
  "schema_version": 1,
  "schema": "rozkalns.auto-live-repository-manifest.v1",
  "manifest_id": "rozkalns-weather.public-runtime-release.v1",
  "source_repository": "rozkalnsandris/rozkalns_weather",
  "target_alias": "rozkalns-weather-public-rpi5",
  "static_operation_id": "rozkalns-weather.public-runtime-release.v1",
  "shared_policy_commit_sha": "f2aeb5152371a876268bb116bb98806cddbc8e15",
  "activation": {
    "state": "INACTIVE_SOURCE_ONLY",
    "automatic_mutation_enabled": false,
    "first_activation_requires_separate_owner_live_authorization": true
  },
  "classifier": {
    "kind": "ORDERED_PATH_RULES_V1",
    "range": "FULL_PRODUCTION_BASELINE_TO_TARGET",
    "latest_commit_only": false,
    "precedence": [
      "DB_HOST_APPLY_REQUIRED",
      "MANUAL_ROLLOUT_REQUIRED",
      "NO_DEPLOY"
    ],
    "rules": {
      "NO_DEPLOY": {
        "exact_paths": [
          "README.md",
          "AGENTS.md",
          ".github/pull_request_template.md"
        ],
        "path_prefixes": [
          "docs/",
          "tests/"
        ]
      },
      "MANUAL_ROLLOUT_REQUIRED": {
        "exact_paths": [
          ".dockerignore",
          "pyproject.toml"
        ],
        "path_prefixes": [
          "src/"
        ]
      },
      "DB_HOST_APPLY_REQUIRED": {
        "exact_paths": [
          ".env.example",
          "Dockerfile"
        ],
        "path_prefixes": [
          ".github/workflows/",
          "deploy/"
        ]
      }
    },
    "unmatched_path_result": "BLOCKED",
    "mixed_range_result": "HIGHEST_PRECEDENCE_MATCH"
  },
  "required_ci": {
    "exact_target_sha_required": true,
    "workflow_path": ".github/workflows/tests.yml",
    "workflow_name": "Backend tests",
    "required_gate": "pytest",
    "required_conclusion": "success"
  },
  "automatic_eligibility": {
    "eligible_classes": [],
    "static_operation_must_also_be_auto_live_eligible": true,
    "owner_required_classes": [
      "MANUAL_ROLLOUT_REQUIRED",
      "DB_HOST_APPLY_REQUIRED"
    ],
    "no_deploy_is_reconciliation_only": true
  },
  "baseline": {
    "resolver_id": "rozkalns-weather.public-runtime-baseline.v1",
    "must_match_static_operation": true,
    "production_baseline_to_target_reclassification_required": true
  },
  "health_postconditions": [
    "exact authorized source SHA is the deployed application identity",
    "readiness endpoint /ready reports ready without exposing coordinates or credentials",
    "persistent corpus volume is retained across application replacement",
    "WeatherNext remains optional until separately activated",
    "public ingest scheduling remains independent of WeatherNext scheduling"
  ],
  "failure_policy": {
    "rollback_policy": "NONE",
    "automatic_retry_after_mutation_start": false,
    "automatic_cleanup_after_mutation_start": false,
    "automatic_rollback_after_mutation_start": false,
    "alternate_mutation_path_after_mutation_start": false
  },
  "sensitive_exclusions": [
    "arbitrary command, path, argv or environment authority",
    "credentials, HOME_LAT, HOME_LON or exact home coordinates",
    "Google Cloud, BigQuery or WeatherNext private credential material",
    "Cloudflare, networking or firewall mutation",
    "SQLite schema init, historical backfill, backup, restore or destructive data mutation",
    "package install or generic sudo/root authority",
    "GitHub repository settings, secrets or permission mutation"
  ]
}
