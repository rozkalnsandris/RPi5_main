    "transient_polling": "bounded-exponential-backoff-max-10s-no-permanent-stop",
    "post_restart": "queued-or-running-persisted-jobs-become-failed-interrupted",
    "preserve_partial_results": true,
    "automatic_retry": false,
    "automatic_requeue": false,
    "automatic_rollback": false,
    "automatic_cleanup": false
  },
  "diagnostics": {
