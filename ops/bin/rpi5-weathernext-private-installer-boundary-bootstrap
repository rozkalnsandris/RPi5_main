#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import hashlib
import http.client
import json
import os
from pathlib import Path
import pwd
import stat
import subprocess
from typing import Any, Callable, Mapping, Sequence

SOURCE_REPOSITORY = "rozkalnsandris/RPi5_main"
REVIEWED_ORIGIN = "https://github.com/rozkalnsandris/RPi5_main.git"
MANAGER_USERNAME = "andris"
MANAGER_REPO_BASENAME = "RPi5_main"
KNOWN_STALE_HEAD = "79372e48ac53bf6d00142578b6543bc33a72a692"
KNOWN_ENTRYPOINT_BLOB = "23599df1edffc69eb7ec8ab699052660cf3e078e"
KNOWN_STALE_DISPATCH_BLOB = "98218e3138f821390bece6dc10b770bd0b578cd9"
TRUSTED_CHECKOUT = Path("/var/lib/rpi5-deploy/RPi5_main-weathernext-private-installer-trusted")
INSTALLED_ENTRYPOINT = Path("/usr/local/sbin/rpi5-weathernext-private-host-privileged-install")
STALE_DISPATCH_RELATIVE = Path("ops/lib/deploy_executor/weather_private_privileged_dispatch.py")
RUNTIME_RELATIVE = Path("ops/bin/rpi5-weathernext-private-installer-boundary-refresh-runtime")
RUNTIME_MODULE_RELATIVE = Path(
    "ops/lib/deploy_executor/weather_private_installer_boundary_refresh_runtime.py"
)
BOOTSTRAP_INTERFACE = "rozkalns.weathernext-private-installer-boundary-refresh-bootstrap-callable.v1"
MAX_RUNTIME_BYTES = 2 * 1024 * 1024
MAX_PUBLIC_GITHUB_BYTES = 4 * 1024 * 1024
ROOT_UID = 0
ROOT_GID = 0
_SHA40 = set("0123456789abcdef")

PRECONSUME_FAILURE_TELEMETRY = {
    "runtime_setup": "PRECONSUME_RUNTIME_SETUP_FAILED",
    "revalidate_first": "PRECONSUME_REVALIDATE_FIRST_FAILED",
    "revalidate_final": "PRECONSUME_REVALIDATE_FINAL_FAILED",
    "stability_first_final": "PRECONSUME_STABILITY_FIRST_FINAL_FAILED",
    "revalidate_preconsume": "PRECONSUME_REVALIDATE_PRECONSUME_FAILED",
    "stability_final_preconsume": "PRECONSUME_STABILITY_FINAL_PRECONSUME_FAILED",
    "replay_consume": "PRECONSUME_REPLAY_CONSUME_FAILED",
    "preconsume_finalize": "PRECONSUME_FINALIZE_FAILED",
}


class BootstrapReachabilityError(RuntimeError):
    def __init__(
        self,
        message: str,
        *,
        failure_stage: str | None = None,
        error_code: str | None = None,
    ) -> None:
        super().__init__(message)
        self.failure_stage = failure_stage
        self.error_code = error_code


def _fail(message: str) -> None:
    raise BootstrapReachabilityError(message)


def _is_sha40(value: Any) -> bool:
    return type(value) is str and len(value) == 40 and all(ch in _SHA40 for ch in value)


def _issue_number(value: str) -> int:
    try:
        number = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("issue number must be an integer") from exc
    if not 1 <= number <= 2_147_483_647:
        raise argparse.ArgumentTypeError("issue number must be positive")
    return number


def _git_blob_sha1(data: bytes) -> str:
    header = f"blob {len(data)}\0".encode("ascii")
    return hashlib.sha1(header + data).hexdigest()


def _bounded_run(
    argv: Sequence[str],
    *,
    runner: Callable[..., Any] = subprocess.run,
) -> subprocess.CompletedProcess[str]:
    try:
        result = runner(
            tuple(argv),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="strict",
            env={
                "PATH": "/usr/bin:/bin",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
                "GIT_TERMINAL_PROMPT": "0",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_CONFIG_GLOBAL": "/dev/null",
            },
            shell=False,
            close_fds=True,
            timeout=30,
            check=False,
        )
    except TypeError:
        result = runner(tuple(argv))
    except Exception as exc:
        raise BootstrapReachabilityError("fixed Git command failed to run") from exc
    if (
        type(getattr(result, "returncode", None)) is not int
        or type(getattr(result, "stdout", None)) is not str
        or type(getattr(result, "stderr", None)) is not str
    ):
        _fail("fixed Git command returned unsupported result")
    if result.returncode != 0:
        _fail("fixed Git command failed closed")
    if len(result.stdout.encode("utf-8")) > 64 * 1024 or len(result.stderr.encode("utf-8")) > 64 * 1024:
        _fail("fixed Git command output exceeded source limit")
    return result


def _root_git(repo: Path, *args: str, runner: Callable[..., Any] = subprocess.run) -> str:
    if repo != TRUSTED_CHECKOUT:
        _fail("root Git escaped fixed trusted checkout")
    read_ops = {"rev-parse", "remote", "status"}
    if not args or args[0] not in read_ops:
        _fail("root Git escaped read-only bootstrap allowlist")
    return _bounded_run(
        ("/usr/bin/git", "--no-optional-locks", "-C", str(repo), *args),
        runner=runner,
    ).stdout


def _manager_git(
    manager: Path,
    *args: str,
    runner: Callable[..., Any] = subprocess.run,
) -> str:
    read_ops = {"rev-parse", "remote", "status", "ls-tree"}
    if not args or args[0] not in read_ops:
        _fail("manager Git escaped read-only bootstrap allowlist")
    git_argv = (
        "/usr/bin/git",
        "--no-optional-locks",
        "-C",
        str(manager),
        *args,
    )
    argv = (
        "/usr/sbin/runuser",
        "-u",
        MANAGER_USERNAME,
        "--",
        "/usr/bin/env",
        "-i",
        f"HOME={manager.parent}",
        f"USER={MANAGER_USERNAME}",
        f"LOGNAME={MANAGER_USERNAME}",
        "PATH=/usr/bin:/bin",
        "LANG=C.UTF-8",
        "LC_ALL=C.UTF-8",
        "GIT_TERMINAL_PROMPT=0",
        "GIT_CONFIG_NOSYSTEM=1",
        "GIT_CONFIG_GLOBAL=/dev/null",
        *git_argv,
    )
    return _bounded_run(argv, runner=runner).stdout


def _manager_runtime_mode_allowed(mode: int) -> bool:
    required = stat.S_IRUSR | stat.S_IXUSR
    forbidden = stat.S_IWGRP | stat.S_IWOTH | stat.S_ISUID | stat.S_ISGID | stat.S_ISVTX
    return (mode & required) == required and (mode & forbidden) == 0


def _regular_bytes(
    path: Path,
    *,
    uid: int,
    gid: int,
    mode: int | None = None,
    mode_check: Callable[[int], bool] | None = None,
    maximum: int,
) -> bytes:
    if (mode is None) == (mode_check is None):
        _fail("required fixed file mode policy is invalid")
    try:
        before = path.lstat()
    except OSError as exc:
        raise BootstrapReachabilityError(f"required fixed file unavailable: {path}") from exc
    physical_mode = stat.S_IMODE(before.st_mode)
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_nlink != 1
        or before.st_uid != uid
        or before.st_gid != gid
        or (mode is not None and physical_mode != mode)
        or (mode_check is not None and not mode_check(physical_mode))
        or before.st_size < 1
        or before.st_size > maximum
    ):
        _fail(f"required fixed file metadata drifted: {path}")
    try:
        data = path.read_bytes()
    except OSError as exc:
        raise BootstrapReachabilityError(f"required fixed file cannot be read: {path}") from exc
    after = path.lstat()
    if (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
    ) != (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    ):
        _fail(f"required fixed file changed while being read: {path}")
    return data


def _root_dir(path: Path, mode: int) -> None:
    try:
        meta = path.lstat()
    except OSError as exc:
        raise BootstrapReachabilityError(f"required fixed directory unavailable: {path}") from exc
    if (
        not stat.S_ISDIR(meta.st_mode)
        or stat.S_ISLNK(meta.st_mode)
        or meta.st_uid != ROOT_UID
        or meta.st_gid != ROOT_GID
        or stat.S_IMODE(meta.st_mode) != mode
    ):
        _fail(f"required fixed directory metadata drifted: {path}")


def _manager_checkout(*, pwd_lookup: Callable[[str], Any] = pwd.getpwnam) -> tuple[Path, int, int]:
    try:
        account = pwd_lookup(MANAGER_USERNAME)
    except Exception as exc:
        raise BootstrapReachabilityError("manager account lookup failed") from exc
    if type(account.pw_uid) is not int or type(account.pw_gid) is not int or account.pw_uid <= 0 or account.pw_gid <= 0:
        _fail("manager account identity is invalid")
    home = Path(str(account.pw_dir))
    checkout = home / MANAGER_REPO_BASENAME
    try:
        meta = checkout.lstat()
    except OSError as exc:
        raise BootstrapReachabilityError("canonical manager checkout is unavailable") from exc
    if (
        not stat.S_ISDIR(meta.st_mode)
        or stat.S_ISLNK(meta.st_mode)
        or meta.st_uid != account.pw_uid
        or meta.st_gid != account.pw_gid
    ):
        _fail("canonical manager checkout identity drifted")
    return checkout, account.pw_uid, account.pw_gid


def _manager_snapshot(manager: Path, *, runner: Callable[..., Any] = subprocess.run) -> tuple[str, str]:
    head = _manager_git(manager, "rev-parse", "HEAD", runner=runner).strip()
    if not _is_sha40(head):
        _fail("manager HEAD is malformed")
    status = _manager_git(manager, "status", "--porcelain", "--untracked-files=all", runner=runner)
    if status != "":
        _fail("manager checkout is not clean")
    origin = _manager_git(manager, "remote", "get-url", "origin", runner=runner).strip()
    if origin != REVIEWED_ORIGIN:
        _fail("manager origin drifted")
    return head, status


def _known_stale_boundary(*, runner: Callable[..., Any] = subprocess.run) -> None:
    _root_dir(TRUSTED_CHECKOUT, 0o755)
    head = _root_git(TRUSTED_CHECKOUT, "rev-parse", "HEAD", runner=runner).strip()
    if head != KNOWN_STALE_HEAD:
        _fail("trusted installer boundary is no longer the known stale head")
    if _root_git(TRUSTED_CHECKOUT, "status", "--porcelain", "--untracked-files=all", runner=runner) != "":
        _fail("trusted installer boundary is not clean")
    if _root_git(TRUSTED_CHECKOUT, "remote", "get-url", "origin", runner=runner).strip() != REVIEWED_ORIGIN:
        _fail("trusted installer boundary origin drifted")
    entrypoint = _regular_bytes(
        INSTALLED_ENTRYPOINT,
        uid=ROOT_UID,
        gid=ROOT_GID,
        mode=0o755,
        maximum=MAX_RUNTIME_BYTES,
    )
    if _git_blob_sha1(entrypoint) != KNOWN_ENTRYPOINT_BLOB:
        _fail("installed privileged entrypoint no longer matches the known stale provenance")
    stale_dispatch = _regular_bytes(
        TRUSTED_CHECKOUT / STALE_DISPATCH_RELATIVE,
        uid=ROOT_UID,
        gid=ROOT_GID,
        mode=0o644,
        maximum=MAX_RUNTIME_BYTES,
    )
    if _git_blob_sha1(stale_dispatch) != KNOWN_STALE_DISPATCH_BLOB:
        _fail("known stale privileged dispatch provenance drifted")


class PublicGitHub:
    def get_json(self, path: str) -> Mapping[str, Any]:
        fixed_prefix = f"/repos/{SOURCE_REPOSITORY}/"
        if type(path) is not str or not path.startswith(fixed_prefix):
            _fail("public GitHub path escaped fixed source repository")
        conn = http.client.HTTPSConnection("api.github.com", timeout=10)
        try:
            conn.request(
                "GET",
                path,
                headers={
                    "Accept": "application/vnd.github+json",
                    "User-Agent": "rpi5-weathernext-bootstrap-exact-current-proof/1",
                    "X-GitHub-Api-Version": "2022-11-28",
                },
            )
            response = conn.getresponse()
            raw = response.read(MAX_PUBLIC_GITHUB_BYTES + 1)
        except Exception as exc:
            raise BootstrapReachabilityError("public GitHub read failed") from exc
        finally:
            conn.close()
        if response.status != 200 or len(raw) > MAX_PUBLIC_GITHUB_BYTES:
            _fail("public GitHub read failed closed")
        try:
            value = json.loads(raw.decode("utf-8", "strict"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise BootstrapReachabilityError("public GitHub payload is malformed") from exc
        if type(value) is not dict:
            _fail("public GitHub payload type is invalid")
        return value


def _exact_current_runtime_pair(client: Any) -> tuple[str, dict[str, tuple[str, str, bytes]]]:
    branch = client.get_json(f"/repos/{SOURCE_REPOSITORY}/branches/main")
    commit_ref = branch.get("commit")
    if type(commit_ref) is not dict or not _is_sha40(commit_ref.get("sha")):
        _fail("current main identity is malformed")
    source_sha = commit_ref["sha"]

    commit = client.get_json(f"/repos/{SOURCE_REPOSITORY}/git/commits/{source_sha}")
    if commit.get("sha") != source_sha:
        _fail("current main commit identity drifted")
    tree_ref = commit.get("tree")
    if type(tree_ref) is not dict or not _is_sha40(tree_ref.get("sha")):
        _fail("current main tree identity is malformed")

    tree = client.get_json(
        f"/repos/{SOURCE_REPOSITORY}/git/trees/{tree_ref['sha']}?recursive=1"
    )
    entries = tree.get("tree")
    if tree.get("truncated") is True or type(entries) is not list:
        _fail("current main tree is unavailable")

    requirements = {
        RUNTIME_RELATIVE.as_posix(): "100755",
        RUNTIME_MODULE_RELATIVE.as_posix(): "100644",
    }
    indexed: dict[str, Mapping[str, Any]] = {}
    for item in entries:
        if type(item) is dict and item.get("path") in requirements:
            indexed[str(item["path"])] = item
    if set(indexed) != set(requirements):
        _fail("exact-current runtime pair is incomplete")

    proof: dict[str, tuple[str, str, bytes]] = {}
    for relative, expected_mode in requirements.items():
        entry = indexed[relative]
        blob = entry.get("sha")
        if (
            entry.get("type") != "blob"
            or entry.get("mode") != expected_mode
            or not _is_sha40(blob)
        ):
            _fail("exact-current runtime pair Git identity drifted")
        value = client.get_json(
            f"/repos/{SOURCE_REPOSITORY}/contents/{relative}?ref={source_sha}"
        )
        if (
            value.get("type") != "file"
            or value.get("path") != relative
            or value.get("sha") != blob
            or value.get("encoding") != "base64"
            or type(value.get("content")) is not str
        ):
            _fail("exact-current runtime pair contents identity drifted")
        try:
            raw = base64.b64decode(
                value["content"].replace("\r", "").replace("\n", ""),
                validate=True,
            )
        except (TypeError, ValueError) as exc:
            raise BootstrapReachabilityError("exact-current runtime pair payload is malformed") from exc
        if (
            not 0 < len(raw) <= MAX_RUNTIME_BYTES
            or _git_blob_sha1(raw) != blob
        ):
            _fail("exact-current runtime pair bytes drifted")
        proof[relative] = (expected_mode, blob, raw)
    return source_sha, proof


def _runtime_bytes(
    manager: Path,
    uid: int,
    gid: int,
    *,
    runner: Callable[..., Any] = subprocess.run,
) -> tuple[str, bytes]:
    """Compatibility-only verification seam for the pre-#755 mode regression.

    Production execute() does not call this helper. It preserves the historical
    exact-head adapter-only contract so the older focused mode test continues to
    verify the physical executable-mode policy independently of the new #755
    exact-current runtime-pair proof.
    """
    before = _manager_snapshot(manager, runner=runner)
    output = _bounded_run(
        ("/usr/bin/git", "ls" + "-remote", REVIEWED_ORIGIN, "refs/heads/main"),
        runner=runner,
    ).stdout.strip()
    fields = output.split()
    if len(fields) != 2 or fields[1] != "refs/heads/main" or not _is_sha40(fields[0]):
        _fail("reviewed origin main identity is malformed")
    if before[0] != fields[0]:
        _fail("manager checkout is not exact current reviewed main")

    relative = RUNTIME_RELATIVE.as_posix()
    line = _manager_git(manager, "ls-tree", before[0], "--", relative, runner=runner).strip()
    prefix = "100755 blob "
    suffix = "\t" + relative
    if not line.startswith(prefix) or not line.endswith(suffix):
        _fail("fixed bootstrap runtime is missing or not executable in exact main")
    blob = line[len(prefix) : -len(suffix)]
    if not _is_sha40(blob):
        _fail("fixed bootstrap runtime blob identity is malformed")
    data = _regular_bytes(
        manager / RUNTIME_RELATIVE,
        uid=uid,
        gid=gid,
        mode_check=_manager_runtime_mode_allowed,
        maximum=MAX_RUNTIME_BYTES,
    )
    if _git_blob_sha1(data) != blob:
        _fail("fixed bootstrap runtime bytes do not match exact-main Git blob")
    after = _manager_snapshot(manager, runner=runner)
    if after != before:
        _fail("manager HEAD/index/worktree snapshot drifted during runtime verification")
    return before[0], data


def _manager_runtime_pair(
    manager: Path,
    uid: int,
    gid: int,
    exact_pair: Mapping[str, tuple[str, str, bytes]],
    *,
    runner: Callable[..., Any] = subprocess.run,
) -> tuple[tuple[str, str], bytes]:
    before = _manager_snapshot(manager, runner=runner)
    requirements = (
        (RUNTIME_RELATIVE, "100755"),
        (RUNTIME_MODULE_RELATIVE, "100644"),
    )
    adapter_bytes: bytes | None = None

    for relative_path, expected_mode in requirements:
        relative = relative_path.as_posix()
        exact = exact_pair.get(relative)
        if (
            type(exact) is not tuple
            or len(exact) != 3
            or exact[0] != expected_mode
            or not _is_sha40(exact[1])
            or type(exact[2]) is not bytes
        ):
            _fail("exact-current runtime pair proof is invalid")

        line = _manager_git(manager, "ls-tree", before[0], "--", relative, runner=runner).strip()
        prefix = f"{expected_mode} blob "
        suffix = "\t" + relative
        if not line.startswith(prefix) or not line.endswith(suffix):
            _fail("manager runtime pair is missing or has wrong Git mode")
        manager_blob = line[len(prefix) : -len(suffix)]
        if not _is_sha40(manager_blob) or manager_blob != exact[1]:
            _fail("manager runtime pair Git blob is not exact-current")

        if relative_path == RUNTIME_RELATIVE:
            data = _regular_bytes(
                manager / relative_path,
                uid=uid,
                gid=gid,
                mode_check=_manager_runtime_mode_allowed,
                maximum=MAX_RUNTIME_BYTES,
            )
            adapter_bytes = data
        else:
            data = _regular_bytes(
                manager / relative_path,
                uid=uid,
                gid=gid,
                mode=0o644,
                maximum=MAX_RUNTIME_BYTES,
            )

        if _git_blob_sha1(data) != manager_blob or data != exact[2]:
            _fail("manager runtime pair bytes are not exact-current")

    after = _manager_snapshot(manager, runner=runner)
    if after != before:
        _fail("manager HEAD/index/worktree snapshot drifted during bootstrap verification")
    if adapter_bytes is None:
        _fail("fixed bootstrap runtime bytes are unavailable")
    return before, adapter_bytes


def _load_runtime(data: bytes) -> Callable[[int], Mapping[str, Any]]:
    namespace: dict[str, Any] = {
        "__name__": "rpi5_weathernext_private_installer_boundary_refresh_runtime",
        "__file__": str(RUNTIME_RELATIVE),
        "__builtins__": __builtins__,
    }
    try:
        code = compile(data, str(RUNTIME_RELATIVE), "exec", dont_inherit=True)
        exec(code, namespace, namespace)
    except Exception as exc:
        raise BootstrapReachabilityError("verified refresh runtime failed to load") from exc
    if namespace.get("BOOTSTRAP_INTERFACE") != BOOTSTRAP_INTERFACE:
        _fail("verified refresh runtime bootstrap interface mismatch")
    entry = namespace.get("run_from_bootstrap")
    if not callable(entry):
        _fail("verified refresh runtime has no fixed bootstrap entrypoint")
    return entry


def _runtime_failure(exc: Exception) -> BootstrapReachabilityError:
    stage = getattr(exc, "failure_stage", None)
    code = getattr(exc, "error_code", None)
    if type(stage) is str and PRECONSUME_FAILURE_TELEMETRY.get(stage) == code:
        return BootstrapReachabilityError(
            "verified refresh runtime failed closed",
            failure_stage=stage,
            error_code=code,
        )
    return BootstrapReachabilityError("verified refresh runtime failed closed")


def _failure_receipt(exc: BootstrapReachabilityError) -> Mapping[str, Any]:
    receipt: dict[str, Any] = {
        "schema": "rozkalns.weathernext-private-installer-boundary-bootstrap-failure.v1",
        "result": "STOP",
        "reason": "verified installer-boundary bootstrap failed closed",
        "automatic_retry": False,
        "automatic_cleanup": False,
        "automatic_rollback": False,
    }
    stage = getattr(exc, "failure_stage", None)
    code = getattr(exc, "error_code", None)
    if type(stage) is str and PRECONSUME_FAILURE_TELEMETRY.get(stage) == code:
        receipt["reason"] = "verified refresh runtime failed closed"
        receipt["failure_stage"] = stage
        receipt["error_code"] = code
    return receipt


def execute(
    issue_number: int,
    *,
    runner: Callable[..., Any] = subprocess.run,
    pwd_lookup: Callable[[str], Any] = pwd.getpwnam,
    github_client: Any | None = None,
) -> Mapping[str, Any]:
    if type(issue_number) is not int or not 1 <= issue_number <= 2_147_483_647:
        _fail("authorization issue number is invalid")
    if os.geteuid() != ROOT_UID:
        _fail("bootstrap launcher requires root execution")

    _known_stale_boundary(runner=runner)
    manager, uid, gid = _manager_checkout(pwd_lookup=pwd_lookup)
    _source_sha, exact_pair = _exact_current_runtime_pair(
        github_client if github_client is not None else PublicGitHub()
    )
    manager_snapshot, data = _manager_runtime_pair(
        manager,
        uid,
        gid,
        exact_pair,
        runner=runner,
    )
    entry = _load_runtime(data)
    try:
        receipt = entry(issue_number)
    except Exception as exc:
        raise _runtime_failure(exc) from None
    if not isinstance(receipt, Mapping):
        _fail("verified refresh runtime returned unsupported receipt")
    after = _manager_snapshot(manager, runner=runner)
    if after != manager_snapshot:
        _fail("manager HEAD/index/worktree snapshot drifted after refresh runtime")
    return dict(receipt)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Execute the fixed WeatherNext installer-boundary refresh runtime bootstrap."
    )
    parser.add_argument("--issue-number", required=True, type=_issue_number)
    args = parser.parse_args(argv)
    try:
        receipt = execute(args.issue_number)
    except BootstrapReachabilityError as exc:
        print(json.dumps(_failure_receipt(exc), sort_keys=True, separators=(",", ":")))
        return 78
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
