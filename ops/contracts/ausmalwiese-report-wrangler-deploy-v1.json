  "email_binding": {
    "name": "EMAIL",
    "destination": "pinned-config-blob-only"
  },
  "deploy_flags": [
    "--no-bundle",
    "--strict",
    "--tag",
    "--message"
  ],
  "post_deploy_requires": [
