#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "ops/lib/deploy_executor"
sys.path.insert(0, str(LIB))

import control_phase5_observation_credential_bootstrap as bootstrap


def emit(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--preflight", action="store_true")
    mode.add_argument("--apply", action="store_true")
    parser.add_argument("--approved-source-sha", required=True)
    args = parser.parse_args()

    state = bootstrap._OperationState()
    try:
        if args.preflight:
            receipt = bootstrap.preflight_credential_bootstrap(
                approved_source_sha=args.approved_source_sha,
            )
        else:
            receipt = bootstrap.apply_credential_bootstrap(
                approved_source_sha=args.approved_source_sha,
                state=state,
            )
    except Exception as exc:
        emit(bootstrap.public_error_receipt(exc, state=state))
        return 2
    emit(receipt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
