#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

TRUSTED_ROOT = Path("/var/lib/rpi5-deploy/RPi5_main-weathernext-private-host-trusted")
LIB = TRUSTED_ROOT / "ops" / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from deploy_executor.weather_private_bigquery_host_bindings import (  # noqa: E402
    WeatherNextInstalledBindingsError,
    build_installed_weather_private_runtime,
)


def _issue_number(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("issue number must be an integer") from exc
    if not 1 <= parsed <= 2_147_483_647:
        raise argparse.ArgumentTypeError("issue number must be positive")
    return parsed


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Execute the installed WeatherNext private one-shot capability."
    )
    parser.add_argument("--issue-number", type=_issue_number, required=True)
    args = parser.parse_args(argv)
    try:
        runtime = build_installed_weather_private_runtime()
        receipt = runtime.execute(args.issue_number)
    except WeatherNextInstalledBindingsError as exc:
        print(
            json.dumps(
                {
                    "status": "STOP",
                    "reason": str(exc),
                    "runtime_state": "STOP_REQUIRES_SANITIZED_EVIDENCE",
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 1
    except Exception:
        print(
            json.dumps(
                {
                    "status": "STOP",
                    "reason": "WeatherNext private one-shot execution failed closed",
                    "runtime_state": "STOP_REQUIRES_SANITIZED_EVIDENCE",
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 1
    print(json.dumps(dict(receipt), sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
