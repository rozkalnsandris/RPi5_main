      "revalidates_archived_metadata": true,
      "terminal_archive_state": "restored",
      "duplicate_restore": "fail-closed",
      "sitemap_refresh": "existing-best-effort-publisher",
      "restorable_states": [
        "prepared",
        "archived"
      ]
    },
    "archive_read_endpoint": "GET /api/archive",
    "delete_issue": 1178,
    "permanent_delete": {
      "endpoint": "POST /api/archive/delete",
      "source_state": "archived-only",
      "confirmation": [
        "exact-id",
        "literal-DELETE"
      ],
      "requires_live_id_absent": true,
      "requires_current_catalog_if_match": true,
      "shared_lock": "/srv/coloring-pages-content/state/drive-ingest/.lock",
      "transition": [
        "archived",
        "delete-prepared",
        "deleted"
      ],
      "persist_delete_prepared_before_file_mutation": true,
      "exact_targets": [
        "/srv/coloring-pages-content/originals/<id>/",
        "/srv/coloring-pages-content/public/media/<id>/",
        "/srv/coloring-pages-content/inbox/<id>.png-if-exact-regular-file-exists"
      ],
      "directory_shape": "direct-child-real-directory-containing-direct-regular-files-only",
      "max_files": 128,
      "max_total_bytes": 1073741824,
      "catalog_deleted": false,
      "archive_tombstone_deleted": false,
      "upload_history_deleted": false,
      "job_history_deleted": false,
      "logs_deleted": false,
      "analytics_deleted": false,
      "drive_deleted": false,
      "bulk_delete": false,
      "automatic_retry": false,
      "automatic_rollback": false,
      "automatic_cleanup": false,
      "interrupted_state": "delete-prepared-visible-manual-review-only"
