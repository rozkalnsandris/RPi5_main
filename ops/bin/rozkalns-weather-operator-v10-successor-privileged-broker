#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
from typing import Any, Mapping

from deploy_executor import weather_operator_upgrade_v9_host_capability as cap
from deploy_executor.registry import BaselineContract, MutationBudget, OperationRegistry, OperationSpec, QueueMatch

GIT_ENV = {"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"}
ISSUE = 643
OPERATION_ID = "rpi5-main.weather-operator-upgrade-v10.v1"
TARGET_ALIAS = "rpi5-main-weather-operator-upgrade-v10"
BASELINE_RESOLVER_ID = "rpi5-main.weather-operator-upgrade-v10-baseline.v1"
ENTRYPOINT = "ops/bin/rozkalns-weather-public-runtime-operator-upgrade-v10"
UPGRADE_MODULE = "ops/lib/deploy_executor/weather_public_runtime_operator_upgrade_v10.py"
TRUSTED_CHECKOUT_NAME = "RPi5_main-weather-public-runtime-operator-upgrade-v10-trusted"
PRESERVED_V9_CHECKOUT_NAME = "RPi5_main-weather-public-runtime-operator-upgrade-v9-8026125-historical"
PRESERVED_V9_SHA = "80261255b3be2aa7dd40986254d4ea478b4e2e1b"
MINIMUM_REVIEWED_ANCESTOR = "d63c21006e0f19be9f0a4e30290f8e324212b594"
OLD_SHA256 = "48c8c5fb0cdc005bf0e4fbb05a203297e05d7ef62689ddd0d6d717c13acc0fcb"
NEW_SHA256 = "a36e7e7673855e1d9aa49b676133e188ee2a24a0711ba46f2844af6f60240a03"
UPGRADE_ENTRYPOINT_BLOB = "86f1f311c252e42a201d75d6e92f38bf255ecf5a"
UPGRADE_MODULE_BLOB = "07e1908870f5051119aa61a2e899d0ae9ba466ab"
TARGET_TEMP_PATH = cap.TARGET_PATH.parent / ".weather_public_runtime_operator.py.compatibility-upgrade-v10.tmp"
MUTATION_BUDGET = (
    ("git.weather-operator-upgrade-v10-checkout-fetch", 1),
    ("git.weather-operator-upgrade-v10-checkout-worktree-add", 1),
    ("filesystem.weather-operator-upgrade-v10-atomic-replace", 1),
)
AUTH_START = "<!-- rozkalns-weather-v10-live-auth:v1 -->"
AUTH_END = "<!-- /rozkalns-weather-v10-live-auth:v1 -->"
AUTH_SCHEMA = "rozkalns.rpi5-main.weather-operator-upgrade-v10-live-auth.v1"
AUTH_TITLE = "[LIVE-AUTH][PENDING] rpi5-main-weather-operator-upgrade-v10"
REQUIRED_EXCLUSIONS = (
    "no generic sudo/root shell or caller-selected command/path/argv/environment",
    "no cleanup/retry/rollback/worktree remove/prune/repair",
    "no Docker/systemd application mutation",
    "no SQLite/corpus/snapshot/database mutation",
    "no network/firewall/DNS/Cloudflare mutation",
    "no credential/secret/permission/repository-settings mutation",
    "no v9 LIVE authorization reuse",
)
WORKTREE_ADD_UMASK = 0o022
MAX_CHILD_OUTPUT = 65536
_MANAGER_PATH: Path | None = None
_MANAGER_UID: int | None = None
_MANAGER_GID: int | None = None


def _fail(message: str) -> None:
    raise cap.WeatherV9HostCapabilityError(message)


def _configure_capability_overlay() -> None:
    cap.ISSUE = ISSUE
    cap.OPERATION_ID = OPERATION_ID
    cap.ADAPTER_ID = OPERATION_ID
    cap.TARGET_ALIAS = TARGET_ALIAS
    cap.BASELINE_RESOLVER_ID = BASELINE_RESOLVER_ID
    cap.ENTRYPOINT = ENTRYPOINT
    cap.UPGRADE_MODULE = UPGRADE_MODULE
    cap.TRUSTED_CHECKOUT_NAME = TRUSTED_CHECKOUT_NAME
    cap.MINIMUM_REVIEWED_ANCESTOR = MINIMUM_REVIEWED_ANCESTOR
    cap.OLD_SHA256 = OLD_SHA256
    cap.NEW_SHA256 = NEW_SHA256
    cap.TARGET_TEMP_PATH = TARGET_TEMP_PATH
    cap.MUTATION_BUDGET = MUTATION_BUDGET
    cap.AUTH_START = AUTH_START
    cap.AUTH_END = AUTH_END
    cap.AUTH_SCHEMA = AUTH_SCHEMA
    cap.AUTH_TITLE = AUTH_TITLE
    cap.REQUIRED_EXCLUSIONS = REQUIRED_EXCLUSIONS
    cap.fixed_registry = _fixed_registry_v10
    cap.execute_plan = _execute_plan_v10


def _fixed_registry_v10() -> OperationRegistry:
    operation = OperationSpec(
        operation_id=OPERATION_ID,
        source_repository=cap.SOURCE_REPOSITORY,
        queue_match=QueueMatch(
            target_alias=TARGET_ALIAS,
            execution_location_class="trusted-home-host",
            repository_entrypoint=ENTRYPOINT,
            deploy_class="STRICT_LIVE_AUTH_REQUIRED",
        ),
        target_alias=TARGET_ALIAS,
        adapter_id=OPERATION_ID,
        authorization_class=cap.AUTHORIZATION_CLASS,
        ordinary_live_all_eligible=False,
        baseline=BaselineContract(kind="resolver", resolver_id=BASELINE_RESOLVER_ID),
        mutation_budget=tuple(
            MutationBudget(category=category, max_operations=maximum)
            for category, maximum in MUTATION_BUDGET
        ),
        rollback_policy=cap.ROLLBACK_POLICY,
        exclusions=REQUIRED_EXCLUSIONS,
        dependencies=(
            "source-contract:RPi5_main#641",
            "privileged-successor:RPi5_main#643",
            "p8-global-mutation-dispatch:disabled",
            "privileged-boundary:identity-only",
            "v9-live-authority-reuse:forbidden",
        ),
        preflight=("fresh authorization, READY queue, exact current main/CI and v10 predecessor",),
        postconditions=("v10 operator module exact reviewed hash and historical v8/v9 preserved",),
        required_github_evidence=("owner authorization, READY queue, exact source/CI",),
    )
    return OperationRegistry(schema_version=1, execution_enabled=False, operations=(operation,))


def _configure_registration(registration: Mapping[str, Any]) -> None:
    global _MANAGER_PATH, _MANAGER_UID, _MANAGER_GID
    manager = Path(str(registration.get("manager_checkout", "")))
    uid = registration.get("manager_uid")
    gid = registration.get("manager_gid")
    if not manager.is_absolute() or manager.name != "RPi5_main":
        _fail("registered manager checkout identity drifted")
    if type(uid) is not int or type(gid) is not int or uid <= 0 or gid <= 0:
        _fail("registered manager identity is invalid")
    _MANAGER_PATH = manager
    _MANAGER_UID = uid
    _MANAGER_GID = gid


def _manager_identity() -> tuple[Path, int, int]:
    if _MANAGER_PATH is None or _MANAGER_UID is None or _MANAGER_GID is None:
        _fail("registered manager identity backend is not configured")
    return _MANAGER_PATH, _MANAGER_UID, _MANAGER_GID


def _manager_subprocess(argv: list[str], *, text: bool, check: bool = True, umask: int = -1) -> subprocess.CompletedProcess[Any]:
    _manager, uid, gid = _manager_identity()
    try:
        return subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=text,
            env=GIT_ENV,
            user=uid,
            group=gid,
            extra_groups=(),
            umask=umask,
            check=check,
        )
    except subprocess.CalledProcessError as exc:
        raise cap.WeatherV9HostCapabilityError("manager-identity child process failed") from exc


def _reviewed_manager(manager: Path) -> Path:
    registered, _uid, _gid = _manager_identity()
    if manager != registered or not manager.is_absolute() or manager.name != "RPi5_main":
        _fail("registered manager checkout identity drifted")
    return manager


def _allowed_paths(manager: Path) -> set[Path]:
    return {
        manager,
        manager.parent / cap.PRESERVED_V8_CHECKOUT_NAME,
        manager.parent / PRESERVED_V9_CHECKOUT_NAME,
        manager.parent / TRUSTED_CHECKOUT_NAME,
    }


def _bounded_run_git(manager: Path, *args: str, check: bool = True, repo: Path | None = None, child_umask: int = -1) -> subprocess.CompletedProcess[str]:
    reviewed = _reviewed_manager(manager)
    working = reviewed if repo is None else repo
    if working not in _allowed_paths(reviewed):
        _fail("Git working directory is outside the fixed Weather-v10 checkout set")
    command = ["/usr/bin/git", "-c", f"safe.directory={reviewed}", "-C", str(working), *args]
    return _manager_subprocess(command, text=True, check=check, umask=child_umask)


def _home_test(path: Path, predicate: str) -> bool:
    manager, _uid, _gid = _manager_identity()
    if path not in _allowed_paths(manager):
        _fail("home-access check is outside the fixed Weather-v10 checkout set")
    result = _manager_subprocess(["/usr/bin/test", predicate, str(path)], text=True, check=False)
    if result.returncode not in (0, 1):
        _fail("manager-identity home-access check failed")
    return result.returncode == 0


def _worktree_records(text: str) -> list[dict[str, str | bool]]:
    records: list[dict[str, str | bool]] = []
    for block in text.strip().split("\n\n") if text.strip() else []:
        record: dict[str, str | bool] = {}
        for line in block.splitlines():
            key, separator, value = line.partition(" ")
            record[key] = value if separator else True
        records.append(record)
    return records


def _record_for(records: list[dict[str, str | bool]], path: Path) -> dict[str, str | bool] | None:
    matches = [record for record in records if record.get("worktree") == str(path)]
    if len(matches) > 1:
        _fail("duplicate worktree registration detected")
    return matches[0] if matches else None


def _require_preserved(manager: Path, records: list[dict[str, str | bool]], name: str, sha: str, label: str) -> Path:
    target = manager.parent / name
    record = _record_for(records, target)
    if record is None or record.get("HEAD") != sha or record.get("detached") is not True:
        _fail(f"preserved {label} worktree identity drifted")
    if record.get("locked") is not None or record.get("prunable") is not None:
        _fail(f"preserved {label} worktree state drifted")
    if not _home_test(target, "-d"):
        _fail(f"preserved {label} checkout is absent")
    if _bounded_run_git(manager, "status", "--porcelain", "--untracked-files=all", repo=target).stdout != "":
        _fail(f"preserved {label} checkout is dirty")
    if _bounded_run_git(manager, "remote", "get-url", "origin", repo=target).stdout.strip() != cap.REVIEWED_ORIGIN:
        _fail(f"preserved {label} checkout origin drifted")
    return target


def _checkout_state(manager: Path, source_sha: str) -> tuple[str, Path, Path]:
    reviewed = _reviewed_manager(manager)
    records = _worktree_records(_bounded_run_git(reviewed, "worktree", "list", "--porcelain").stdout)
    v8 = _require_preserved(reviewed, records, cap.PRESERVED_V8_CHECKOUT_NAME, cap.PRESERVED_V8_SHA, "v8")
    _require_preserved(reviewed, records, PRESERVED_V9_CHECKOUT_NAME, PRESERVED_V9_SHA, "v9")
    v10 = reviewed.parent / TRUSTED_CHECKOUT_NAME
    record = _record_for(records, v10)
    if record is None:
        if _home_test(v10, "-e"):
            _fail("unregistered v10 checkout path exists")
        return "ABSENT", v10, v8
    if record.get("HEAD") != source_sha or record.get("detached") is not True:
        _fail("existing v10 checkout identity drifted")
    if record.get("locked") is not None or record.get("prunable") is not None:
        _fail("existing v10 checkout state drifted")
    if not _home_test(v10, "-d"):
        _fail("registered v10 checkout directory is absent")
    if _bounded_run_git(reviewed, "status", "--porcelain", "--untracked-files=all", repo=v10).stdout != "":
        _fail("existing v10 checkout is dirty")
    if _bounded_run_git(reviewed, "remote", "get-url", "origin", repo=v10).stdout.strip() != cap.REVIEWED_ORIGIN:
        _fail("existing v10 checkout origin drifted")
    return "EXACT_SHA_DETACHED_CLEAN", v10, v8


def _require_created_worktree(manager: Path, target: Path, source_sha: str) -> None:
    records = _worktree_records(_bounded_run_git(manager, "worktree", "list", "--porcelain").stdout)
    record = _record_for(records, target)
    if record is None or record.get("HEAD") != source_sha or record.get("detached") is not True:
        _fail("created v10 worktree identity drifted")
    if record.get("locked") is not None or record.get("prunable") is not None:
        _fail("created v10 worktree state drifted")
    if not _home_test(target, "-d"):
        _fail("created v10 worktree directory is absent")
    if _bounded_run_git(manager, "status", "--porcelain", "--untracked-files=all", repo=target).stdout != "":
        _fail("created v10 worktree is dirty")


def _bootstrap_checkout(plan: cap.WeatherV9BrokerPlan) -> None:
    if plan.checkout_state != "ABSENT":
        return
    _bounded_run_git(plan.manager_checkout, "fetch", "origin", "main")
    origin_main = _bounded_run_git(plan.manager_checkout, "rev-parse", "refs/remotes/origin/main").stdout.strip()
    if origin_main != plan.authorization.source_sha:
        _fail("origin/main drifted after the single authorized fetch")
    ancestor = _bounded_run_git(plan.manager_checkout, "merge-base", "--is-ancestor", MINIMUM_REVIEWED_ANCESTOR, plan.authorization.source_sha, check=False)
    if ancestor.returncode != 0:
        _fail("authorized source no longer descends from reviewed v10 bridge")
    _bounded_run_git(
        plan.manager_checkout,
        "worktree", "add", "--detach", str(plan.trusted_checkout), plan.authorization.source_sha,
        child_umask=WORKTREE_ADD_UMASK,
    )
    _require_created_worktree(plan.manager_checkout, plan.trusted_checkout, plan.authorization.source_sha)


def _require_source_blob(manager: Path, source_sha: str, path: str, expected_blob: str) -> None:
    try:
        observed = _bounded_run_git(manager, "rev-parse", f"{source_sha}:{path}").stdout.strip()
    except (cap.WeatherV9HostCapabilityError, OSError, subprocess.SubprocessError) as exc:
        raise cap.WeatherV9HostCapabilityError(f"reviewed v10 source blob drifted: {path}") from exc
    if observed != expected_blob:
        _fail(f"reviewed v10 source blob drifted: {path}")


def _run_fixed_upgrade(plan: cap.WeatherV9BrokerPlan) -> Mapping[str, Any]:
    _require_source_blob(plan.manager_checkout, plan.authorization.source_sha, ENTRYPOINT, UPGRADE_ENTRYPOINT_BLOB)
    _require_source_blob(plan.manager_checkout, plan.authorization.source_sha, UPGRADE_MODULE, UPGRADE_MODULE_BLOB)
    entrypoint = plan.trusted_checkout / ENTRYPOINT
    try:
        meta = entrypoint.lstat()
    except OSError as exc:
        raise cap.WeatherV9HostCapabilityError("fixed v10 entrypoint metadata drifted") from exc
    if not stat.S_ISREG(meta.st_mode) or stat.S_ISLNK(meta.st_mode) or meta.st_nlink != 1 or stat.S_IMODE(meta.st_mode) != 0o755:
        _fail("fixed v10 entrypoint metadata drifted")
    try:
        result = subprocess.run(
            [str(entrypoint)], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, env=GIT_ENV, shell=False, close_fds=True, timeout=90, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise cap.WeatherV9HostCapabilityError("fixed v10 upgrade invocation failed to run") from exc
    if len(result.stdout) > MAX_CHILD_OUTPUT or len(result.stderr) > MAX_CHILD_OUTPUT:
        _fail("fixed v10 upgrade output exceeded limit")
    if result.returncode != 0:
        _fail("fixed v10 upgrade did not report success")
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        _fail("fixed v10 upgrade emitted no receipt")
    try:
        receipt = json.loads(lines[-1])
    except json.JSONDecodeError as exc:
        raise cap.WeatherV9HostCapabilityError("fixed v10 upgrade receipt is malformed") from exc
    if (
        type(receipt) is not dict
        or receipt.get("result") != "PASS"
        or receipt.get("source_sha") != plan.authorization.source_sha
        or receipt.get("new_sha256") != NEW_SHA256
        or receipt.get("mutation_started") is not True
        or receipt.get("target_replaced") is not True
    ):
        _fail("fixed v10 upgrade receipt identity drifted")
    return receipt


def _execute_plan_v10(plan: cap.WeatherV9BrokerPlan) -> Mapping[str, Any]:
    cap._admit_and_consume(plan)
    try:
        _bootstrap_checkout(plan)
    except (cap.WeatherV9HostCapabilityError, OSError, subprocess.SubprocessError) as exc:
        raise cap.WeatherV9HostCapabilityError("reviewed v10 source blob drifted: checkout-bootstrap") from exc
    _run_fixed_upgrade(plan)
    try:
        raw = cap._safe_file(cap.TARGET_PATH, uid=0, gid=0, mode=0o644, max_bytes=2 * 1024 * 1024)
    except (cap.WeatherV9HostCapabilityError, OSError) as exc:
        raise cap.WeatherV9HostCapabilityError("installed v10 operator module postcondition failed") from exc
    if hashlib.sha256(raw).hexdigest() != NEW_SHA256:
        _fail("installed v10 operator module postcondition failed")
    return {
        "schema": "rozkalns.rpi5-main.weather-operator-upgrade-v10-broker-receipt.v1",
        "result": "PASS",
        "authorization_issue_number": plan.authorization.issue_number,
        "request_id": plan.authorization.request_id,
        "source_sha": plan.authorization.source_sha,
        "operation_id": OPERATION_ID,
        "target_alias": TARGET_ALIAS,
        "source_ci_run_id": plan.source_ci_run_id,
        "queue_contract_sha256": plan.queue_contract_sha256,
        "durable_replay_consumed": True,
        "authorization_reuse_forbidden": True,
        "operator_module_sha256": NEW_SHA256,
        "historical_v8_v9_preserved": True,
        "v9_live_authority_reused": False,
        "automatic_retry": False,
        "automatic_cleanup": False,
        "automatic_rollback": False,
        "docker_mutation": False,
        "systemd_application_mutation": False,
        "sqlite_or_corpus_mutation": False,
        "network_or_cloudflare_mutation": False,
        "production_mutation_started": True,
    }


def _install_bounded_runtime(registration: Mapping[str, Any]) -> None:
    _configure_registration(registration)
    cap._run_git = _bounded_run_git
    cap._checkout_state = _checkout_state
    cap._bootstrap_checkout = _bootstrap_checkout
    cap._run_fixed_upgrade = _run_fixed_upgrade


if __name__ == "__main__":
    try:
        _configure_capability_overlay()
        registration = cap.load_registration()
        _install_bounded_runtime(registration)
        raise SystemExit(cap.runtime_main())
    except (cap.WeatherV9HostCapabilityError, OSError) as exc:
        print(json.dumps({
            "schema": "rozkalns.rpi5-main.weather-operator-upgrade-v10-broker-receipt.v1",
            "result": "FAIL_CLOSED",
            "reason": str(exc),
            "authorization_reuse_forbidden_if_state_mutation_started": True,
            "automatic_retry": False,
            "automatic_cleanup": False,
            "automatic_rollback": False,
        }, sort_keys=True, separators=(",", ":")))
        raise SystemExit(78)
