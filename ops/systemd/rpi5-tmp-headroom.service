[Unit]
Description=RPi5 /tmp capacity and policy monitor
Documentation=https://github.com/rozkalnsandris/RPi5_main
OnFailure=rpi5-maintenance-notify@%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rpi5-tmp-headroom
TimeoutStartSec=30s
Restart=no
UMask=0077
NoNewPrivileges=yes
PrivateTmp=no
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
