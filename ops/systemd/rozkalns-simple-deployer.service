[Unit]
Description=Rozkalns SIMPLE-DEPLOY v1 generic pull reconciler
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=rozkalns-simple-deployer
Group=rozkalns-simple-deployer
SupplementaryGroups=docker
UMask=0077
StateDirectory=rozkalns-simple-deployer
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/rozkalns-simple-deployer/rozkalns-simple-deployer --all

NoNewPrivileges=true
PrivateTmp=true
RemoveIPC=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rozkalns-simple-deployer
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
