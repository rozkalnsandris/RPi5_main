#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "ops/lib/deploy_executor"
sys.path.insert(0, str(LIB))

import control_phase5_production_visibility_producer as producer


def stop(code: str) -> int:
    receipt = {
        "authorization_consumed": False,
        "contract": producer.CONTRACT,
        "credential_access": "NO",
        "mutation_started": False,
        "network_request": "NO",
        "status": "STOP",
        "code": code,
    }
    print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
    return 2


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--expected-main-sha", required=True)
    args = parser.parse_args()
    try:
        value = producer.observe_production_visibility(
            expected_main_sha=args.expected_main_sha,
        )
    except producer.ProductionVisibilityProducerError as exc:
        return stop(exc.code)
    except Exception:
        return stop("UNEXPECTED_ERROR")
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
