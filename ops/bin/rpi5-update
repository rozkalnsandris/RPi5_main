#!/usr/bin/env bash
# RPi5 drošs nedēļas atjaunināšanas skripts
# Versija: 21
#
# Noklusējuma palaišana (reāls update):
#   sudo /usr/local/sbin/rpi5-update
#
# Tikai pārbaude / simulācija:
#   sudo /usr/local/sbin/rpi5-update --check
#
# Reāls update bez restarta:
#   sudo /usr/local/sbin/rpi5-update --no-reboot
#
# Tikai droša sistēmas tīrīšana:
#   sudo /usr/local/sbin/rpi5-update --cleanup-only
#
# Atbalstītās papildu vērtības /etc/rpi-update.conf:
#   UPDATE_USER=andris
#   MAIN_COMPOSE_DIR=/home/andris/docker
#   CV_COMPOSE_DIR=/home/andris/docker/cv
#   REBOOT_POLICY=if-needed       # if-needed | always | never
#   RCLONE_UPDATE_MODE=auto       # auto | selfupdate | skip
#   HERMES_UPDATE=yes             # yes | no
#   HERMES_BACKUP=yes             # yes | no
#   CLEANUP_RETENTION_DAYS=14
#   DOCKER_CLEANUP=yes            # yes | no
#   JOURNAL_RETENTION=14d
#   MIN_FREE_KB=2097152           # 2 GiB
#   COMPOSE_WAIT_TIMEOUT=240
#   RCLONE_TIMEOUT=10m
#   HERMES_TIMEOUT=30m
#   DOCKER_PULL_TIMEOUT=45m
#   BACKUP_WAIT_TIMEOUT=1800      # sekundes; max 7200
#   HOST_IPV4=192.168.0.180
#
# Obligātās esošās vērtības:
#   TELEGRAM_TOKEN=...
#   CHAT_ID=...

set -Eeuo pipefail
shopt -s inherit_errexit 2>/dev/null || true
umask 077

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C
export LANG=C
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export APT_LISTCHANGES_FRONTEND=none
export COMPOSE_ANSI=never
export COMPOSE_PROGRESS=plain

readonly CONFIG_FILE="/etc/rpi-update.conf"
readonly LOG="/var/log/rpi5-update.log"
readonly LOCK_FILE="/run/lock/rpi5-update.lock"
readonly BACKUP_LOCK_FILE="/run/lock/rpi5-backup.lock"
readonly LIBEXEC_DIR="/usr/local/libexec/rpi5-maintenance"
readonly TELEGRAM_HELPER="${LIBEXEC_DIR}/rpi5-update-telegram.py"

validate_runtime_code_file() {
    local path="$1"
    local uid mode

    [[ -f "$path" && ! -L "$path" ]] || {
        echo "KĻŪDA: trūkst droša runtime faila: $path" >&2
        exit 1
    }

    uid="$(stat -c '%u' "$path")"
    mode="$(stat -c '%a' "$path")"
    [[ "$uid" -eq 0 ]] || {
        echo "KĻŪDA: runtime failam jābūt root īpašumā: $path" >&2
        exit 1
    }
    if (( (8#$mode & 022) != 0 )); then
        echo "KĻŪDA: runtime fails nedrīkst būt group/world writable: $path ($mode)" >&2
        exit 1
    fi
}

MODE="run"
NO_REBOOT=0
for arg in "$@"; do
    case "$arg" in
        --check)
            MODE="check"
            ;;
        --cleanup-only)
            MODE="cleanup"
            ;;
        --no-reboot)
            NO_REBOOT=1
            ;;
        -h|--help)
            sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Nezināms parametrs: $arg" >&2
            exit 2
            ;;
    esac
done

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "KĻŪDA: skripts jāpalaiž ar sudo/root." >&2
    exit 1
fi

for helper in \
    rpi5-update-hermes-status.sh \
    rpi5-update-locks.sh \
    rpi5-update-reboot.sh \
    rpi5-update-compose-health.sh \
    rpi5-update-compose-policy.sh \
    rpi5-update-space-policy.sh \
    rpi5-update-origin-policy.sh \
    rpi5-update-http-health.sh; do
    validate_runtime_code_file "${LIBEXEC_DIR}/${helper}"
    # shellcheck source=/dev/null
    source "${LIBEXEC_DIR}/${helper}"
done
validate_runtime_code_file "$TELEGRAM_HELPER"

mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "KĻŪDA: cits RPi5 update process jau darbojas." >&2
    exit 75
fi

rotate_log() {
    local max_bytes=$((10 * 1024 * 1024))
    local current_size=0

    if [[ -f "$LOG" ]]; then
        current_size="$(stat -c '%s' "$LOG" 2>/dev/null || echo 0)"
    fi

    if (( current_size < max_bytes )); then
        return
    fi

    rm -f "${LOG}.4"
    [[ -f "${LOG}.3" ]] && mv -f "${LOG}.3" "${LOG}.4"
    [[ -f "${LOG}.2" ]] && mv -f "${LOG}.2" "${LOG}.3"
    [[ -f "${LOG}.1" ]] && mv -f "${LOG}.1" "${LOG}.2"
    mv -f "$LOG" "${LOG}.1"
}

rotate_log

LOG_GROUP="root"
getent group adm >/dev/null 2>&1 && LOG_GROUP="adm"

if [[ ! -e "$LOG" ]]; then
    install -o root -g "$LOG_GROUP" -m 0640 /dev/null "$LOG"
else
    chown root:"$LOG_GROUP" "$LOG" 2>/dev/null || true
    chmod 0640 "$LOG" 2>/dev/null || true
fi

exec > >(tee -a "$LOG") 2>&1

RUN_ID="$(date +'%Y%m%d_%H%M%S')"
START_EPOCH="$(date +%s)"
TMP_DIR="$(mktemp -d "/tmp/rpi5-update-${RUN_ID}.XXXXXX")"
FAILURE_SENT=0
FINAL_SENT=0
CURRENT_PHASE="initializācija"

declare -a SUMMARY_LINES=()
declare -a WARNINGS=()
declare -a UPDATED_IMAGES=()

APT_STATUS=0
RCLONE_STATUS=0
HERMES_STATUS=0
MAIN_DOCKER_STATUS=0
CV_DOCKER_STATUS=0
LOCAL_HEALTH_STATUS=0
PUBLIC_HEALTH_STATUS=0
CLEANUP_STATUS=0
CLEANUP_DELETED_ITEMS=0
CLEANUP_SPACE_DELTA="0 B"

APT_COUNT=0
APT_REMOVE_COUNT=0
APT_AUTOREMOVE_COUNT=0
APT_PACKAGE_LIST=""
APT_FULL_ONLY_COUNT=0
APT_FULL_REMOVE_COUNT=0
RCLONE_BEFORE=""
RCLONE_AFTER=""
HERMES_BEFORE=""
HERMES_AFTER=""

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

status_icon() {
    if [[ "${1:-1}" -eq 0 ]]; then
        printf '✅'
    else
        printf '❌'
    fi
}

elapsed_human() {
    local total="${1:-0}"
    printf '%02d:%02d:%02d' \
        $((total / 3600)) \
        $(((total % 3600) / 60)) \
        $((total % 60))
}

cleanup() {
    rm -rf "$TMP_DIR"
}

on_signal() {
    local signal_name="$1"
    local exit_code="$2"

    trap - INT TERM
    set +e

    log "UPDATE pārtraukts ar signālu ${signal_name}; reboot netiks veikts."

    if [[ "$FINAL_SENT" -eq 0 && "$FAILURE_SENT" -eq 0 ]]; then
        FAILURE_SENT=1
        send_msg "❌ RPi5 UPDATE PĀRTRAUKTS

Signāls: ${signal_name}
Fāze: ${CURRENT_PHASE}
Reboot NETIKS veikts.

Logs: ${LOG}" || true
    fi

    exit "$exit_code"
}

trap cleanup EXIT
trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM

send_msg() {
    local text="${1:-}"

    [[ -n "$text" ]] || return 0
    [[ -n "${TELEGRAM_TOKEN:-}" && -n "${CHAT_ID:-}" ]] || return 0

    if ! printf '%s\0%s\0%s' "$TELEGRAM_TOKEN" "$CHAT_ID" "$text" |
        python3 "$TELEGRAM_HELPER"; then
        log "BRĪDINĀJUMS: Telegram ziņu neizdevās nosūtīt."
        return 1
    fi
}


on_error() {
    local exit_code=$?
    local line_no="${1:-?}"

    trap - ERR
    set +e

    log "KĻŪDA: neapstrādāta kļūda fāzē '${CURRENT_PHASE}', rinda ${line_no}, kods ${exit_code}."

    if [[ "$FINAL_SENT" -eq 0 && "$FAILURE_SENT" -eq 0 ]]; then
        FAILURE_SENT=1
        send_msg "❌ RPi5 UPDATE PĀRTRAUKTS

Fāze: ${CURRENT_PHASE}
Exit kods: ${exit_code}
Rinda: ${line_no}
Reboot NETIKS veikts.

Logs: ${LOG}"
    fi

    exit "$exit_code"
}
trap 'on_error $LINENO' ERR

validate_secure_config() {
    [[ -f "$CONFIG_FILE" ]] || {
        echo "KĻŪDA: nav $CONFIG_FILE" >&2
        exit 1
    }

    local uid mode
    uid="$(stat -c '%u' "$CONFIG_FILE")"
    mode="$(stat -c '%a' "$CONFIG_FILE")"

    [[ "$uid" -eq 0 ]] || {
        echo "KĻŪDA: $CONFIG_FILE jābūt root īpašumā." >&2
        exit 1
    }

    if (( (8#$mode & 077) != 0 )); then
        echo "KĻŪDA: $CONFIG_FILE jābūt pieejamam tikai root (ieteicams mode 600; pašlaik $mode)." >&2
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    : "${TELEGRAM_TOKEN:?Kļūda: TELEGRAM_TOKEN nav definēts}"
    : "${CHAT_ID:?Kļūda: CHAT_ID nav definēts}"

    UPDATE_USER="${UPDATE_USER:-andris}"
    MAIN_COMPOSE_DIR="${MAIN_COMPOSE_DIR:-/home/andris/docker}"
    CV_COMPOSE_DIR="${CV_COMPOSE_DIR:-/home/andris/docker/cv}"
    REBOOT_POLICY="${REBOOT_POLICY:-if-needed}"
    RCLONE_UPDATE_MODE="${RCLONE_UPDATE_MODE:-auto}"
    HERMES_UPDATE="${HERMES_UPDATE:-yes}"
    HERMES_BACKUP="${HERMES_BACKUP:-yes}"
    CLEANUP_RETENTION_DAYS="${CLEANUP_RETENTION_DAYS:-14}"
    DOCKER_CLEANUP="${DOCKER_CLEANUP:-yes}"
    JOURNAL_RETENTION="${JOURNAL_RETENTION:-${CLEANUP_RETENTION_DAYS}d}"
    MIN_FREE_KB="${MIN_FREE_KB:-2097152}"
    COMPOSE_WAIT_TIMEOUT="${COMPOSE_WAIT_TIMEOUT:-240}"
    RCLONE_TIMEOUT="${RCLONE_TIMEOUT:-10m}"
    HERMES_TIMEOUT="${HERMES_TIMEOUT:-30m}"
    DOCKER_PULL_TIMEOUT="${DOCKER_PULL_TIMEOUT:-45m}"
    BACKUP_WAIT_TIMEOUT="${BACKUP_WAIT_TIMEOUT:-1800}"
    HOST_IPV4="${HOST_IPV4:-192.168.0.180}"
    HERMES_BIN="${HERMES_BIN:-/home/${UPDATE_USER}/.local/bin/hermes}"

    case "$REBOOT_POLICY" in
        if-needed|always|never) ;;
        *) echo "KĻŪDA: nederīgs REBOOT_POLICY=$REBOOT_POLICY" >&2; exit 1 ;;
    esac

    case "$RCLONE_UPDATE_MODE" in
        auto|selfupdate|skip) ;;
        *) echo "KĻŪDA: nederīgs RCLONE_UPDATE_MODE=$RCLONE_UPDATE_MODE" >&2; exit 1 ;;
    esac

    case "$HERMES_UPDATE" in
        yes|no) ;;
        *) echo "KĻŪDA: HERMES_UPDATE jābūt yes vai no." >&2; exit 1 ;;
    esac

    case "$HERMES_BACKUP" in
        yes|no) ;;
        *) echo "KĻŪDA: HERMES_BACKUP jābūt yes vai no." >&2; exit 1 ;;
    esac

    case "$DOCKER_CLEANUP" in
        yes|no) ;;
        *) echo "KĻŪDA: DOCKER_CLEANUP jābūt yes vai no." >&2; exit 1 ;;
    esac

    [[ "$CLEANUP_RETENTION_DAYS" =~ ^[0-9]+$ ]] || {
        echo "KĻŪDA: CLEANUP_RETENTION_DAYS nav vesels skaitlis." >&2
        exit 1
    }

    if (( CLEANUP_RETENTION_DAYS < 1 || CLEANUP_RETENTION_DAYS > 3650 )); then
        echo "KĻŪDA: CLEANUP_RETENTION_DAYS jābūt robežās 1..3650." >&2
        exit 1
    fi

    [[ "$JOURNAL_RETENTION" =~ ^[1-9][0-9]*(s|min|h|d|w|month|months|year|years)$ ]] || {
        echo "KĻŪDA: JOURNAL_RETENTION ir nederīgs: $JOURNAL_RETENTION" >&2
        exit 1
    }

    [[ "$MIN_FREE_KB" =~ ^[0-9]+$ ]] || {
        echo "KĻŪDA: MIN_FREE_KB nav skaitlis." >&2
        exit 1
    }

    [[ "$COMPOSE_WAIT_TIMEOUT" =~ ^[0-9]+$ ]] || {
        echo "KĻŪDA: COMPOSE_WAIT_TIMEOUT nav skaitlis." >&2
        exit 1
    }

    [[ "$BACKUP_WAIT_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || {
        echo "KĻŪDA: BACKUP_WAIT_TIMEOUT jābūt pozitīvam sekunžu skaitlim." >&2
        exit 1
    }
    if (( BACKUP_WAIT_TIMEOUT > 7200 )); then
        echo "KĻŪDA: BACKUP_WAIT_TIMEOUT nedrīkst pārsniegt 7200 sekundes." >&2
        exit 1
    fi

    for duration_name in RCLONE_TIMEOUT HERMES_TIMEOUT DOCKER_PULL_TIMEOUT; do
        duration_value="${!duration_name}"
        [[ "$duration_value" =~ ^[1-9][0-9]*([smhd])?$ ]] || {
            echo "KĻŪDA: ${duration_name} ir nederīgs ilgums: ${duration_value}" >&2
            exit 1
        }
    done

    python3 - "$HOST_IPV4" <<'PY'
import ipaddress
import sys

try:
    address = ipaddress.ip_address(sys.argv[1])
except ValueError as exc:
    raise SystemExit(f"KĻŪDA: nederīgs HOST_IPV4: {exc}")

if address.version != 4:
    raise SystemExit("KĻŪDA: HOST_IPV4 jābūt IPv4 adresei.")
PY
}

validate_secure_config

readonly UPDATE_USER MAIN_COMPOSE_DIR CV_COMPOSE_DIR
readonly REBOOT_POLICY RCLONE_UPDATE_MODE HERMES_UPDATE HERMES_BACKUP
readonly CLEANUP_RETENTION_DAYS DOCKER_CLEANUP JOURNAL_RETENTION
readonly MIN_FREE_KB COMPOSE_WAIT_TIMEOUT
readonly RCLONE_TIMEOUT HERMES_TIMEOUT DOCKER_PULL_TIMEOUT BACKUP_WAIT_TIMEOUT HOST_IPV4 HERMES_BIN

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        log "KĻŪDA: trūkst komandas: $1"
        return 1
    }
}

CURRENT_PHASE="priekšpārbaude"
log "===== RPi5 UPDATE v21 SĀKTS (mode=${MODE}, run_id=${RUN_ID}) ====="

for command_name in \
    apt-get dpkg dpkg-query apt-mark docker python3 curl flock runuser \
    systemctl journalctl systemd-tmpfiles numfmt df awk grep sort paste \
    readlink shutdown comm stat install chown chmod ionice renice sync \
    timeout getent env find rm sed head tail tr tee mv mkdir mktemp sleep cat id; do
    require_command "$command_name"
done

id "$UPDATE_USER" >/dev/null 2>&1 || {
    log "KĻŪDA: lietotājs $UPDATE_USER neeksistē."
    exit 1
}

UPDATE_HOME="$(getent passwd "$UPDATE_USER" | awk -F: 'NR==1 {print $6}')"
[[ -n "$UPDATE_HOME" && -d "$UPDATE_HOME" ]] || {
    log "KĻŪDA: lietotājam $UPDATE_USER nav derīgas HOME direktorijas."
    exit 1
}
readonly UPDATE_HOME

run_as_update_user() {
    runuser -u "$UPDATE_USER" -- \
        env \
            HOME="$UPDATE_HOME" \
            USER="$UPDATE_USER" \
            LOGNAME="$UPDATE_USER" \
            PATH="${UPDATE_HOME}/.local/bin:${UPDATE_HOME}/.local/npm/bin:/usr/local/bin:/usr/bin:/bin" \
            "$@"
}

run_timed_as_update_user() {
    local duration="$1"
    local kill_after="$2"
    shift 2

    timeout \
        --foreground \
        --kill-after="$kill_after" \
        "$duration" \
        runuser -u "$UPDATE_USER" -- \
            env \
                HOME="$UPDATE_HOME" \
                USER="$UPDATE_USER" \
                LOGNAME="$UPDATE_USER" \
                PATH="${UPDATE_HOME}/.local/bin:${UPDATE_HOME}/.local/npm/bin:/usr/local/bin:/usr/bin:/bin" \
                "$@"
}

require_help_flag() {
    local label="$1"
    local flag="$2"
    local help_output
    shift 2

    help_output="$("$@" --help 2>&1 || true)"

    if ! grep -Fq -- "$flag" <<<"$help_output"; then
        log "KĻŪDA: ${label} neatbalsta nepieciešamo parametru ${flag}."
        return 1
    fi
}

require_help_flag "docker compose up" "--wait" docker compose up
require_help_flag "docker compose up" "--pull" docker compose up
require_help_flag "docker compose up" "--no-build" docker compose up
require_help_flag "docker compose up" "--wait-timeout" docker compose up
require_help_flag "docker compose pull" "--ignore-buildable" docker compose pull
require_help_flag "docker compose config" "--images" docker compose config
require_help_flag "docker compose config" "--services" docker compose config
require_help_flag "docker compose ps" "--all" docker compose ps
require_help_flag "docker compose ps" "--services" docker compose ps
require_help_flag "docker image prune" "--filter" docker image prune
require_help_flag "docker builder prune" "--filter" docker builder prune
require_help_flag "docker builder prune" "--all" docker builder prune
require_help_flag "journalctl" "--vacuum-time" journalctl
require_help_flag "journalctl" "--rotate" journalctl
require_help_flag "rm" "--one-file-system" rm
require_help_flag "timeout" "--kill-after" timeout

cleanup_remove_file() {
    local path="$1"

    [[ -e "$path" || -L "$path" ]] || return 0
    log "Dzēš vecu failu: $path"

    if rm -f -- "$path"; then
        CLEANUP_DELETED_ITEMS=$((CLEANUP_DELETED_ITEMS + 1))
    else
        CLEANUP_STATUS=1
    fi
}

cleanup_remove_directory() {
    local path="$1"

    [[ -d "$path" && ! -L "$path" ]] || return 0

    case "$path" in
        "$UPDATE_HOME"/rpi5-*-backup-20*|\
        "$UPDATE_HOME"/cloudflare-ufw-backup-20*)
            ;;
        *)
            log "KĻŪDA: atteikta neparedzētas direktorijas dzēšana: $path"
            CLEANUP_STATUS=1
            return 1
            ;;
    esac

    log "Dzēš vecu backup direktoriju: $path"

    if rm -rf --one-file-system -- "$path"; then
        CLEANUP_DELETED_ITEMS=$((CLEANUP_DELETED_ITEMS + 1))
    else
        CLEANUP_STATUS=1
    fi
}

cleanup_old_maintenance_artifacts() {
    local retention_minutes=$((CLEANUP_RETENTION_DAYS * 24 * 60))
    local item

    if [[ -d "$UPDATE_HOME/update-script-backups" ]]; then
        while IFS= read -r -d '' item; do
            cleanup_remove_file "$item"
        done < <(
            find "$UPDATE_HOME/update-script-backups" \
                -xdev -mindepth 1 -maxdepth 1 \
                -type f \
                -cmin "+${retention_minutes}" \
                -print0
        )
    fi

    while IFS= read -r -d '' item; do
        cleanup_remove_file "$item"
    done < <(
        find "$UPDATE_HOME" \
            -xdev -mindepth 1 -maxdepth 1 \
            -type f \
            \( -name 'rpi5_*.log' -o -name 'rpi5-*.log' \) \
            -mmin "+${retention_minutes}" \
            -print0
    )

    while IFS= read -r -d '' item; do
        cleanup_remove_directory "$item"
    done < <(
        find "$UPDATE_HOME" \
            -xdev -mindepth 1 -maxdepth 1 \
            -type d \
            \( -name 'rpi5-*-backup-20*' -o -name 'cloudflare-ufw-backup-20*' \) \
            -cmin "+${retention_minutes}" \
            -print0
    )

    while IFS= read -r -d '' item; do
        if [[ ! -e "$item" ]]; then
            cleanup_remove_file "$item"
        fi
    done < <(
        find "$UPDATE_HOME" \
            -xdev -mindepth 1 -maxdepth 1 \
            -type l \
            -name 'rpi5-*-latest-backup' \
            -print0
    )

    while IFS= read -r -d '' item; do
        cleanup_remove_file "$item"
    done < <(
        find /tmp \
            -xdev -mindepth 1 -maxdepth 1 \
            -type f \
            \( -name 'rpi5_*.sh' -o -name 'rpi5-*.sh' -o -name 'deploy_rpi5_*.sh' \) \
            -mmin "+${retention_minutes}" \
            -print0
    )

    while IFS= read -r -d '' item; do
        log "Dzēš vecu RPi5 pagaidu direktoriju: $item"

        if rm -rf --one-file-system -- "$item"; then
            CLEANUP_DELETED_ITEMS=$((CLEANUP_DELETED_ITEMS + 1))
        else
            CLEANUP_STATUS=1
        fi
    done < <(
        find /tmp \
            -xdev -mindepth 1 -maxdepth 1 \
            -type d \
            -name 'rpi5-update-*' \
            -mmin "+${retention_minutes}" \
            -print0
    )

    while IFS= read -r -d '' item; do
        cleanup_remove_file "$item"
    done < <(
        find /var/log \
            -xdev -mindepth 1 -maxdepth 1 \
            -type f \
            -name 'rpi5-update.log.*' \
            -mmin "+${retention_minutes}" \
            -print0
    )
}

run_retention_cleanup() {
    local retention_hours=$((CLEANUP_RETENTION_DAYS * 24))
    local df_before df_after delta_kb

    CURRENT_PHASE="14 dienu tīrīšana"
    log "----- Droša tīrīšana: ${CLEANUP_RETENTION_DAYS} dienu retention -----"

    df_before="$(df --output=avail / | tail -1 | tr -d ' ')"

    apt-get autoclean -y || CLEANUP_STATUS=1

    journalctl \
        --rotate \
        --vacuum-time="$JOURNAL_RETENTION" || CLEANUP_STATUS=1

    systemd-tmpfiles --clean || CLEANUP_STATUS=1

    cleanup_old_maintenance_artifacts

    if [[ "$DOCKER_CLEANUP" == "yes" ]]; then
        log "Docker: dzēš dangling image un neizmantotu build cache, kas vecāki par retention."
        log "Docker networks, volumes, konteineri un tagotie rollback/release image netiek dzēsti."

        docker image prune \
            -f \
            --filter "until=${retention_hours}h" || CLEANUP_STATUS=1

        docker builder prune \
            -a \
            -f \
            --filter "until=${retention_hours}h" || CLEANUP_STATUS=1

    else
        log "Docker cleanup izlaists pēc konfigurācijas."
    fi

    df_after="$(df --output=avail / | tail -1 | tr -d ' ')"
    delta_kb=$((df_after - df_before))

    if (( delta_kb >= 0 )); then
        CLEANUP_SPACE_DELTA="$(
            numfmt --to=iec --suffix=B $((delta_kb * 1024))
        )"
    else
        CLEANUP_SPACE_DELTA="-$(
            numfmt --to=iec --suffix=B $((-delta_kb * 1024))
        )"
    fi

    log "Tīrīšana: dzēsti ${CLEANUP_DELETED_ITEMS} maintenance objekti."
    log "Tīrīšanas diska vietas izmaiņa: ${CLEANUP_SPACE_DELTA}"
    docker system df || true

    SUMMARY_LINES+=(
        "🧹 Tīrīšana (${CLEANUP_RETENTION_DAYS}d): $(status_icon "$CLEANUP_STATUS") (${CLEANUP_SPACE_DELTA})"
    )
}

if [[ "$HERMES_UPDATE" == "yes" && -x "$HERMES_BIN" ]]; then
    require_help_flag "hermes update" "--check" run_as_update_user "$HERMES_BIN" update
    require_help_flag "hermes update" "--yes" run_as_update_user "$HERMES_BIN" update
    if [[ "$HERMES_BACKUP" == "yes" ]]; then
        require_help_flag "hermes update" "--backup" run_as_update_user "$HERMES_BIN" update
    fi
fi

renice 10 $$ >/dev/null 2>&1 || true
ionice -c2 -n7 -p $$ >/dev/null 2>&1 || true

disk_free_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
disk_used_pct="$(df -Pk / | awk 'NR==2 {gsub(/%/,"",$5); print $5}')"
inode_free_pct="$(df -Pi / | awk 'NR==2 {gsub(/%/,"",$5); print 100-$5}')"

log "Disks: ${disk_used_pct}% izmantots, $(numfmt --to=iec --suffix=B $((disk_free_kb * 1024))) brīvs."
log "Brīvie inode: ${inode_free_pct}%."

space_gate_rc=0
if rpi5_enforce_normal_space_gate "$MODE"; then
    if (( disk_free_kb < MIN_FREE_KB )); then
        log "KĻŪDA: mazāk par konfigurēto minimālo brīvo vietu."
        exit 1
    fi

    if (( inode_free_pct < 5 )); then
        log "KĻŪDA: mazāk par 5% brīvu inode."
        exit 1
    fi
else
    space_gate_rc=$?
    if [[ "$space_gate_rc" -ne 1 ]]; then
        log "KĻŪDA: nezināms diska vietas politikas režīms: ${MODE}"
        exit 1
    fi
    log "Cleanup-only režīmā minimālās brīvās vietas/inode slieksnis netiek piemērots pirms tīrīšanas."
fi

docker info >/dev/null

validate_compose_project() {
    local project_name="$1"
    local project_dir="$2"

    [[ -d "$project_dir" ]] || {
        log "KĻŪDA: nav Compose direktorijas $project_dir"
        return 1
    }

    (
        cd "$project_dir"
        docker compose config --quiet
    )

    log "Compose konfigurācija '${project_name}': OK."
}

validate_compose_project "main" "$MAIN_COMPOSE_DIR"
validate_compose_project "cv" "$CV_COMPOSE_DIR"

check_project_runtime() {
    local project_name="$1"
    local project_dir="$2"
    local bad=0
    local count=0
    local container_id running health name
    local expected_services actual_services missing_display

    expected_services="$(
        cd "$project_dir"
        docker compose config --services
    )"
    actual_services="$(
        cd "$project_dir"
        docker compose ps --all --services
    )"

    if ! rpi5_find_missing_compose_services "$expected_services" "$actual_services"; then
        missing_display="${RPI5_MISSING_COMPOSE_SERVICES//$'\n'/, }"
        log "KĻŪDA: Compose projektam '${project_name}' trūkst konteineru servisiem: ${missing_display}"
        bad=1
    fi

    while IFS= read -r container_id; do
        [[ -n "$container_id" ]] || continue
        count=$((count + 1))

        name="$(docker inspect -f '{{.Name}}' "$container_id" | sed 's#^/##')"
        running="$(docker inspect -f '{{.State.Running}}' "$container_id")"
        health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id")"

        if [[ "$running" != "true" ]] ||
           [[ "$health" != "none" && "$health" != "healthy" ]]; then
            log "KĻŪDA: ${project_name}/${name}: running=${running}, health=${health}"
            bad=1
        fi
    done < <(
        cd "$project_dir"
        docker compose ps -aq
    )

    if (( count == 0 )); then
        log "KĻŪDA: Compose projektam '${project_name}' nav atrasts neviens konteiners."
        bad=1
    fi

    return "$bad"
}

check_project_runtime "main" "$MAIN_COMPOSE_DIR"
check_project_runtime "cv" "$CV_COMPOSE_DIR"

if [[ "$MODE" == "run" || "$MODE" == "cleanup" ]]; then
    log "Pārbauda backup lock; gaidīšanas limits ${BACKUP_WAIT_TIMEOUT}s."
    backup_wait_rc=0
    rpi5_wait_for_lock_available "$BACKUP_LOCK_FILE" "$BACKUP_WAIT_TIMEOUT" || backup_wait_rc=$?
    if [[ "$backup_wait_rc" -eq 75 ]]; then
        log "KĻŪDA: backup lock neatbrīvojās ${BACKUP_WAIT_TIMEOUT}s laikā; maintenance netiek sākta."
        exit 75
    elif [[ "$backup_wait_rc" -ne 0 ]]; then
        log "KĻŪDA: backup lock pārbaude neizdevās (rc=${backup_wait_rc})."
        exit 1
    fi
    log "Backup lock ir brīvs; maintenance var turpināties."
else
    log "--check režīmā backup lock gaidīšana netiek veikta; pakotnes/Hermes/Docker netiek instalēti."
fi

if [[ "$MODE" == "run" ]]; then
    send_msg "🔄 RPi5 SVĒTDIENAS UPDATE SĀKTS

Laiks: $(date '+%Y-%m-%d %H:%M:%S')
Režīms: drošs automātiskais update
Reboot politika: ${REBOOT_POLICY}" || true
fi

if [[ "$MODE" == "run" || "$MODE" == "cleanup" ]]; then
    run_retention_cleanup
else
    log "--check režīmā 14 dienu tīrīšana netiek veikta."
    SUMMARY_LINES+=("🧹 Tīrīšana (${CLEANUP_RETENTION_DAYS}d): simulācija")
fi

if [[ "$MODE" == "cleanup" ]]; then
    END_EPOCH="$(date +%s)"
    DURATION="$(elapsed_human $((END_EPOCH - START_EPOCH)))"

    CLEANUP_REPORT="🧹 RPi5 SISTĒMAS TĪRĪŠANA PABEIGTA

Retention: ${CLEANUP_RETENTION_DAYS} dienas
Statuss: $(status_icon "$CLEANUP_STATUS")
Dzēsti maintenance objekti: ${CLEANUP_DELETED_ITEMS}
Atbrīvots: ${CLEANUP_SPACE_DELTA}
Ilgums: ${DURATION}

Docker volumes un running/stopped konteineri netika dzēsti.
Logs: ${LOG}"

    printf '\n%s\n' "$CLEANUP_REPORT"
    send_msg "$CLEANUP_REPORT" || true
    FINAL_SENT=1

    log "===== RPi5 TĪRĪŠANA PABEIGTA: status=${CLEANUP_STATUS}, ilgums=${DURATION} ====="
    exit "$CLEANUP_STATUS"
fi

# ============================================================
# APT
# ============================================================
CURRENT_PHASE="APT"
log "----- APT -----"

APT_COMMON=(
    -o Acquire::Retries=3
    -o Acquire::http::Timeout=30
    -o Acquire::https::Timeout=30
    -o DPkg::Lock::Timeout=300
)

log "APT repozitoriju metadatu atjaunināšana..."
if ! apt-get "${APT_COMMON[@]}" --error-on=any update; then
    APT_STATUS=1
    log "KĻŪDA: apt-get update neizdevās."
else
    dpkg_audit_before="$(dpkg --audit 2>&1 || true)"

    if [[ -n "$dpkg_audit_before" ]]; then
        log "Atrasts nepabeigts dpkg stāvoklis; mēģina droši salabot."
        if [[ "$MODE" == "run" ]]; then
            dpkg \
                --force-confdef \
                --force-confold \
                --configure -a

            if ! apt-get "${APT_COMMON[@]}" \
                -s \
                -f install \
                --no-remove >"${TMP_DIR}/apt-fix-simulation.txt"; then
                log "KĻŪDA: broken dependencies nevar droši salabot bez pakotņu noņemšanas."
                APT_STATUS=1
            elif ! apt-get "${APT_COMMON[@]}" \
                -y \
                -o Dpkg::Options::="--force-confdef" \
                -o Dpkg::Options::="--force-confold" \
                -f install \
                --no-remove; then
                APT_STATUS=1
            fi
        else
            APT_STATUS=1
            WARNINGS+=("dpkg --audit atrada nepabeigtu stāvokli; --check režīmā tas netika labots.")
        fi
    fi

    APT_SIM_FILE="${TMP_DIR}/apt-simulation.txt"
    if apt-get "${APT_COMMON[@]}" -s upgrade --with-new-pkgs --no-remove >"$APT_SIM_FILE"; then
        APT_COUNT="$(grep -c '^Inst ' "$APT_SIM_FILE" || true)"
        APT_REMOVE_COUNT="$(grep -c '^Remv ' "$APT_SIM_FILE" || true)"
        APT_PACKAGE_LIST="$(
            awk '/^Inst / {print $2}' "$APT_SIM_FILE" |
                sort -u |
                paste -sd' ' -
        )"

        log "APT simulācija: ${APT_COUNT} atjaunināmas, ${APT_REMOVE_COUNT} noņemamas pakotnes."

        APT_FULL_SIM_FILE="${TMP_DIR}/apt-full-simulation.txt"
        if apt-get "${APT_COMMON[@]}" -s full-upgrade >"$APT_FULL_SIM_FILE" 2>/dev/null; then
            APT_FULL_REMOVE_COUNT="$(grep -c '^Remv ' "$APT_FULL_SIM_FILE" || true)"

            awk '/^Inst / {print $2}' "$APT_SIM_FILE" |
                sort -u >"${TMP_DIR}/apt-safe-packages.txt"

            awk '/^Inst / {print $2}' "$APT_FULL_SIM_FILE" |
                sort -u >"${TMP_DIR}/apt-full-packages.txt"

            APT_FULL_ONLY_COUNT="$(
                comm -13 \
                    "${TMP_DIR}/apt-safe-packages.txt" \
                    "${TMP_DIR}/apt-full-packages.txt" |
                    grep -c . || true
            )"

            if (( APT_FULL_ONLY_COUNT > 0 || APT_FULL_REMOVE_COUNT > 0 )); then
                WARNINGS+=(
                    "Manuālai full-upgrade pārbaudei: ${APT_FULL_ONLY_COUNT} papildu pakotnes, ${APT_FULL_REMOVE_COUNT} noņemšanas."
                )
            fi
        else
            WARNINGS+=("APT full-upgrade simulācija neizdevās; drošais upgrade režīms joprojām tika pārbaudīts.")
        fi

        if (( APT_REMOVE_COUNT > 0 )); then
            APT_STATUS=1
            log "KĻŪDA: drošais APT režīms neatļauj pakotņu noņemšanu."
        elif [[ "$MODE" == "run" && "$APT_COUNT" -gt 0 ]]; then
            log "APT drošais upgrade: upgrade --with-new-pkgs --no-remove"

            if ! apt-get "${APT_COMMON[@]}" \
                -y \
                -V \
                -o Dpkg::Options::="--force-confdef" \
                -o Dpkg::Options::="--force-confold" \
                upgrade --with-new-pkgs --no-remove; then
                APT_STATUS=1
            fi
        fi
    else
        APT_STATUS=1
        log "KĻŪDA: APT simulācija neizdevās."
    fi

    if [[ "$MODE" == "run" && "$APT_STATUS" -eq 0 ]]; then
        dpkg_audit_after="$(dpkg --audit 2>&1 || true)"
        if [[ -n "$dpkg_audit_after" ]]; then
            APT_STATUS=1
            log "KĻŪDA: dpkg --audit pēc update nav tukšs:"
            printf '%s\n' "$dpkg_audit_after"
        fi
    fi
fi

APT_AUTOREMOVE_COUNT="$(
    apt-get -s autoremove 2>/dev/null |
        grep -c '^Remv ' || true
)"

held_packages="$(apt-mark showhold 2>/dev/null | paste -sd', ' - || true)"
[[ -n "$held_packages" ]] && WARNINGS+=("APT hold: ${held_packages}")
(( APT_AUTOREMOVE_COUNT > 0 )) &&
    WARNINGS+=("APT autoremove kandidāti: ${APT_AUTOREMOVE_COUNT}; automātiski netika dzēsti.")

SUMMARY_LINES+=("📦 APT: ${APT_COUNT} pakotnes $(status_icon "$APT_STATUS")")

if [[ "$MODE" == "run" && "$APT_STATUS" -ne 0 ]]; then
    FINAL_SENT=1
    send_msg "❌ RPi5 UPDATE APSTĀDINĀTS APT FĀZĒ

APT vai dpkg pārbaude neizdevās.
Hermes, rclone un Docker update netika turpināti.
Reboot NETIKS veikts.

Logs: ${LOG}" || true
    log "Update apturēts pēc APT kļūdas; tālākie komponenti netiek mainīti."
    exit 1
fi

# ============================================================
# RCLONE
# ============================================================
CURRENT_PHASE="rclone"
log "----- rclone -----"

rclone_version() {
    rclone version 2>/dev/null |
        awk 'NR==1 {print $2; exit}'
}

if ! command -v rclone >/dev/null 2>&1; then
    log "rclone nav instalēts — izlaiž."
    SUMMARY_LINES+=("☁️ rclone: nav instalēts")
elif [[ "$RCLONE_UPDATE_MODE" == "skip" ]]; then
    RCLONE_BEFORE="$(rclone_version)"
    RCLONE_AFTER="$RCLONE_BEFORE"
    log "rclone update izlaists pēc konfigurācijas."
    SUMMARY_LINES+=("☁️ rclone: ${RCLONE_BEFORE:-?} (izlaists)")
else
    RCLONE_BEFORE="$(rclone_version)"
    rclone_binary="$(readlink -f "$(command -v rclone)")"
    rclone_dpkg_owned=0

    if dpkg-query -S "$rclone_binary" >/dev/null 2>&1; then
        rclone_dpkg_owned=1
    fi

    if [[ "$RCLONE_UPDATE_MODE" == "auto" && "$rclone_dpkg_owned" -eq 1 ]]; then
        RCLONE_AFTER="$RCLONE_BEFORE"
        log "rclone pārvalda APT/dpkg; atsevišķs selfupdate netiek jaukts ar APT."
        SUMMARY_LINES+=("☁️ rclone: ${RCLONE_BEFORE:-?} (APT pārvaldīts)")
    else
        require_help_flag "rclone selfupdate" "--check" rclone selfupdate
        require_help_flag "rclone selfupdate" "--stable" rclone selfupdate

        rclone_package_args=()
        if [[ "$rclone_dpkg_owned" -eq 1 ]]; then
            require_help_flag "rclone selfupdate" "--package" rclone selfupdate
            rclone_package_args=(--package deb)
        fi

        if [[ "$MODE" == "check" ]]; then
            if ! timeout --foreground --kill-after=30s "$RCLONE_TIMEOUT" \
                rclone selfupdate --check --stable "${rclone_package_args[@]}"; then
                RCLONE_STATUS=1
            fi
        else
            if ! timeout --foreground --kill-after=30s "$RCLONE_TIMEOUT" \
                rclone selfupdate --stable "${rclone_package_args[@]}"; then
                RCLONE_STATUS=1
            fi
        fi

        RCLONE_AFTER="$(rclone_version)"
        SUMMARY_LINES+=("☁️ rclone: ${RCLONE_BEFORE:-?} → ${RCLONE_AFTER:-?} $(status_icon "$RCLONE_STATUS")")
    fi
fi

# ============================================================
# HERMES
# ============================================================
CURRENT_PHASE="Hermes"
log "----- Hermes -----"

hermes_version() {
    run_as_update_user "$HERMES_BIN" version 2>/dev/null |
        grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' |
        head -1 || true
}

if [[ "$HERMES_UPDATE" == "no" ]]; then
    log "Hermes update izlaists pēc konfigurācijas."
    SUMMARY_LINES+=("🤖 Hermes: izlaists")
elif [[ ! -x "$HERMES_BIN" ]]; then
    HERMES_STATUS=1
    log "KĻŪDA: Hermes binārais fails nav izpildāms: $HERMES_BIN"
    SUMMARY_LINES+=("🤖 Hermes: nav atrasts ❌")
else
    HERMES_BEFORE="$(hermes_version)"
    hermes_was_active=0
    hermes_dashboard_was_active=0
    systemctl is-active --quiet hermes-gateway.service && hermes_was_active=1 || true
    systemctl is-active --quiet hermes-dashboard.service && hermes_dashboard_was_active=1 || true

    if [[ "$MODE" == "check" ]]; then
        hermes_check_output="${TMP_DIR}/hermes-check-output.log"
        set +e
        run_timed_as_update_user \
            "$HERMES_TIMEOUT" \
            60s \
            "$HERMES_BIN" update --check \
            2>&1 | tee "$hermes_check_output"
        hermes_check_rc=${PIPESTATUS[0]}
        set -e

        hermes_check_text="$(cat "$hermes_check_output")"
        if rpi5_classify_hermes_update_check "$hermes_check_rc" "$hermes_check_text"; then
            case "$HERMES_CHECK_STATE" in
                current)
                    log "Hermes checkout ir current."
                    ;;
                available)
                    if [[ -n "$HERMES_CHECK_BEHIND" ]]; then
                        WARNINGS+=("Hermes update pieejams: ${HERMES_CHECK_BEHIND} commit(s) behind origin/main.")
                    else
                        WARNINGS+=("Hermes update pieejams pēc hermes update --check.")
                    fi
                    ;;
            esac
        else
            HERMES_STATUS=1
            log "KĻŪDA: hermes update --check neizdevās (rc=${hermes_check_rc})."
        fi
    else
        hermes_update_args=(update --yes)
        [[ "$HERMES_BACKUP" == "yes" ]] && hermes_update_args+=(--backup)
        hermes_update_output="$TMP_DIR/hermes-update-output.log"

        # Stop the system dashboard as root before invoking the user-scoped
        # Hermes updater. This prevents Hermes from opening a non-interactive
        # polkit password prompt while it replaces the frontend assets.
        if [[ "$hermes_dashboard_was_active" -eq 1 ]]; then
            log "Aptur hermes-dashboard.service pirms Hermes update..."
            if ! systemctl stop hermes-dashboard.service; then
                HERMES_STATUS=1
                log "KĻŪDA: hermes-dashboard.service neizdevās apturēt."
            fi
        fi

        if [[ "$HERMES_STATUS" -eq 0 ]]; then
            set +e
            run_timed_as_update_user \
                "$HERMES_TIMEOUT" \
                60s \
                "$HERMES_BIN" "${hermes_update_args[@]}" \
                2>&1 | tee "$hermes_update_output"
            hermes_update_rc=${PIPESTATUS[0]}
            set -e

            if [[ "$hermes_update_rc" -ne 0 ]]; then
                HERMES_STATUS=1
                log "KĻŪDA: hermes update atgrieza kodu ${hermes_update_rc}."
            fi

            if grep -Eiq \
                'Update partially complete|npm install failed|Web UI npm install failed|stale Node deps|EBADENGINE|Unsupported engine|npm error' \
                "$hermes_update_output"; then
                HERMES_STATUS=1
                log "KĻŪDA: Hermes update pabeidzās tikai daļēji."
                WARNINGS+=("Hermes update bija daļējs; pārbaudi npm/Node atkarības.")
            fi
        fi

        if [[ "$HERMES_STATUS" -eq 0 ]]; then
            if ! run_timed_as_update_user \
                10m \
                30s \
                "$HERMES_BIN" doctor; then
                HERMES_STATUS=1
                log "KĻŪDA: Hermes doctor ziņoja par problēmu."
            fi

            run_timed_as_update_user \
                2m \
                15s \
                "$HERMES_BIN" gateway status || true

            if [[ "$hermes_was_active" -eq 1 ]] &&
               ! systemctl is-active --quiet hermes-gateway.service; then
                HERMES_STATUS=1
                log "KĻŪDA: hermes-gateway.service pēc update nav active."
            fi
        fi

        # Restore the dashboard even when Hermes update itself failed, so a
        # failed update does not leave the administration UI offline.
        if [[ "$hermes_dashboard_was_active" -eq 1 ]]; then
            log "Restartē hermes-dashboard.service..."
            if systemctl restart hermes-dashboard.service; then
                log "Gaida dashboard readiness uz 192.168.0.180:9119/api/status..."
                dashboard_ready=0
                for ((attempt = 1; attempt <= 15; attempt++)); do
                    code="$(curl -sS -o /dev/null -w '%{http_code}' \
                        --connect-timeout 3 --max-time 5 \
                        http://192.168.0.180:9119/api/status 2>/dev/null || true)"
                    if [[ "$code" == "200" ]]; then
                        dashboard_ready=1
                        log "Hermes dashboard gatavs (mēģinājums ${attempt})"
                        break
                    fi
                    if (( attempt < 15 )); then
                        sleep 3
                    fi
                done
                if [[ "$dashboard_ready" -eq 0 ]]; then
                    HERMES_STATUS=1
                    log "KĻŪDA: Hermes dashboard nav sasniedzams pēc restart."
                fi
            else
                HERMES_STATUS=1
                log "KĻŪDA: hermes-dashboard.service restart neizdevās."
            fi
        fi
    fi

    HERMES_AFTER="$(hermes_version)"
    if [[ "$MODE" == "check" ]]; then
        case "${HERMES_CHECK_STATE:-error}" in
            current)
                SUMMARY_LINES+=("🤖 Hermes: ${HERMES_AFTER:-?} (Git current) ✅")
                ;;
            available)
                if [[ -n "${HERMES_CHECK_BEHIND:-}" ]]; then
                    SUMMARY_LINES+=("🤖 Hermes: ${HERMES_AFTER:-?} (update pieejams: ${HERMES_CHECK_BEHIND} commits) ⚠️")
                else
                    SUMMARY_LINES+=("🤖 Hermes: ${HERMES_AFTER:-?} (update pieejams) ⚠️")
                fi
                ;;
            *)
                SUMMARY_LINES+=("🤖 Hermes: ${HERMES_AFTER:-?} (check kļūda) ❌")
                ;;
        esac
    else
        SUMMARY_LINES+=("🤖 Hermes: ${HERMES_BEFORE:-?} → ${HERMES_AFTER:-?} $(status_icon "$HERMES_STATUS")")
    fi
fi

# ============================================================
# DOCKER COMPOSE
# ============================================================
snapshot_images() {
    local project_dir="$1"
    local output_file="$2"
    local image_ref image_id version

    (
        cd "$project_dir"

        while IFS= read -r image_ref; do
            [[ -n "$image_ref" ]] || continue

            image_id="$(
                docker image inspect --format '{{.Id}}' "$image_ref" 2>/dev/null ||
                    true
            )"

            version="$(
                docker image inspect \
                    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
                    "$image_ref" 2>/dev/null || true
            )"

            [[ "$version" == "<no value>" ]] && version=""

            printf '%s\t%s\t%s\n' \
                "$image_ref" \
                "${image_id:-MISSING}" \
                "${version:-}"
        done < <(docker compose config --images | sort -u)
    ) >"$output_file"
}

restore_image_tags() {
    local snapshot_file="$1"
    local image_ref image_id version

    while IFS=$'\t' read -r image_ref image_id version; do
        [[ -n "$image_ref" ]] || continue
        [[ "$image_id" != "MISSING" && -n "$image_id" ]] || continue

        if [[ "$image_ref" == *@sha256:* ]]; then
            log "Rollback tag nav vajadzīgs digest-pinned image: ${image_ref}"
            continue
        fi

        log "Rollback image tag: ${image_ref} -> ${image_id:0:19}"
        docker image tag "$image_id" "$image_ref"
    done <"$snapshot_file"
}

collect_image_changes() {
    local project_name="$1"
    local before_file="$2"
    local after_file="$3"
    local image_ref old_id old_version new_line new_id new_version
    local old_label new_label _

    while IFS=$'\t' read -r image_ref old_id old_version; do
        [[ -n "$image_ref" ]] || continue

        new_line="$(
            awk -F '\t' -v ref="$image_ref" '$1 == ref {print; exit}' "$after_file"
        )"

        [[ -n "$new_line" ]] || continue
        IFS=$'\t' read -r _ new_id new_version <<<"$new_line"

        if [[ "$old_id" != "$new_id" ]]; then
            old_label="${old_version:-${old_id:7:12}}"
            new_label="${new_version:-${new_id:7:12}}"
            UPDATED_IMAGES+=("${project_name}: ${image_ref} ${old_label} → ${new_label}")
        fi
    done <"$before_file"
}

update_compose_project() {
    local project_name="$1"
    local project_dir="$2"
    local before_file="${TMP_DIR}/${project_name}-before.tsv"
    local pulled_file="${TMP_DIR}/${project_name}-pulled.tsv"
    local rollback_ok=0

    log "----- Docker Compose: ${project_name} -----"
    validate_compose_project "$project_name" "$project_dir" || return 2
    snapshot_images "$project_dir" "$before_file" || return 2

    if [[ "$MODE" == "check" ]]; then
        log "${project_name}: --check režīmā image netiek vilkti un konteineri netiek recreatēti."
        return 0
    fi

    (
        cd "$project_dir"
        timeout \
            --foreground \
            --kill-after=60s \
            "$DOCKER_PULL_TIMEOUT" \
            docker compose pull --ignore-buildable
    ) || {
        log "KĻŪDA: ${project_name} docker compose pull neizdevās."
        restore_image_tags "$before_file" || true
        return 1
    }

    snapshot_images "$project_dir" "$pulled_file" || {
        log "KĻŪDA: ${project_name} image snapshot pēc pull neizdevās."
        restore_image_tags "$before_file" || true
        return 2
    }

    rpi5_build_compose_up_args "$COMPOSE_WAIT_TIMEOUT" false || return 2
    # Reviewed unattended policy includes --pull never --no-build --wait.
    if (
        cd "$project_dir"
        docker compose up "${RPI5_COMPOSE_UP_ARGS[@]}"
    ); then
        if check_project_runtime "$project_name" "$project_dir"; then
            collect_image_changes "$project_name" "$before_file" "$pulled_file"
            return 0
        fi

        log "KĻŪDA: ${project_name} runtime pārbaude pēc compose up neizdevās."
    fi

    log "KĻŪDA: ${project_name} jaunais stack nekļuva running/healthy."
    log "Mēģina automātisku image rollback."

    restore_image_tags "$before_file"

    rpi5_build_compose_up_args "$COMPOSE_WAIT_TIMEOUT" true || return 2
    if (
        cd "$project_dir"
        docker compose up "${RPI5_COMPOSE_UP_ARGS[@]}"
    ); then
        if check_project_runtime "$project_name" "$project_dir"; then
            rollback_ok=1
            log "${project_name}: rollback izdevās; iepriekšējie image atjaunoti."
        else
            log "KRITISKI: ${project_name} rollback runtime pārbaude neizdevās."
        fi
    else
        log "KRITISKI: ${project_name} rollback neizdevās."
    fi

    [[ "$rollback_ok" -eq 1 ]] || return 2
    return 1
}

CURRENT_PHASE="Docker main"
if update_compose_project "main" "$MAIN_COMPOSE_DIR"; then
    MAIN_DOCKER_STATUS=0
else
    MAIN_DOCKER_STATUS=$?
fi
SUMMARY_LINES+=("🐳 Docker main: $(status_icon "$MAIN_DOCKER_STATUS")")

CURRENT_PHASE="Docker CV"
if [[ "$MAIN_DOCKER_STATUS" -eq 0 ]]; then
    if update_compose_project "cv" "$CV_COMPOSE_DIR"; then
        CV_DOCKER_STATUS=0
    else
        CV_DOCKER_STATUS=$?
    fi
else
    CV_DOCKER_STATUS=1
    log "CV stack update izlaists, jo main stack update neizdevās."
fi
SUMMARY_LINES+=("🐳 Docker CV: $(status_icon "$CV_DOCKER_STATUS")")

# ============================================================
# VESELĪBAS PĀRBAUDES
# ============================================================
CURRENT_PHASE="veselības pārbaudes"
log "----- Veselības pārbaudes -----"

# HTTP retry/reachability behavior is provided by the reviewed
# rpi5-update-http-health.sh helper loaded from the root-controlled libexec path.


LOCAL_URLS=(
    "Home Assistant|http://${HOST_IPV4}:8123/"
    "Uptime Kuma|http://${HOST_IPV4}:3001/"
    "AdGuard|http://${HOST_IPV4}:3080/"
    "Grafana|http://${HOST_IPV4}:3030/"
    "Prometheus|http://${HOST_IPV4}:9090/-/healthy"
    "Portainer|http://${HOST_IPV4}:9000/"
    "Node Exporter|http://${HOST_IPV4}:9100/metrics"
)
while IFS=$'\t' read -r app_name app_url; do
    LOCAL_URLS+=("${app_name}|${app_url}")
done < <(rpi5_application_local_health_targets)

PUBLIC_URLS=(
    "CV|https://rozkalns.net/"
    "Hermes Tech|https://tech.rozkalns.net/"
    "Portainer|https://portainer.rozkalns.net/"
    "Grafana|https://grafana.rozkalns.net/"
    "Home Assistant|https://ha.rozkalns.net/"
    "AdGuard|https://adguard.rozkalns.net/"
    "Uptime Kuma|https://kuma.rozkalns.net/"
    "Prometheus|https://prometheus.rozkalns.net/"
)

for entry in "${LOCAL_URLS[@]}"; do
    name="${entry%%|*}"
    url="${entry#*|}"
    if code="$(rpi5_request_code_with_retry "$url" 3 5)"; then
        :
    else
        LOCAL_HEALTH_STATUS=1
    fi

    printf '%-20s %-48s HTTP %s\n' "$name" "$url" "$code"
done

for entry in "${PUBLIC_URLS[@]}"; do
    name="${entry%%|*}"
    url="${entry#*|}"

    if code="$(rpi5_request_code_with_retry "$url" 8 10)"; then
        :
    else
        PUBLIC_HEALTH_STATUS=1
    fi

    printf '%-20s %-48s HTTP %s\n' "$name" "$url" "$code"
done

# ----- Hermes specifiska veselības pārbaude (ārpus masīviem) -----
# Lokālā: dashboard uz localhost:9119/api/status
HERMES_LOCAL_OK=0
if hermes_local_code="$(rpi5_request_code_with_retry "http://192.168.0.180:9119/api/status" 3 3)"; then
    HERMES_LOCAL_OK=1
else
    LOCAL_HEALTH_STATUS=1
fi
printf '%-20s %-48s HTTP %s\n' "Hermes (local)" "http://192.168.0.180:9119/api/status" "$hermes_local_code"

# Publiskā: tikai ja lokālais ir OK (dependency)
if [[ "$HERMES_LOCAL_OK" -eq 1 ]]; then
    if hermes_public_code="$(rpi5_request_code_with_retry "https://hermes.rozkalns.net/" 8 10)"; then
        :
    else
        PUBLIC_HEALTH_STATUS=1
    fi
    printf '%-20s %-48s HTTP %s\n' "Hermes (public)" "https://hermes.rozkalns.net/" "$hermes_public_code"
else
    PUBLIC_HEALTH_STATUS=1
    printf '%-20s %-48s %s\n' "Hermes (public)" "https://hermes.rozkalns.net/" "SKIPPED (dependency: local Hermes failed)"
fi

SUMMARY_LINES+=("🩺 Lokālie servisi: $(status_icon "$LOCAL_HEALTH_STATUS")")
SUMMARY_LINES+=("🌐 Publiskie servisi: $(status_icon "$PUBLIC_HEALTH_STATUS")")
SUMMARY_LINES+=("📊 Hermes dashboard: $(status_icon "$(( ! HERMES_LOCAL_OK ))")")

# ============================================================
# REBOOT NOTEIKŠANA UN GALA ATSKAITE
# ============================================================
CURRENT_PHASE="gala atskaite"

OVERALL_STATUS=0
for status in \
    "$APT_STATUS" \
    "$RCLONE_STATUS" \
    "$HERMES_STATUS" \
    "$MAIN_DOCKER_STATUS" \
    "$CV_DOCKER_STATUS" \
    "$LOCAL_HEALTH_STATUS" \
    "$PUBLIC_HEALTH_STATUS" \
    "$CLEANUP_STATUS"; do
    if [[ "$status" -ne 0 ]]; then
        OVERALL_STATUS=1
    fi
done

REBOOT_REQUIRED=0
REBOOT_REASON="nav nepieciešams"

if [[ -f /var/run/reboot-required ]]; then
    REBOOT_REQUIRED=1
    REBOOT_REASON="/var/run/reboot-required"
fi

if rpi5_applied_packages_require_reboot "$MODE" "$APT_PACKAGE_LIST"; then
    REBOOT_REQUIRED=1
    REBOOT_REASON="kernel/firmware pakotne atjaunināta"
fi

case "$REBOOT_POLICY" in
    always)
        REBOOT_REQUIRED=1
        REBOOT_REASON="REBOOT_POLICY=always"
        ;;
    never)
        REBOOT_REQUIRED=0
        REBOOT_REASON="REBOOT_POLICY=never"
        ;;
esac

if [[ "$NO_REBOOT" -eq 1 ]]; then
    REBOOT_REQUIRED=0
    REBOOT_REASON="--no-reboot"
fi

if [[ "$OVERALL_STATUS" -ne 0 ]]; then
    REBOOT_REQUIRED=0
    REBOOT_REASON="kļūdas dēļ reboot bloķēts"
fi

END_EPOCH="$(date +%s)"
DURATION="$(elapsed_human $((END_EPOCH - START_EPOCH)))"

if [[ "$MODE" == "check" ]]; then
    HEADER="🔎 RPi5 UPDATE PĀRBAUDE PABEIGTA"
elif [[ "$OVERALL_STATUS" -eq 0 ]]; then
    HEADER="✅ RPi5 SVĒTDIENAS UPDATE VEIKSMĪGS"
else
    HEADER="⚠️ RPi5 UPDATE PABEIGTS AR KĻŪDĀM"
fi

REPORT="${HEADER}

$(printf '%s\n' "${SUMMARY_LINES[@]}")

⏱ Ilgums: ${DURATION}
🔁 Reboot: $([[ "$REBOOT_REQUIRED" -eq 1 ]] && echo "JĀ" || echo "NĒ") (${REBOOT_REASON})"

if (( ${#UPDATED_IMAGES[@]} > 0 )); then
    REPORT+="

Atjauninātie Docker image:
$(printf '• %s\n' "${UPDATED_IMAGES[@]}")"
else
    REPORT+="

Docker image izmaiņas: nav"
fi

if (( ${#WARNINGS[@]} > 0 )); then
    REPORT+="

Brīdinājumi:
$(printf '• %s\n' "${WARNINGS[@]}")"
fi

REPORT+="

Logs: ${LOG}"

printf '\n%s\n' "$REPORT"

if [[ "$MODE" == "run" ]]; then
    send_msg "$REPORT" || true
fi
FINAL_SENT=1

log "===== RPi5 UPDATE v21 PABEIGTS: status=${OVERALL_STATUS}, ilgums=${DURATION} ====="

if [[ "$REBOOT_REQUIRED" -eq 1 && "$MODE" == "run" ]]; then
    log "Drošs reboot ieplānots pēc 1 minūtes: ${REBOOT_REASON}"
    sync
    shutdown -r +1 "RPi5 update pabeigts; ${REBOOT_REASON}"
fi

exit "$OVERALL_STATUS"
