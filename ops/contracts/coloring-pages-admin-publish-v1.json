      "category",
      "categories",
      "topics",
      "age",
      "difficulty"
    ],
    "shared_lock": "/srv/coloring-pages-content/state/drive-ingest/.lock",
    "atomic_write": "same-directory-temp-fsync-os.replace-post-hash-verify",
    "stale_precondition": "412-no-mutation",
    "server_side_validation": true,
    "bulk_destructive_operations": false,
    "physical_delete": true,
    "lifecycle_issue": 1174,
    "archive": {
