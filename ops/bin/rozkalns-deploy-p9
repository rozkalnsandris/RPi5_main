#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys

LIB = Path("/usr/local/lib/rozkalns-deploy-executor")
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from deploy_executor.p9_host_runtime import P9HostRuntimeError, public_result, run_p9_host_one_shot


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run exactly one owner-authorized P9 dry-run canary")
    parser.add_argument("--issue-number", type=int, required=True)
    return parser.parse_args()


def main() -> int:
    if os.geteuid() != 0:
        raise P9HostRuntimeError("P9 one-shot must run as root")
    args = parse_args()
    preflight, result = run_p9_host_one_shot(issue_number=args.issue_number)
    print(json.dumps(public_result(preflight, result), sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"P9_DRY_RUN=STOP reason={type(exc).__name__}:{exc}", file=sys.stderr)
        raise SystemExit(1)
