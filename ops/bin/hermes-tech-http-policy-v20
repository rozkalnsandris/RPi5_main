#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

MODE="${1:-check}"
shift || true

EXPECTED_SHA=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --expected-sha)
      [[ $# -ge 2 ]] || { echo "missing value for --expected-sha" >&2; exit 64; }
      EXPECTED_SHA="$2"
      shift 2
      ;;
    *)
      echo "usage: $0 [check|install|canary|verify|rollback] --expected-sha <40-hex-sha>" >&2
      exit 64
      ;;
  esac
done

case "$MODE" in
  check|install|canary|verify|rollback) ;;
  *)
    echo "usage: $0 [check|install|canary|verify|rollback] --expected-sha <40-hex-sha>" >&2
    exit 64
    ;;
esac

[[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]] || {
  echo "Hermes Tech V20 activation: FAIL: exact --expected-sha is required" >&2
  exit 64
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd -P)"
SRC_CONFIG="$REPO/ops/nginx/hermes-tech.conf"
SRC_UNIT="$REPO/ops/systemd/hermes-tech-web.service"
INSTALLED_CONFIG="/etc/rpi5-hermes-tech-nginx.conf"
INSTALLED_UNIT="/etc/systemd/system/hermes-tech-web.service"
STATE_DIR="/var/lib/rpi5-main/hermes-tech-http-policy-v20"
STATE_FILE="$STATE_DIR/state.env"
BACKUP_UNIT="$STATE_DIR/hermes-tech-web.service.pre-v20"
EVIDENCE_FILE="$STATE_DIR/evidence.log"

SERVICE="hermes-tech-web.service"
CONTAINER="hermes-blog"
EXPECTED_IMAGE="sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa"
EXPECTED_V14_UNIT_SHA="a3cda6ca497de0b4594a974114ca99109946ff1097341d3c1606f800cb3c85c6"
EXPECTED_PORT="127.0.0.1:8089"
EXPECTED_PUBLIC_MOUNT="/home/andris/hermes-tech/site/public|/usr/share/nginx/html|false"
EXPECTED_CONFIG_MOUNT="/etc/rpi5-hermes-tech-nginx.conf|/etc/nginx/conf.d/default.conf|false"
PUBLIC_ORIGIN="https://tech.rozkalns.net"
LOOPBACK_ORIGIN="http://127.0.0.1:8089"
REPRESENTATIVE_PATH="/digest/2026-08-08/"
RSS_PATH="/index.xml"
LAN_ORIGIN="http://192.168.0.180:8089"
EXPECTED_CSP="default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'self'; script-src 'none'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; manifest-src 'self'"
EXPECTED_PERMISSIONS="camera=(), microphone=(), geolocation=(), payment=(), usb=()"

CANARY_ACTIVE=0
ROLLBACK_RUNNING=0

say() { printf '%s\n' "$*"; }
fail_plain() { say "Hermes Tech V20 activation: FAIL: $*" >&2; exit 1; }

sha_of() { sha256sum "$1" | awk '{print $1}'; }

git_cmd() {
  git -c "safe.directory=$REPO" -C "$REPO" "$@"
}

ha_value() {
  curl -fsS --max-time 5 http://127.0.0.1:20241/metrics |
    awk '$1 == "cloudflared_tunnel_ha_connections" {t += $2; f=1} END {if (!f) exit 1; printf "%.0f\n", t}'
}

http_code() {
  curl --noproxy '*' -fsS -o /dev/null --max-time 15 -w '%{http_code}' "$1"
}

public_code() {
  curl -fsS -o /dev/null --max-time 20 -w '%{http_code}' "$1"
}

header_values() {
  local headers="$1" name="$2"
  awk -v want="$name" '
    BEGIN { IGNORECASE=1 }
    {
      line=$0
      sub(/\r$/, "", line)
      pos=index(line, ":")
      if (pos == 0) next
      key=substr(line,1,pos-1)
      value=substr(line,pos+1)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (tolower(key) == tolower(want)) print value
    }
  ' "$headers"
}

require_single_header() {
  local headers="$1" name="$2" expected="$3"
  local values count
  values="$(header_values "$headers" "$name")"
  count="$(printf '%s\n' "$values" | awk 'NF{c++} END{print c+0}')"
  [[ "$count" -eq 1 ]] || fail "header $name count=$count for $headers"
  [[ "$values" == "$expected" ]] || fail "header $name mismatch for $headers: $values"
}

require_no_conflicting_header() {
  local headers="$1" name="$2"
  local distinct
  distinct="$(header_values "$headers" "$name" | sort -u | awk 'NF{c++} END{print c+0}')"
  [[ "$distinct" -le 1 ]] || fail "conflicting duplicate $name values in $headers"
}

find_css_path() {
  local html
  html="$(mktemp)"
  curl --noproxy '*' -fsS --max-time 15 "$LOOPBACK_ORIGIN/" -o "$html"
  local css
  css="$(grep -oE 'href="/css/site\.min\.[0-9a-f]+\.css"' "$html" | head -n1 | cut -d'"' -f2 || true)"
  rm -f "$html"
  [[ "$css" =~ ^/css/site\.min\.[0-9a-f]+\.css$ ]] || fail "fingerprinted CSS path not found"
  printf '%s\n' "$css"
}

assert_http_200() {
  local label="$1" url="$2" code
  if [[ "$url" == "$PUBLIC_ORIGIN"* ]]; then
    code="$(public_code "$url")" || fail "$label request failed"
  else
    code="$(http_code "$url")" || fail "$label request failed"
  fi
  say "$label=$code"
  [[ "$code" == "200" ]] || fail "$label returned HTTP $code"
}

assert_lan_blocked() {
  local rc
  if curl --noproxy '*' -fsS -o /dev/null --connect-timeout 2 --max-time 4 "$LAN_ORIGIN/"; then
    fail "direct LAN origin unexpectedly reachable"
  else
    rc=$?
    say "lan_direct_rc=$rc"
  fi
}

assert_cloudflared() {
  [[ "$(systemctl is-active cloudflared.service)" == "active" ]] || fail "cloudflared is not active"
  [[ "$(systemctl is-enabled cloudflared.service)" == "enabled" ]] || fail "cloudflared is not enabled"
  CURRENT_CF_PID="$(systemctl show cloudflared.service -p MainPID --value)"
  [[ -n "$CURRENT_CF_PID" && "$CURRENT_CF_PID" != "0" ]] || fail "cloudflared PID unavailable"
  CURRENT_CF_HA="$(ha_value)" || fail "cloudflared HA metric unavailable"
  [[ "$CURRENT_CF_HA" == "4" ]] || fail "cloudflared HA is not 4"
  say "cloudflared_pid=$CURRENT_CF_PID"
  say "cloudflared_ha=$CURRENT_CF_HA"
}

assert_git_exact() {
  [[ -f "$SRC_CONFIG" && -f "$SRC_UNIT" ]] || fail "reviewed V20 source files missing"
  local head branch remote
  head="$(git_cmd rev-parse HEAD)"
  branch="$(git_cmd branch --show-current)"
  remote="$(git_cmd rev-parse refs/remotes/origin/main 2>/dev/null || true)"
  [[ "$branch" == "main" ]] || fail "RPi5_main checkout is not main"
  [[ "$head" == "$EXPECTED_SHA" ]] || fail "RPi5_main HEAD mismatch: expected=$EXPECTED_SHA actual=$head"
  [[ "$remote" == "$EXPECTED_SHA" ]] || fail "origin/main mismatch: expected=$EXPECTED_SHA actual=$remote"
  [[ -z "$(git_cmd status --porcelain=v1 --untracked-files=all)" ]] || fail "RPi5_main checkout is not clean"
  git_cmd merge-base --is-ancestor f873a9dff27a6954f02739a55aa7031a26d56267 "$EXPECTED_SHA" ||
    fail "merged V20 source is not an ancestor of expected SHA"
  say "rpi5_main_sha=$head"
}

assert_source_contract() {
  grep -Fq 'map $uri $hermes_cache_control {' "$SRC_CONFIG" || fail "reviewed cache map missing"
  grep -Fq 'default "no-cache";' "$SRC_CONFIG" || fail "reviewed no-cache default missing"
  grep -Fq 'public, max-age=31536000, immutable' "$SRC_CONFIG" || fail "reviewed immutable CSS policy missing"
  grep -Fq "script-src 'none'" "$SRC_CONFIG" || fail "reviewed JS-free CSP missing"
  grep -Fq -- '--pull=never' "$SRC_UNIT" || fail "reviewed unit lost --pull=never"
  grep -Fq -- "$EXPECTED_IMAGE" "$SRC_UNIT" || fail "reviewed unit image drift"
  grep -Fq -- '--publish 127.0.0.1:8089:80' "$SRC_UNIT" || fail "reviewed unit publish drift"
  grep -Fq -- 'src=/etc/rpi5-hermes-tech-nginx.conf,dst=/etc/nginx/conf.d/default.conf,readonly' "$SRC_UNIT" ||
    fail "reviewed config mount missing"
  say "source_config_sha=$(sha_of "$SRC_CONFIG")"
  say "source_unit_sha=$(sha_of "$SRC_UNIT")"
}

assert_image_present() {
  [[ "$(docker image inspect "$EXPECTED_IMAGE" --format '{{.Id}}')" == "$EXPECTED_IMAGE" ]] ||
    fail "retained authoritative Nginx image missing"
}

syntax_test_config() {
  assert_image_present
  docker run --rm --pull=never --network none \
    --mount "type=bind,src=$SRC_CONFIG,dst=/etc/nginx/conf.d/default.conf,readonly" \
    --entrypoint nginx "$EXPECTED_IMAGE" -t >/dev/null
  say "nginx_syntax=PASS"
}

assert_service_basic() {
  [[ "$(systemctl is-active "$SERVICE")" == "active" ]] || fail "$SERVICE not active"
  [[ "$(systemctl is-enabled "$SERVICE")" == "enabled" ]] || fail "$SERVICE not enabled"
  CURRENT_CONTAINER_ID="$(docker inspect "$CONTAINER" --format '{{.Id}}')" || fail "live container missing"
  [[ "$(docker inspect "$CONTAINER" --format '{{.Image}}')" == "$EXPECTED_IMAGE" ]] || fail "live image drift"
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.RestartPolicy.Name}}')" == "no" ]] || fail "Docker restart policy drift"
  [[ "$(docker port "$CONTAINER" 80/tcp)" == "$EXPECTED_PORT" ]] || fail "loopback publish drift"
  local public_mount logging
  public_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/usr/share/nginx/html"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  logging="$(docker inspect "$CONTAINER" --format '{{.HostConfig.LogConfig.Type}}|{{index .HostConfig.LogConfig.Config "max-size"}}|{{index .HostConfig.LogConfig.Config "max-file"}}')"
  [[ "$public_mount" == "$EXPECTED_PUBLIC_MOUNT" ]] || fail "public content mount drift"
  [[ "$logging" == "json-file|10m|3" ]] || fail "logging contract drift"
  say "live_container_id=$CURRENT_CONTAINER_ID"
}

assert_v14_runtime() {
  [[ -f "$INSTALLED_UNIT" ]] || fail "installed Hermes Tech unit missing"
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "installed V14 unit checksum drift"
  [[ ! -e "$INSTALLED_CONFIG" ]] || fail "V20 Nginx config already exists before install"
  assert_service_basic
  local config_mount
  config_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/etc/nginx/conf.d/default.conf"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  [[ -z "$config_mount" ]] || fail "pre-V20 live container unexpectedly has V20 config mount"
}

assert_v20_runtime() {
  [[ -f "$INSTALLED_CONFIG" && -f "$INSTALLED_UNIT" ]] || fail "installed V20 files missing"
  [[ "$(sha_of "$INSTALLED_CONFIG")" == "$(sha_of "$SRC_CONFIG")" ]] || fail "installed V20 config checksum drift"
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$(sha_of "$SRC_UNIT")" ]] || fail "installed V20 unit checksum drift"
  assert_service_basic
  local config_mount
  config_mount="$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/etc/nginx/conf.d/default.conf"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}{{end}}')"
  [[ "$config_mount" == "$EXPECTED_CONFIG_MOUNT" ]] || fail "V20 Nginx config mount drift"
}

assert_base_health() {
  assert_http_200 "loopback_home" "$LOOPBACK_ORIGIN/"
  assert_http_200 "loopback_digest" "$LOOPBACK_ORIGIN$REPRESENTATIVE_PATH"
  assert_http_200 "loopback_rss" "$LOOPBACK_ORIGIN$RSS_PATH"
  assert_http_200 "public_home" "$PUBLIC_ORIGIN/"
  assert_http_200 "public_digest" "$PUBLIC_ORIGIN$REPRESENTATIVE_PATH"
  assert_http_200 "public_rss" "$PUBLIC_ORIGIN$RSS_PATH"
  assert_lan_blocked
}

assert_header_policy_for_origin() {
  local origin="$1" label="$2" css_path="$3"
  local h_home h_rss h_css
  h_home="$(mktemp)"
  h_rss="$(mktemp)"
  h_css="$(mktemp)"
  if [[ "$origin" == "$PUBLIC_ORIGIN" ]]; then
    curl -fsS -o /dev/null --max-time 20 -D "$h_home" "$origin/"
    curl -fsS -o /dev/null --max-time 20 -D "$h_rss" "$origin$RSS_PATH"
    curl -fsS -o /dev/null --max-time 20 -D "$h_css" "$origin$css_path"
  else
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_home" "$origin/"
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_rss" "$origin$RSS_PATH"
    curl --noproxy '*' -fsS -o /dev/null --max-time 15 -D "$h_css" "$origin$css_path"
  fi

  for f in "$h_home" "$h_rss" "$h_css"; do
    require_no_conflicting_header "$f" "Cache-Control"
    require_no_conflicting_header "$f" "Content-Security-Policy"
    require_no_conflicting_header "$f" "X-Content-Type-Options"
    require_no_conflicting_header "$f" "Referrer-Policy"
    require_no_conflicting_header "$f" "Permissions-Policy"
  done

  require_single_header "$h_home" "Cache-Control" "no-cache"
  require_single_header "$h_rss" "Cache-Control" "no-cache"
  require_single_header "$h_css" "Cache-Control" "public, max-age=31536000, immutable"

  for f in "$h_home" "$h_rss" "$h_css"; do
    require_single_header "$f" "X-Content-Type-Options" "nosniff"
    require_single_header "$f" "Referrer-Policy" "strict-origin-when-cross-origin"
    require_single_header "$f" "Permissions-Policy" "$EXPECTED_PERMISSIONS"
    require_single_header "$f" "Content-Security-Policy" "$EXPECTED_CSP"
  done

  rm -f "$h_home" "$h_rss" "$h_css"
  say "${label}_headers=PASS"
}

assert_v20_headers() {
  local css_path
  css_path="$(find_css_path)"
  say "fingerprinted_css=$css_path"
  assert_header_policy_for_origin "$LOOPBACK_ORIGIN" "loopback" "$css_path"
  assert_header_policy_for_origin "$PUBLIC_ORIGIN" "public" "$css_path"
}

load_state() {
  [[ -f "$STATE_FILE" ]] || fail "V20 state file missing"
  # State file contains only operator-created simple key/value records.
  # shellcheck disable=SC1090
  source "$STATE_FILE"
  [[ "${STATE_EXPECTED_SHA:-}" == "$EXPECTED_SHA" ]] || fail "state SHA mismatch"
  [[ "${PRE_UNIT_SHA:-}" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "state pre-V20 unit SHA mismatch"
  [[ -f "$BACKUP_UNIT" ]] || fail "pre-V20 unit backup missing"
  [[ "$(sha_of "$BACKUP_UNIT")" == "$PRE_UNIT_SHA" ]] || fail "pre-V20 backup checksum drift"
}

write_state() {
  local phase="$1"
  local source_config_sha source_unit_sha
  source_config_sha="$(sha_of "$SRC_CONFIG")"
  source_unit_sha="$(sha_of "$SRC_UNIT")"
  cat >"$STATE_FILE.tmp" <<EOF
STATE_EXPECTED_SHA=$EXPECTED_SHA
PHASE=$phase
PRE_UNIT_SHA=$EXPECTED_V14_UNIT_SHA
PRE_UNIT_OWNER=$PRE_UNIT_OWNER
PRE_UNIT_GROUP=$PRE_UNIT_GROUP
PRE_UNIT_MODE=$PRE_UNIT_MODE
PRE_CONTAINER_ID=$PRE_CONTAINER_ID
PRE_CF_PID=$PRE_CF_PID
PRE_CF_HA=$PRE_CF_HA
SOURCE_CONFIG_SHA=$source_config_sha
SOURCE_UNIT_SHA=$source_unit_sha
EOF
  chmod 0600 "$STATE_FILE.tmp"
  chown root:root "$STATE_FILE.tmp"
  mv -f "$STATE_FILE.tmp" "$STATE_FILE"
}

append_evidence() {
  local line="$1"
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >>"$EVIDENCE_FILE"
  chmod 0600 "$EVIDENCE_FILE"
  chown root:root "$EVIDENCE_FILE"
}

rollback_best_effort() {
  [[ "$ROLLBACK_RUNNING" -eq 0 ]] || return 1
  ROLLBACK_RUNNING=1
  say "V20 automatic rollback: BEGIN" >&2
  if [[ ! -f "$BACKUP_UNIT" ]]; then
    say "V20 automatic rollback: missing backup unit" >&2
    return 1
  fi
  install -o root -g root -m "${PRE_UNIT_MODE:-644}" "$BACKUP_UNIT" "$INSTALLED_UNIT" || return 1
  systemctl daemon-reload || return 1
  systemctl restart "$SERVICE" || return 1
  sleep 2
  [[ "$(systemctl is-active "$SERVICE")" == "active" ]] || return 1
  [[ "$(sha_of "$INSTALLED_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || return 1
  [[ "$(docker inspect "$CONTAINER" --format '{{.Image}}')" == "$EXPECTED_IMAGE" ]] || return 1
  [[ "$(docker port "$CONTAINER" 80/tcp)" == "$EXPECTED_PORT" ]] || return 1
  curl --noproxy '*' -fsS -o /dev/null --max-time 15 "$LOOPBACK_ORIGIN/" || return 1
  curl -fsS -o /dev/null --max-time 20 "$PUBLIC_ORIGIN/" || return 1
  local cfpid cfha
  cfpid="$(systemctl show cloudflared.service -p MainPID --value)" || return 1
  cfha="$(ha_value)" || return 1
  [[ "$cfpid" == "${PRE_CF_PID:-}" && "$cfha" == "${PRE_CF_HA:-}" ]] || return 1
  PHASE="rolled_back"
  write_state "rolled_back" || return 1
  append_evidence "automatic_rollback=PASS"
  say "V20 automatic rollback: PASS" >&2
  CANARY_ACTIVE=0
  return 0
}

fail() {
  local message="$*"
  say "Hermes Tech V20 activation: FAIL: $message" >&2
  if [[ "$CANARY_ACTIVE" -eq 1 ]]; then
    if rollback_best_effort; then
      say "HERMES_TECH_V20_AUTOMATIC_ROLLBACK=PASS" >&2
    else
      say "HERMES_TECH_V20_AUTOMATIC_ROLLBACK=FAIL" >&2
    fi
  fi
  exit 1
}

require_root() {
  [[ "$EUID" -eq 0 ]] || fail "run as root"
}

preflight_common() {
  require_root
  assert_git_exact
  assert_source_contract
  assert_image_present
  assert_cloudflared
}

case "$MODE" in
  check)
    say "mode=check"
    preflight_common
    syntax_test_config
    assert_v14_runtime
    assert_base_health
    say "HERMES_TECH_V20_ACTIVATION_CHECK=PASS"
    ;;

  install)
    say "mode=install"
    preflight_common
    syntax_test_config
    assert_v14_runtime
    assert_base_health

    PRE_CONTAINER_ID="$CURRENT_CONTAINER_ID"
    PRE_CF_PID="$CURRENT_CF_PID"
    PRE_CF_HA="$CURRENT_CF_HA"
    PRE_UNIT_OWNER="$(stat -c '%U' "$INSTALLED_UNIT")"
    PRE_UNIT_GROUP="$(stat -c '%G' "$INSTALLED_UNIT")"
    PRE_UNIT_MODE="$(stat -c '%a' "$INSTALLED_UNIT")"
    [[ "$PRE_UNIT_OWNER" == "root" && "$PRE_UNIT_GROUP" == "root" ]] || fail "pre-V20 unit owner drift"

    install -d -o root -g root -m 0700 "$STATE_DIR"
    cp -a "$INSTALLED_UNIT" "$BACKUP_UNIT"
    chown root:root "$BACKUP_UNIT"
    chmod 0600 "$BACKUP_UNIT"
    : >"$EVIDENCE_FILE"
    chmod 0600 "$EVIDENCE_FILE"
    chown root:root "$EVIDENCE_FILE"
    write_state "pre_install_captured"
    append_evidence "pre_install_capture=PASS expected_sha=$EXPECTED_SHA pre_container=$PRE_CONTAINER_ID cf_pid=$PRE_CF_PID cf_ha=$PRE_CF_HA"

    install -o root -g root -m 0644 "$SRC_CONFIG" "$INSTALLED_CONFIG"
    install -o root -g root -m 0644 "$SRC_UNIT" "$INSTALLED_UNIT"
    [[ "$(sha_of "$INSTALLED_CONFIG")" == "$(sha_of "$SRC_CONFIG")" ]] || fail "installed config checksum mismatch"
    [[ "$(sha_of "$INSTALLED_UNIT")" == "$(sha_of "$SRC_UNIT")" ]] || fail "installed unit checksum mismatch"
    systemd-analyze verify "$INSTALLED_UNIT" >/dev/null
    systemctl daemon-reload

    [[ "$(systemctl is-active "$SERVICE")" == "active" ]] || fail "service changed during install-only"
    [[ "$(docker inspect "$CONTAINER" --format '{{.Id}}')" == "$PRE_CONTAINER_ID" ]] || fail "container changed during install-only"
    assert_base_health
    assert_cloudflared
    [[ "$CURRENT_CF_PID" == "$PRE_CF_PID" ]] || fail "cloudflared PID changed during install-only"
    [[ "$CURRENT_CF_HA" == "$PRE_CF_HA" ]] || fail "cloudflared HA changed during install-only"

    write_state "installed"
    append_evidence "install_only=PASS container_unchanged=$PRE_CONTAINER_ID cf_pid=$PRE_CF_PID cf_ha=$PRE_CF_HA"
    say "container_unchanged=PASS"
    say "service_restart=false"
    say "HERMES_TECH_V20_ACTIVATION_INSTALL=PASS"
    ;;

  canary)
    say "mode=canary"
    preflight_common
    load_state
    [[ "${PHASE:-}" == "installed" ]] || fail "canary requires completed install-only phase"
    [[ "$(sha_of "$INSTALLED_CONFIG")" == "${SOURCE_CONFIG_SHA:-}" ]] || fail "installed config drift before canary"
    [[ "$(sha_of "$INSTALLED_UNIT")" == "${SOURCE_UNIT_SHA:-}" ]] || fail "installed unit drift before canary"
    [[ "$(docker inspect "$CONTAINER" --format '{{.Id}}')" == "$PRE_CONTAINER_ID" ]] || fail "live container changed since install-only"
    [[ "$CURRENT_CF_PID" == "$PRE_CF_PID" ]] || fail "cloudflared PID changed before canary"
    [[ "$CURRENT_CF_HA" == "$PRE_CF_HA" ]] || fail "cloudflared HA changed before canary"
    syntax_test_config

    CANARY_ACTIVE=1
    append_evidence "canary_restart=BEGIN pre_container=$PRE_CONTAINER_ID"
    systemctl restart "$SERVICE"
    sleep 2
    assert_v20_runtime
    [[ "$CURRENT_CONTAINER_ID" != "$PRE_CONTAINER_ID" ]] || fail "V20 canary did not recreate web container"
    assert_base_health
    assert_v20_headers
    assert_cloudflared
    [[ "$CURRENT_CF_PID" == "$PRE_CF_PID" ]] || fail "cloudflared PID changed during canary"
    [[ "$CURRENT_CF_HA" == "$PRE_CF_HA" ]] || fail "cloudflared HA changed during canary"
    CANARY_ACTIVE=0

    write_state "canary_passed"
    append_evidence "canary=PASS new_container=$CURRENT_CONTAINER_ID cf_pid=$CURRENT_CF_PID cf_ha=$CURRENT_CF_HA"
    say "HERMES_TECH_V20_ACTIVATION_CANARY=PASS"
    ;;

  verify)
    say "mode=verify"
    preflight_common
    load_state
    [[ "${PHASE:-}" == "canary_passed" ]] || fail "verify requires successful canary phase"
    assert_v20_runtime
    assert_base_health
    assert_v20_headers
    assert_cloudflared
    [[ "$CURRENT_CF_PID" == "$PRE_CF_PID" ]] || fail "cloudflared PID changed since pre-V20 capture"
    [[ "$CURRENT_CF_HA" == "$PRE_CF_HA" ]] || fail "cloudflared HA changed since pre-V20 capture"
    append_evidence "verify=PASS container=$CURRENT_CONTAINER_ID cf_pid=$CURRENT_CF_PID cf_ha=$CURRENT_CF_HA"
    say "HERMES_TECH_V20_ACTIVATION_VERIFY=PASS"
    ;;

  rollback)
    say "mode=rollback"
    preflight_common
    load_state
    [[ "${PHASE:-}" == "installed" || "${PHASE:-}" == "canary_passed" || "${PHASE:-}" == "rolled_back" ]] ||
      fail "rollback state is not eligible"
    if [[ "${PHASE:-}" == "rolled_back" ]]; then
      [[ "$(sha_of "$INSTALLED_UNIT")" == "$EXPECTED_V14_UNIT_SHA" ]] || fail "rolled-back unit checksum drift"
      assert_service_basic
      assert_base_health
      say "HERMES_TECH_V20_ACTIVATION_ROLLBACK=PASS"
      exit 0
    fi
    if rollback_best_effort; then
      say "HERMES_TECH_V20_ACTIVATION_ROLLBACK=PASS"
    else
      fail_plain "explicit rollback failed; preserve $STATE_DIR and inspect manually"
    fi
    ;;
esac
